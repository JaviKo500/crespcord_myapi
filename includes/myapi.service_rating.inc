<?php

/**
 * @file
 * Ratings of a provider and the two reputation counters (SPEC 108).
 *
 * One writer, one title generator and the aggregate query that keeps
 * field_rating_avg / field_rating_count on the 'provider' node in step with the
 * 'service_rating' nodes that exist. Between them they close a hole open since
 * SPEC 83: resources/provider.resource.inc reads both counters in the listing
 * and in the detail, and until this file nobody had ever written them, so every
 * provider of the marketplace answered `rating_avg: null` and `rating_count: 0`.
 *
 * The bundle and its five instances (field_rating_provider, field_rating_offer,
 * field_stars, field_rating_comment, field_unit) exist untouched since SPEC 77,
 * as do the two counters on 'provider'; this file is the first thing that ever
 * writes into any of them. It creates no field, no instance, no bundle and no
 * table.
 *
 * The split of this file is the same one includes/myapi.service_transaction.inc
 * carries, and for the same reason: the pure functions — the title text and the
 * rounding rule — go whole into tests/unit, and the Field API and db_select()
 * halves stay out of them.
 *
 * WHO CALLS WHAT:
 *   - myapi_service_rating_record() is called by the close endpoint
 *     (resources/service_request.resource.inc), and by nothing else;
 *   - myapi_service_rating_set_title() is the delegate of myapi_node_presave()'s
 *     'service_rating' branch;
 *   - myapi_service_rating_sync_provider() is the delegate of the same bundle's
 *     branch in myapi_node_insert(), myapi_node_update() AND myapi_node_delete().
 *
 * The counters hang off the node hooks and NOT off the endpoint, which is the
 * decision SPEC 92 and SPEC 94 already took for the timeline: one implementation
 * covers the app and node/add/service_rating at once. Hanging them off the
 * endpoint would leave every rating an operator writes by hand uncounted, which
 * is the very hole this file exists to close.
 *
 * NO RECURSION IS POSSIBLE. What the sync saves is a 'provider' node, and none
 * of the three branches reacts to that bundle. Whoever adds a 'provider' branch
 * to any node hook has to keep that property.
 */

module_load_include('inc', 'myapi', 'includes/myapi.services_common');

// Hard ceiling of node.title / node_revision.title, both varchar(255). Without
// this cap MySQL would cut the value itself, mid-character on a UTF-8 string.
//
// Own constant, NOT MYAPI_SERVICE_TRANSACTION_TITLE_MAX_LENGTH: reusing that one
// would force this file to load the transactions include to read one number,
// and would tie together the titles of two bundles that can diverge. Same
// criterion that include records for not reusing the claims' constants.
//
// Guarded like every define() in the module, so a PHPUnit require_once of this
// file next to another that already loaded it does not emit a redefinition
// notice.
if (!defined('MYAPI_SERVICE_RATING_TITLE_MAX_LENGTH')) {
  define('MYAPI_SERVICE_RATING_TITLE_MAX_LENGTH', 255);
}

/**
 * The autogenerated title of a rating.
 *
 * 'service_rating' was the only bundle of this series with no title generator,
 * and a node with no title is an unreadable back office. Format, with the empty
 * parts simply absent, exactly like myapi_service_transaction_title():
 *
 *   Calificación · Fontanería Pérez · 5★ · 28/08/2026
 *
 * The leading label is unconditional, which is what guarantees a non-empty
 * return with no fallback branch: a rating with no provider, no stars and no
 * date still reads as "Calificación" and not as an empty string.
 *
 * The three values arrive already resolved rather than the node itself, so this
 * function is free of Drupal except t(), format_date() and truncate_utf8() —
 * which is what puts it, whole, inside tests/unit. The Field API half is
 * set_title() below.
 *
 * Nothing here escapes anything: node.title is stored raw and escaped by Drupal
 * at render time. The star count is concatenated and not passed as a t()
 * placeholder for that same reason — Drupal runs check_plain() over '@' style
 * replacements, and this string is going into a raw column.
 *
 * @param string|null $provider_name
 *   node.title of the rated provider. Empty, NULL, or a provider that can no
 *   longer be loaded simply drops the segment.
 * @param mixed $stars
 *   field_stars as stored. A non-numeric value drops the segment rather than
 *   printing '0★' for a rating whose star row is broken.
 * @param mixed $created
 *   node.created as stored — a Unix timestamp. A 'Y-m-d H:i:s' string is
 *   accepted too, and anything unparseable drops the segment instead of
 *   printing 01/01/1970 as if it were a real date.
 *
 * @return string
 *   Never empty, never longer than node.title's 255 characters.
 */
function myapi_service_rating_title($provider_name, $stars, $created) {
  $parts = array(t('Calificación'));

  $provider_name = ($provider_name === NULL) ? '' : trim((string) $provider_name);
  if ($provider_name !== '') {
    $parts[] = $provider_name;
  }

  if ($stars !== NULL && $stars !== '' && is_numeric($stars)) {
    $parts[] = (int) $stars . '★';
  }

  $timestamp = myapi_service_rating_title_timestamp($created);
  if ($timestamp !== NULL) {
    $parts[] = format_date($timestamp, 'custom', 'd/m/Y');
  }

  return truncate_utf8(implode(' · ', $parts), MYAPI_SERVICE_RATING_TITLE_MAX_LENGTH, TRUE, TRUE);
}

/**
 * Resolves the date segment of the title to a timestamp, or to nothing.
 *
 * node.created is an integer, but this file also has to survive a rating whose
 * created column was handed over as a date string by a migration or a test, so
 * both shapes are accepted and everything else drops the segment. Extracted
 * from the title builder above so that "which values are a date" is one
 * decision in one place, and so the title function reads as the list of its
 * four segments.
 *
 * A timestamp of 0 is treated as no date: it is what an unset integer column
 * looks like, and printing 01/01/1970 is the one outcome this guard exists to
 * avoid.
 *
 * @param mixed $created
 *   A Unix timestamp, a date string, or anything at all.
 *
 * @return int|null
 *   The timestamp, or NULL when there is no date to print.
 */
function myapi_service_rating_title_timestamp($created) {
  if ($created === NULL || $created === '') {
    return NULL;
  }

  if (is_numeric($created)) {
    $timestamp = (int) $created;

    return $timestamp > 0 ? $timestamp : NULL;
  }

  if (!is_string($created)) {
    return NULL;
  }

  $timestamp = strtotime($created);

  return ($timestamp === FALSE || $timestamp <= 0) ? NULL : $timestamp;
}

/**
 * Writes the autogenerated title onto a 'service_rating' node.
 *
 * Delegate of myapi_node_presave()'s 'service_rating' branch (myapi.module).
 * hook_node_presave() and not myapi_service_rating_record() below, for the two
 * reasons SPEC 60 and SPEC 92 already recorded for the two transaction bundles:
 * field_attach_presave() has already normalised the field values by the time
 * this runs, and the node row is not written yet, so no second node_save() is
 * needed.
 *
 * It also covers every creation and edition path with one implementation — the
 * close endpoint, node/add/service_rating and node/%nid/edit — which is why no
 * rating can be born titleless, and why the title is regenerated on every
 * edition and can never describe a rating that changed underneath it. The
 * stable identifier is the nid, not the title.
 *
 * THE PROVIDER IS LOADED HERE AND NOT IN THE PURE HALF. Its name is the one
 * segment that is not on the rating itself, and resolving it needs a node_load()
 * that would drag the whole Field API into tests/unit. A provider that cannot be
 * loaded — deleted, or a broken reference — drops the segment and the title
 * still reads.
 *
 * myapi_building_admin_field_value() / myapi_building_admin_field_target_id()
 * (includes/myapi.building_admin.inc, SPEC 49) are reused as-is rather than
 * re-reading $node->field_x[LANGUAGE_NONE][0]['value'] by hand.
 *
 * @param object $node
 *   The 'service_rating' node about to be saved.
 */
function myapi_service_rating_set_title($node) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $provider_name = NULL;
  $provider_nid = myapi_building_admin_field_target_id($node, 'field_rating_provider');
  if (!empty($provider_nid)) {
    $provider = node_load($provider_nid);
    if ($provider && $provider->type === MYAPI_SERVICES_PROVIDER_TYPE) {
      $provider_name = $provider->title;
    }
  }

  $node->title = myapi_service_rating_title(
    $provider_name,
    myapi_building_admin_field_value($node, 'field_stars'),
    isset($node->created) ? $node->created : REQUEST_TIME
  );
}

/**
 * Creates the rating a resident writes when closing their request.
 *
 * The Field API half of this file, and the FIRST of the three writes of
 * PUT /api/v1/service-requests/{id}/close — see that endpoint for why it goes
 * first and not last: it is the only step of the close that cannot be retried
 * once the request is 'closed', because 'closed' is terminal and the second
 * close answers 409.
 *
 * THE TITLE IS NOT SET HERE, AND THAT IS NOT AN OMISSION.
 * myapi_service_rating_set_title() puts it in from hook_node_presave(), inside
 * the node_save() below, which is the one place that can title a rating whatever
 * created it. Setting it here too would be a second title for the same node, and
 * the hook's would win anyway. Same split as
 * myapi_service_transaction_record().
 *
 * THE COUNTERS ARE NOT WRITTEN HERE EITHER. myapi_service_rating_sync_provider()
 * below runs from hook_node_insert(), fired by the node_save() of this very
 * function — see the file docblock for why that is the hook and not this line.
 *
 * uid and status are set AFTER node_object_prepare() and not before, which is
 * the order myapi_service_request_build_node() uses: prepare overwrites both on
 * a node with no nid, so the values have to land on the far side of it.
 *
 * field_rating_offer and field_unit are written ONLY when there is something to
 * write. The offer is absent by design on a 'direct' request — there was no
 * round, which is exactly why SPEC 87 made that instance optional — and the unit
 * is absent on any request that carries none. Writing an empty item would leave
 * a row with a NULL target_id instead of no row, and SPEC 84's reader tells the
 * two apart.
 *
 * field_rating_comment is written with 'value' only and no 'format', like every
 * other text field this module writes: the column is stored raw and whoever
 * renders it escapes it — myapi_provider_build_rating_item() does exactly that
 * with myapi_text_to_plain().
 *
 * NOT PURE, like myapi_service_transaction_record(): what the unit layer can
 * prove about it is the object handed to node_save(); that the save persists and
 * that the hooks fire stays with tests/integration.
 *
 * @param mixed $provider_nid
 *   field_rating_provider — the provider that did the job. REQUIRED at instance
 *   level: the caller has already refused the close with 409
 *   service_request_provider_missing when the request carries none.
 * @param mixed $offer_nid
 *   field_rating_offer — the awarded offer, or NULL/0 when the request was
 *   'direct' and there was no round.
 * @param mixed $unit_nid
 *   field_unit — the unit of the resident who rated, or NULL/0 when the request
 *   carries none.
 * @param mixed $uid
 *   node.uid of the rating: the resident behind the token. It is also what
 *   SPEC 84 reads to abbreviate `author_name`.
 * @param mixed $stars
 *   field_stars, already validated against myapi_services_star_values().
 * @param string|null $comment
 *   field_rating_comment, already trimmed and length-checked, or NULL when the
 *   resident wrote none.
 *
 * @return object
 *   The saved rating node, carrying the nid node_save() assigned it.
 */
function myapi_service_rating_record($provider_nid, $offer_nid, $unit_nid, $uid, $stars, $comment) {
  $rating = new stdClass();
  $rating->type = MYAPI_SERVICES_RATING_TYPE;
  node_object_prepare($rating);
  $rating->uid = $uid;
  $rating->status = 1;
  $rating->language = LANGUAGE_NONE;

  $rating->field_rating_provider[LANGUAGE_NONE][0]['target_id'] = $provider_nid;
  if (!empty($offer_nid)) {
    $rating->field_rating_offer[LANGUAGE_NONE][0]['target_id'] = $offer_nid;
  }
  if (!empty($unit_nid)) {
    $rating->field_unit[LANGUAGE_NONE][0]['target_id'] = $unit_nid;
  }
  $rating->field_stars[LANGUAGE_NONE][0]['value'] = (int) $stars;
  if ($comment !== NULL && $comment !== '') {
    $rating->field_rating_comment[LANGUAGE_NONE][0]['value'] = $comment;
  }

  node_save($rating);

  return $rating;
}

/**
 * Counts and averages the ratings of one provider.
 *
 * THE ONLY QUERY THIS SPEC ADDS, and it is deliberately
 * myapi_provider_rating_summary() (resources/provider.resource.inc, SPEC 84)
 * WITHOUT THE GROUP BY. That is not a coincidence to be tidied away: it has to
 * count exactly the same rows as that one, or it breaks a promise published in
 * docs/provider-detail.md — "the sum of the five values of rating_summary always
 * equals rating_count". Copying its conditions character for character is what
 * keeps that equality, and it is why the two decisions below are inherited
 * rather than taken here.
 *
 * INNER JOIN with field_stars and not LEFT, same as the summary. field_stars is
 * required at instance level, so a rating with no star row is a broken node and
 * not a zero to drag the average down with.
 * (myapi_provider_ratings_recent() joins it LEFT, because showing a broken row
 * is less bad than counting it.)
 *
 * NO n.status = 1 CONDITION, AND THAT IS DELIBERATE. SPEC 77 decided that
 * moderating a rating means DELETING the node, not unpublishing it, and neither
 * of SPEC 84's two queries carries a status filter for that reason. Adding one
 * here would create a third reader counting different rows from the other two
 * and would break the equality above. It is also what forces this spec to open
 * hook_node_delete(): if moderating is deleting, and deleting does not
 * recalculate, then every act of moderation leaves the reputation wrong.
 *
 * THE AVERAGE IS RECOMPUTED WHOLE, NEVER INCREMENTALLY. avg = (avg × n + stars)
 * / (n + 1) accumulates floating point error, cannot repair an average that is
 * already wrong, and breaks outright if one save is lost. A full recount is an
 * indexed query over a handful of rows per provider and it SELF-HEALS: whatever
 * state the counters were left in, the next rating saved puts both numbers
 * right.
 *
 * @param mixed $provider_nid
 *   The provider nid to aggregate over.
 * @param mixed $exclude_nid
 *   A rating nid to leave out of the count. Exists for hook_node_delete() alone
 *   — see myapi_service_rating_sync_provider() — and is NULL everywhere else.
 *
 * @return array
 *   ['count' => int, 'average' => float|NULL]. `average` is NULL when there is
 *   nothing to average, which is not the same as 0.
 */
function myapi_service_rating_provider_aggregates($provider_nid, $exclude_nid = NULL) {
  $query = db_select('node', 'n');
  $query->condition('n.type', MYAPI_SERVICES_RATING_TYPE);

  $query->innerJoin('field_data_field_rating_provider', 'rp', "rp.entity_id = n.nid AND rp.entity_type = 'node' AND rp.deleted = 0");
  $query->condition('rp.field_rating_provider_target_id', $provider_nid);

  $query->innerJoin('field_data_field_stars', 'st', "st.entity_id = n.nid AND st.entity_type = 'node' AND st.deleted = 0");

  if ($exclude_nid !== NULL) {
    $query->condition('n.nid', (int) $exclude_nid, '<>');
  }

  $query->addExpression('COUNT(*)', 'total');
  $query->addExpression('AVG(st.field_stars_value)', 'average');

  $row = $query->execute()->fetchObject();

  // An aggregate with no GROUP BY always returns one row, but a NULL average on
  // an empty set is the normal answer and has to survive the cast: (float) NULL
  // is 0.0, which is a mark and not an absence.
  $count = ($row && $row->total !== NULL) ? (int) $row->total : 0;
  $average = ($row && $row->average !== NULL) ? (float) $row->average : NULL;

  return array('count' => $count, 'average' => $average);
}

/**
 * Decides what actually goes into the two counter fields.
 *
 * | count | field_rating_count | field_rating_avg |
 * |   0   |         0          | empty (NULL)     |
 * |  >= 1 |      the integer   | round($avg, 2)   |
 *
 * THE ZERO IS WRITTEN EXPLICITLY and not left empty, because
 * resources/provider.resource.inc already turns a NULL count into 0 when it
 * answers: writing the zero makes storage and API say the same thing instead of
 * holding two truths.
 *
 * THE AVERAGE IS LEFT EMPTY WHEN THERE IS NOTHING, and not 0.00. An unrated
 * provider does not have a zero for a mark; `rating_avg: null` is what the app
 * has known how to paint as "sin valoraciones" since SPEC 83, and a 0.00 would
 * lie about a provider nobody has scored.
 *
 * TWO DECIMALS because field_rating_avg is number_decimal with precision 3,
 * scale 2: it holds 0.00 to 9.99, dimensioned exactly for an average of 1 to 5.
 * Storing more decimals would lose them on the write, without a warning.
 *
 * Pure by design, which is what puts it whole inside tests/unit — the same split
 * the query above is on the other side of.
 *
 * @param mixed $count
 *   The row count, as myapi_service_rating_provider_aggregates() returned it.
 * @param mixed $avg
 *   The raw average, or NULL.
 *
 * @return array
 *   ['count' => int, 'average' => float|NULL] ready to be written.
 */
function myapi_service_rating_format_average($count, $avg) {
  $count = (int) $count;

  if ($count < 1) {
    return array('count' => 0, 'average' => NULL);
  }

  if ($avg === NULL || $avg === '' || !is_numeric($avg)) {
    // A count with no average means the aggregate disagreed with itself, which
    // the INNER JOIN makes impossible today. The count is still true, so it is
    // kept, and the mark that cannot be computed is left absent rather than
    // invented as a zero.
    return array('count' => $count, 'average' => NULL);
  }

  return array('count' => $count, 'average' => round((float) $avg, 2));
}

/**
 * Recalculates and writes the two reputation counters of one provider.
 *
 * Delegate of the 'service_rating' branch of myapi_node_insert(),
 * myapi_node_update() AND myapi_node_delete() (myapi.module). One
 * implementation for the three doors, which is what makes a rating created from
 * node/add/service_rating count exactly like one created by the close endpoint,
 * and a rating an operator moderates stop counting the moment it is gone.
 *
 * WHY THE DELETE NEEDS $exclude_nid AND THE OTHER TWO DO NOT. hook_node_delete()
 * runs in Drupal 7 BEFORE field_attach_delete() and before the {node} row goes
 * away: at the instant this code executes, the rating being deleted is STILL in
 * the tables the aggregate query reads, and recalculating there would return the
 * very numbers that stood before the deletion. Drupal 7 has no later hook to
 * lean on. The way out is the one visible here — ask the query to leave that nid
 * out — and it is an optional parameter rather than a second query or a
 * variable_set() carrying state between hooks.
 *
 * A batch deletion (node_delete_multiple() over N ratings of the same provider)
 * fires N recalculations, each excluding only the node that is dying. The
 * intermediate ones are transient and the last one leaves the right number, which
 * is the same price any node-hook synchronisation pays.
 *
 * AN OPERATOR WHO CHANGES field_rating_provider on an existing rating leaves the
 * OLD provider stale. It is a back-office-only case, of a single row, repaired by
 * saving any other rating of the affected provider. Tracking the previous value
 * would need a hook_node_presave() carrying state, for something that almost
 * never happens; it is recorded in SPEC 108's risk table and deliberately left
 * alone.
 *
 * NO RECURSION: what is saved here is a 'provider' node, and none of the three
 * branches this function hangs off reacts to that bundle.
 *
 * @param mixed $provider_nid
 *   The provider to resynchronise. A missing or unloadable one returns without
 *   writing: a rating with a broken reference is a broken rating, not a reason
 *   to fail the save that fired this.
 * @param mixed $exclude_nid
 *   The rating nid to leave out, for hook_node_delete() only. NULL elsewhere.
 */
function myapi_service_rating_sync_provider($provider_nid, $exclude_nid = NULL) {
  if (empty($provider_nid)) {
    return;
  }

  $provider = node_load($provider_nid);
  if (!$provider || $provider->type !== MYAPI_SERVICES_PROVIDER_TYPE) {
    return;
  }

  $aggregates = myapi_service_rating_provider_aggregates($provider_nid, $exclude_nid);
  $values = myapi_service_rating_format_average($aggregates['count'], $aggregates['average']);

  $provider->field_rating_count[LANGUAGE_NONE][0]['value'] = $values['count'];

  if ($values['average'] === NULL) {
    // The whole delta is removed and not set to NULL: an item with a NULL value
    // is a row in the field table, and "no mark" is the absence of the row.
    $provider->field_rating_avg = array();
  }
  else {
    $provider->field_rating_avg[LANGUAGE_NONE][0]['value'] = $values['average'];
  }

  node_save($provider);
}
