<?php

/**
 * @file
 * Automatic initial transaction of a service request (SPEC 92).
 *
 * Two delegates of node hooks and three pure functions, which together make
 * every 'service_request' be born with the first entry of its timeline: one
 * 'service_transaction' copying the status the request was created with,
 * whatever path created it — node/add/service_request, POST
 * /api/v1/service-requests, or any future programmatic one.
 *
 * The bundle and its four fields (field_request, field_request_status,
 * field_status_date, field_comment) exist untouched since SPEC 77; this file
 * is the first thing that ever writes into them. It creates no field, no
 * instance, no bundle and no table.
 *
 * There is NO administration page here — no route, no form, no timeline table
 * — which is why the file carries no '_admin' suffix, unlike its counterpart
 * includes/myapi.claim_transaction_admin.inc. Exposing the timeline, in the
 * back office or in the API, is another spec, exactly as it was for claims.
 *
 * Deliberate divergences from claims, all three recorded in SPEC 92's
 * decision table and none of them cosmetic — which is also why no common
 * abstraction is extracted between the two:
 *   - the status label of the generic text comes from the catalogue
 *     myapi_services_request_statuses() and not from hand-written strings,
 *     because that catalogue lives in code and no administrator can rewrite
 *     it mid-sentence from the UI (claims' allowed_values are editable, hence
 *     the opposite choice there);
 *   - there is NO reverse sync transaction -> request. Saving a transaction
 *     with a different status does not rewrite the request's own, unlike
 *     myapi_claim_transaction_sync_claim_status(): the request status HAS a
 *     transition graph (myapi_services_request_transitions()) and nobody
 *     validates it yet, so the sync would let anyone put a request into an
 *     impossible state from node/add/service_transaction;
 *   - there is NO transient notification flag, because the marketplace has no
 *     notifier to silence.
 *
 * The catalogue is loaded rather than duplicated, per Regla 3 de CLAUDE.md.
 * It is the same source myapi.install reads to build field_request_status'
 * allowed_values, which is what keeps the texts and the field configuration
 * from drifting apart.
 */

module_load_include('inc', 'myapi', 'includes/myapi.services_common');

// How much of the transaction's comment fits in the autogenerated node title.
// Guarded like every define() in the module, so a PHPUnit require_once of this
// file next to another that already loaded it does not emit a redefinition
// notice.
//
// Own constants, NOT MYAPI_CLAIM_TRANSACTION_TITLE_*: reusing those would force
// this file to load the whole claims include to read two numbers, and would tie
// together the title length of two features that can diverge.
if (!defined('MYAPI_SERVICE_TRANSACTION_TITLE_COMMENT_LENGTH')) {
  define('MYAPI_SERVICE_TRANSACTION_TITLE_COMMENT_LENGTH', 60);
}

// Hard ceiling of node.title / node_revision.title, both varchar(255). Without
// this cap MySQL would cut the value itself, mid-character on a UTF-8 string.
if (!defined('MYAPI_SERVICE_TRANSACTION_TITLE_MAX_LENGTH')) {
  define('MYAPI_SERVICE_TRANSACTION_TITLE_MAX_LENGTH', 255);
}

/**
 * The acknowledgement text of a request's initial transaction.
 *
 * Three variants, because the three cases are three different promises and a
 * single text would lie in two of them:
 *   - 'open': the request is out for offers, providers of its category may
 *     answer;
 *   - 'direct': the request already went to one chosen provider;
 *   - anything else ('offered', 'assigned', 'closed', 'cancelled', or a key
 *     that is not in the catalogue at all): a request an operator registered
 *     from the back office in a status that acknowledges nothing, so the text
 *     describes an administrative record instead of talking to the resident.
 *
 * The label of that third text comes from myapi_services_request_statuses()
 * (includes/myapi.services_common.inc, SPEC 77), reused and not transcribed —
 * the opposite of myapi_claim_transaction_initial_comment(), and for a concrete
 * reason: there the labels are field allowed_values an administrator can edit
 * from the browser, here the catalogue is code nobody touches. The underlying
 * rule is the same in both files — the label's source is the one that cannot
 * change under the sentence's feet.
 *
 * A key missing from the catalogue degrades to the raw stored key, which still
 * reads, rather than to an empty comment: a transaction is never born
 * commentless, which is the hole SPEC 61 closed for claims.
 *
 * Pure by design (t() only), which is what puts it whole inside tests/unit —
 * same split as the Field API half, create_initial(), below.
 *
 * @param string|null $status
 *   field_request_status of the request, as stored.
 *
 * @return string
 *   Never empty.
 */
function myapi_service_transaction_initial_comment($status) {
  $status = ($status === NULL) ? '' : trim((string) $status);

  if ($status === '') {
    // No status at all — possible only through a careless programmatic
    // node_save(), since neither the form nor SPEC 90's builder omits it. The
    // transaction records what there was, not what there should have been.
    return t('Solicitud registrada.');
  }

  if ($status === MYAPI_SERVICES_REQUEST_STATUS_OPEN) {
    return t('Hemos recibido su solicitud. Los proveedores de la categoría podrán enviarle ofertas y se le notificará cualquier novedad.');
  }

  if ($status === MYAPI_SERVICES_REQUEST_STATUS_DIRECT) {
    return t('Hemos recibido su solicitud y fue enviada al proveedor seleccionado. Se le notificará cualquier novedad.');
  }

  $statuses = myapi_services_request_statuses();
  $label = isset($statuses[$status]) ? $statuses[$status] : $status;

  return t('Solicitud registrada con estado @estado.', array('@estado' => $label));
}

/**
 * Composes the autogenerated title of a 'service_transaction'.
 *
 * Four segments joined by ' · ':
 *
 *   Solicitud #412 · Abierta · 19/08/2026 14:30 · Hemos recibido su solicit…
 *
 * Each segment is omitted when its value is missing, with no dangling
 * separator, so a transaction with a corrupt field_request or without a
 * comment still gets a title that reads correctly. When nothing at all
 * resolves, the generic fallback keeps the promise that a transaction is never
 * titleless — the same hole SPEC 60 had to close for claims, where node.title
 * being NOT NULL DEFAULT '' meant nobody failed, only /admin/content showed a
 * list of blank links.
 *
 * The four values arrive already resolved, rather than the node itself, so this
 * function is free of Drupal except t(), format_date() and truncate_utf8() —
 * which is what puts it, whole, inside tests/unit. The Field API half is
 * set_title() below.
 *
 * Nothing here escapes anything: node.title is stored raw and escaped by Drupal
 * at render time.
 *
 * @param int|null $request_nid
 *   Target id of field_request.
 * @param string|null $status_label
 *   Human label of field_request_status, already resolved against the
 *   catalogue by the caller.
 * @param string|null $status_date
 *   field_status_date as stored, 'Y-m-d H:i:s'.
 * @param string|null $comment
 *   field_comment as stored, newlines and all.
 *
 * @return string
 *   Never empty, never longer than node.title's 255 characters.
 */
function myapi_service_transaction_title($request_nid, $status_label, $status_date, $comment) {
  $parts = array();

  if (!empty($request_nid)) {
    // Not a t() placeholder: Drupal runs check_plain() over '@nid' style
    // replacements, and this string is going into a raw column.
    $parts[] = t('Solicitud') . ' #' . $request_nid;
  }

  $status_label = trim((string) $status_label);
  if ($status_label !== '') {
    $parts[] = $status_label;
  }

  // strtotime() rather than a format assumption: an unparseable value drops the
  // segment instead of printing 01/01/1970 as if it were a real status date.
  $timestamp = ($status_date === NULL || $status_date === '') ? FALSE : strtotime($status_date);
  if ($timestamp !== FALSE) {
    $parts[] = format_date($timestamp, 'custom', 'd/m/Y H:i');
  }

  $comment = myapi_service_transaction_title_comment($comment);
  if ($comment !== '') {
    $parts[] = $comment;
  }

  if (!$parts) {
    return t('Transacción de solicitud');
  }

  return truncate_utf8(implode(' · ', $parts), MYAPI_SERVICE_TRANSACTION_TITLE_MAX_LENGTH, TRUE, TRUE);
}

/**
 * The comment as it goes into the title: one line, trimmed, truncated.
 *
 * field_comment is a textarea, so its raw value carries newlines and runs of
 * spaces that render broken in a node title — hence the collapse before the
 * cut, not after: truncating first would spend part of the 60-character budget
 * on whitespace.
 *
 * truncate_utf8() is Drupal core's (includes/unicode.inc), with $wordsafe and
 * $add_ellipsis, so the cut lands on a word boundary and ends in '…'. No
 * truncation is written by hand here.
 *
 * preg_replace() returns NULL on invalid UTF-8; the ?: falls back to the
 * original value, so a malformed comment degrades to an untidy title instead of
 * blanking it.
 *
 * @param string|null $comment
 *
 * @return string
 *   '' when the comment is missing or only whitespace.
 */
function myapi_service_transaction_title_comment($comment) {
  $comment = trim((string) $comment);
  if ($comment === '') {
    return '';
  }

  $comment = trim(preg_replace('/\s+/u', ' ', $comment) ?: $comment);

  return truncate_utf8($comment, MYAPI_SERVICE_TRANSACTION_TITLE_COMMENT_LENGTH, TRUE, TRUE);
}

/**
 * Writes the autogenerated title onto a 'service_transaction' node.
 *
 * Delegate of myapi_node_presave()'s 'service_transaction' branch
 * (myapi.module). hook_node_presave() and not the creator below, for the two
 * reasons SPEC 60 already recorded for claims: field_attach_presave() has
 * already normalised field_status_date to its stored 'Y-m-d H:i:s' by the time
 * this runs, whatever widget produced it, and the node row is not written yet,
 * so no second node_save() is needed.
 *
 * It also covers every path with one implementation — the automatic initial
 * transaction, node/add/service_transaction and node/%nid/edit — which is why
 * the title is regenerated on every edition and can never describe a state the
 * transaction no longer has. The stable identifier is the nid, not the title.
 *
 * myapi_services_request_statuses() (includes/myapi.services_common.inc,
 * SPEC 77) is the catalogue, reused rather than duplicated; a key that is not
 * in it falls back to the raw stored value, same semantics as the generic
 * acknowledgement text above.
 *
 * myapi_building_admin_field_value() / myapi_building_admin_field_target_id()
 * (includes/myapi.building_admin.inc, SPEC 49) are reused as-is rather than
 * re-reading $node->field_x[LANGUAGE_NONE][0]['value'] by hand.
 *
 * @param object $node
 *   The 'service_transaction' node about to be saved.
 */
function myapi_service_transaction_set_title($node) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $status = myapi_building_admin_field_value($node, 'field_request_status');
  $statuses = myapi_services_request_statuses();

  $node->title = myapi_service_transaction_title(
    myapi_building_admin_field_target_id($node, 'field_request'),
    ($status !== NULL && isset($statuses[$status])) ? $statuses[$status] : $status,
    myapi_building_admin_field_value($node, 'field_status_date'),
    myapi_building_admin_field_value($node, 'field_comment')
  );
}

/**
 * Creates the automatic initial transaction of a newly-created
 * 'service_request'.
 *
 * Delegate of myapi_node_insert()'s 'service_request' branch (myapi.module).
 * hook_node_insert() covers every creation path of a request with ONE
 * implementation — node/add/service_request, POST /api/v1/service-requests
 * (SPEC 90), and any future one (a migration, another resource) — which is the
 * whole point of hanging this off the node hook rather than off the endpoint or
 * the form. It is the same decision SPEC 57 took for claims, and the reason
 * myapi_claim_create() does not carry a single line about transactions.
 *
 * "Según el estado" means COPY, not filter: exactly one transaction is always
 * created, and its field_request_status is whatever the request has at this
 * instant — 'open', 'direct', or whatever an operator picked on the form.
 * Filtering would leave without a first timeline entry precisely the requests
 * an operator registers already closed or cancelled, the ones that most need a
 * trace of why they are like that. The status decides WHAT is recorded and
 * WHICH acknowledgement text it carries, not whether the row exists.
 *
 * The title is NOT written here: myapi_service_transaction_set_title() above
 * puts it in, from myapi_node_presave(), which runs inside the node_save()
 * below and also covers transactions created by hand.
 *
 * No transient notification flag, unlike SPEC 68's
 * $node->myapi_skip_claim_notification: the marketplace has no notifier at all
 * yet, so there would be nothing to silence. Whichever spec writes the
 * notifications decides then whether this transaction stays quiet.
 *
 * No reverse sync either: nothing here re-saves the request. The direction is
 * request -> transaction and only that, so there is no cascade — and there
 * cannot be one from the insert of the transaction itself, since
 * myapi_node_insert() has no 'service_transaction' branch. A future spec adding
 * one must keep that property.
 *
 * Only ever called from hook_node_insert(), never hook_node_update(): editing
 * an existing request must not create a second initial transaction. Each
 * status transition (offering, assigning, closing, cancelling) will create its
 * own transaction in its own spec, next to the rest of its effects.
 *
 * myapi_building_admin_field_value() (includes/myapi.building_admin.inc,
 * SPEC 49) is reused as-is rather than re-reading
 * $node->field_request_status[LANGUAGE_NONE][0]['value'] by hand.
 *
 * @param object $node
 *   The just-inserted 'service_request' node.
 */
function myapi_service_transaction_create_initial($node) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $status = myapi_building_admin_field_value($node, 'field_request_status');

  $transaction = (object) array(
    'type' => MYAPI_SERVICES_TRANSACTION_TYPE,
    // Who saved the node that originated this — the resident behind the token
    // via the API, the operator via the back office. A verifiable fact, and the
    // same one the request itself records. field_requester answers a different
    // question ("whose request is this") and is already stored on the request.
    'uid' => $node->uid,
    'status' => 1,
  );
  node_object_prepare($transaction);

  $transaction->field_request[LANGUAGE_NONE][0]['target_id'] = $node->nid;
  // Copied as-is. A request saved programmatically without a status copies the
  // empty value: the transaction records what there was, not what there should
  // have been, and the comment degrades to 'Solicitud registrada.'
  $transaction->field_request_status[LANGUAGE_NONE][0]['value'] = $status;
  // 'Y-m-d H:i:00': the real instant of the creation with the seconds pinned,
  // not that day at midnight — the exact bug SPEC 58 had to fix in claims. The
  // field is 'datetime' and not 'datestamp' (SPEC 77, shared with
  // claim_transaction), so the string is written, not a timestamp.
  $transaction->field_status_date[LANGUAGE_NONE][0]['value'] = date('Y-m-d H:i:00');
  // Only 'value' is written, no 'format', exactly like claims: the column is
  // stored raw and whoever displays it escapes it.
  $transaction->field_comment[LANGUAGE_NONE][0]['value'] = myapi_service_transaction_initial_comment($status);

  node_save($transaction);
}
