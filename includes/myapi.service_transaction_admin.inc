<?php

/**
 * @file
 * Back-office timeline of a service request's transactions (SPEC 94).
 *
 * Everything behind the transactions fieldset added to node/%nid/edit of a
 * 'service_request', plus the two routes it links to —
 * node/%node/service-transaction/add and
 * node/%node/service-transaction/%node/delete. It is NOT an API endpoint:
 * nothing here returns the JSON envelope, and no resource under resources/
 * calls into it.
 *
 * Separate from includes/myapi.service_transaction.inc, which stays what
 * SPEC 92 made it — the automatic initial transaction and the autogenerated
 * title, code that runs inside every node_save() of the site. The '_admin'
 * suffix means here exactly what it means in
 * includes/myapi.claim_transaction_admin.inc: this file only ever runs behind
 * a back-office screen.
 *
 * The timeline query below is this file's OWN, and deliberately not
 * myapi_service_request_load_transactions() (SPEC 93): that one lives in
 * resources/service_request.resource.inc, which Regla 5 de CLAUDE.md forbids
 * an include from entering, and it answers a different question anyway — ASC
 * for an app narrating the request from its beginning, no author, dates
 * already shaped for JSON. Two consumers, two queries.
 *
 * The status catalogue is NOT duplicated here either:
 * myapi_services_request_statuses() (includes/myapi.services_common.inc,
 * SPEC 77) is the single source of both the select's options and the table's
 * labels, loaded with module_load_include() per Regla 3 de CLAUDE.md. It is
 * the same function myapi.install reads to build field_request_status'
 * allowed_values, which is what keeps the two from drifting apart.
 */

module_load_include('inc', 'myapi', 'includes/myapi.services_common');
module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

/**
 * Reads the transaction timeline of a service request, most recent first.
 *
 * One row per published 'service_transaction' node whose field_request points
 * at $request_nid. INNER JOIN on field_request because that join IS the filter
 * — a transaction with no request is not part of any timeline — and LEFT JOIN
 * on the three value fields and on users, so a row missing its comment or
 * written by a since-deleted account still appears instead of vanishing from
 * the log.
 *
 * ORDER BY field_status_date DESC, nid DESC: field_status_date is a
 * minute-granularity 'datetime' field stored as a lexicographically sortable
 * 'Y-m-d H:i:s' string, so ordering by the raw joined column orders by the
 * full instant, and the nid tie-break makes it deterministic when two
 * transactions share a minute.
 *
 * DESC is the OPPOSITE of myapi_service_request_load_transactions() (SPEC 93,
 * ASC) on purpose, and it is the same split claims already made: the app
 * narrates the request from beginning to end, the operator wants the last
 * thing that happened at the top.
 *
 * No ->addTag('node_access'): whoever reached node/%nid/edit of the request
 * already passed the access check on it, and the transaction has no access of
 * its own. Per-row access is decided afterwards, and only for the Editar /
 * Borrar links.
 *
 * @param int $request_nid
 *   The 'service_request' node id whose transactions to list.
 *
 * @return array
 *   One object per transaction, each with: nid, status, status_date (the full
 *   stored 'Y-m-d H:i:s'), comment, uid, user_name, created. Fetched eagerly —
 *   the expected volume per request is low (SPEC 94 scope), so no pager.
 */
function myapi_service_transaction_timeline_rows($request_nid) {
  $query = db_select('node', 'n')
    ->fields('n', array('nid', 'uid', 'created'))
    ->condition('n.type', MYAPI_SERVICES_TRANSACTION_TYPE)
    ->condition('n.status', 1);

  $query->innerJoin('field_data_field_request', 'fr', "fr.entity_id = n.nid AND fr.entity_type = 'node' AND fr.deleted = 0");
  $query->condition('fr.field_request_target_id', (int) $request_nid);

  $query->leftJoin('field_data_field_request_status', 'frs', "frs.entity_id = n.nid AND frs.entity_type = 'node' AND frs.deleted = 0");
  $query->addField('frs', 'field_request_status_value', 'status');

  $query->leftJoin('field_data_field_status_date', 'fsd', "fsd.entity_id = n.nid AND fsd.entity_type = 'node' AND fsd.deleted = 0");
  $query->addField('fsd', 'field_status_date_value', 'status_date');

  $query->leftJoin('field_data_field_comment', 'fcm', "fcm.entity_id = n.nid AND fcm.entity_type = 'node' AND fcm.deleted = 0");
  $query->addField('fcm', 'field_comment_value', 'comment');

  $query->leftJoin('users', 'u', 'u.uid = n.uid');
  $query->addField('u', 'name', 'user_name');

  $query->orderBy('fsd.field_status_date_value', 'DESC');
  $query->orderBy('n.nid', 'DESC');

  return $query->execute()->fetchAll();
}

/**
 * Human label for the author of a timeline row.
 *
 * Only two cases, same criterion as its claims twin
 * myapi_claim_transaction_author_label(): 'uid' here is the transaction node's
 * own native author column (node.uid), never NULL, so there is no "nobody set
 * it" case to cover — only "the account was deleted since" (user_name NULL
 * through the LEFT JOIN) versus present.
 *
 * The uid recorded is the OPERATOR who saved the transaction, not the
 * requester: it is the question this column answers, and the criterion
 * SPEC 92 already fixed for the automatic initial transaction.
 *
 * @param object $row
 *   Row from myapi_service_transaction_timeline_rows().
 *
 * @return string
 *   Already escaped.
 */
function myapi_service_transaction_author_label($row) {
  if ($row->user_name === NULL) {
    return t('Usuario eliminado (#@uid)', array('@uid' => $row->uid));
  }

  return check_plain($row->user_name);
}

/* ---------------------------------------------------------------------------
 * Creation form.
 * ------------------------------------------------------------------------ */

/**
 * FAPI form to create one 'service_transaction' node.
 *
 * A form of its own — not the native 'service_transaction' node form — so it
 * shows exactly the three fields the timeline's 'Crear transacción' action
 * needs and hides field_request entirely: it travels as the 'request_nid'
 * #type => 'value' element instead, fixed to $request_node->nid. The native
 * form would make the operator find the request by hand in an autocomplete,
 * with the mistake of pointing it at another one, and would land them on
 * node/<nid> afterwards, outside the context they came from.
 *
 * Every field is built by hand and written straight onto the node object in
 * the submit handler — the same manual field-assignment style
 * myapi_service_transaction_create_initial() (SPEC 92) uses — rather than
 * going through field_default_form(), which would drag in the native form's
 * machinery this form exists to avoid.
 *
 * The status options come from myapi_services_request_statuses() (SPEC 77),
 * reused and never transcribed: it is the same function myapi.install reads to
 * build field_request_status' allowed_values.
 *
 * No title element: myapi_service_transaction_set_title() (SPEC 92) composes
 * it from hook_node_presave(), which runs inside the node_save() below.
 *
 * @param array $form
 * @param array $form_state
 * @param object $request_node
 *   The 'service_request' node this transaction belongs to.
 */
function myapi_service_transaction_create_form($form, &$form_state, $request_node) {
  $form['field_request_status'] = array(
    '#type' => 'select',
    '#title' => t('Estado'),
    '#options' => myapi_services_request_statuses(),
    '#required' => TRUE,
  );

  // Plain textfield, 'Y-m-d H:i' as typed text — NOT date_select (the widget
  // the bundle's own native form uses) and NOT date_popup. SPEC 57 tried both
  // "combo" widgets live on the claims screen and reverted both: each brings
  // its own layout CSS, which broke the alignment of the rest of the form. A
  // plain textfield uses the same 'form_element' wrapper as the select and the
  // textarea around it, so there is no special-case CSS left to fight.
  $form['field_status_date'] = array(
    '#type' => 'textfield',
    '#title' => t('Fecha del estado'),
    '#default_value' => date('Y-m-d H:i'),
    '#size' => 20,
    '#maxlength' => 16,
    '#description' => t('Formato: AAAA-MM-DD HH:MM.'),
    '#required' => TRUE,
    '#element_validate' => array('myapi_service_transaction_validate_status_date'),
  );

  $form['field_comment'] = array(
    '#type' => 'textarea',
    '#title' => t('Comentario'),
    // Same as in claims: a transaction without a comment explains nothing.
    '#required' => TRUE,
  );

  $form['request_nid'] = array(
    '#type' => 'value',
    '#value' => $request_node->nid,
  );

  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Guardar'),
  );

  return $form;
}

/**
 * #element_validate callback of the field_status_date textfield.
 *
 * Splits the typed 'AAAA-MM-DD HH:MM' on its single space and validates each
 * half: the date with a pattern plus checkdate(), so '2026-02-31' fails as
 * loudly as 'ayer'; the time with myapi_time_format_is_valid()
 * (includes/myapi.time_format.inc), the one function in the module that knows
 * the HH:MM pattern.
 *
 * The date half is validated HERE rather than by reusing
 * myapi_reservation_valid_date(), which is the function its claims twin calls:
 * that one lives in resources/reservation.resource.inc, and Regla 5 de
 * CLAUDE.md forbids an include from reaching into a resource file — the same
 * rule this file already obeys by not calling SPEC 93's timeline query. The
 * criterion is identical, only the dependency differs.
 *
 * A value with no time part fails: explode() returns a single element, $time
 * stays '' and the error fires. Deliberate — the timeline records the exact
 * instant of a status change, so a bare date is not accepted.
 *
 * PURE except form_error()/t(), which is what puts it inside tests/unit.
 *
 * @param array $element
 * @param array $form_state
 */
function myapi_service_transaction_validate_status_date($element, &$form_state) {
  module_load_include('inc', 'myapi', 'includes/myapi.time_format');

  $parts = explode(' ', trim($element['#value']), 2);
  $date = isset($parts[0]) ? $parts[0] : '';
  $time = isset($parts[1]) ? $parts[1] : '';

  $valid = (bool) preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $date, $m)
    && checkdate((int) $m[2], (int) $m[3], (int) $m[1])
    && myapi_time_format_is_valid($time);

  if (!$valid) {
    form_error($element, t('La fecha debe tener el formato AAAA-MM-DD HH:MM, con una fecha y una hora válidas.'));
  }
}

/**
 * Submit handler of myapi_service_transaction_create_form().
 *
 * Builds and saves the 'service_transaction' node by hand — field_request =
 * the request this form was opened for, uid = the operator who is saving,
 * status = 1 — then redirects back to the request's edit page. A normal
 * POST/redirect, no #ajax replace: SPEC 57 already paid for the modal
 * experiment and dropped it.
 *
 * The uid recorded is the OPERATOR, not the requester. It is the fact the
 * 'Autor' column of the timeline answers, and the same criterion SPEC 92 fixed
 * for the automatic initial transaction.
 *
 * Nothing here touches the request's own field_request_status: the
 * 'service_transaction' branch of myapi_node_insert() (myapi.module) is what
 * syncs it, so the same rule also covers the native
 * node/add/service_transaction form and node/<nid>/edit of a transaction.
 */
function myapi_service_transaction_create_form_submit($form, &$form_state) {
  global $user;

  $request_nid = $form_state['values']['request_nid'];

  $transaction = (object) array(
    'type' => MYAPI_SERVICES_TRANSACTION_TYPE,
    'uid' => $user->uid,
    'status' => 1,
  );
  node_object_prepare($transaction);

  $transaction->field_request[LANGUAGE_NONE][0]['target_id'] = $request_nid;
  $transaction->field_request_status[LANGUAGE_NONE][0]['value'] = $form_state['values']['field_request_status'];
  // Seconds pinned to ':00' — the textfield captures minutes at most, and the
  // field is a 'datetime' stored as the full 'Y-m-d H:i:s' string it always
  // was. Validation above guarantees both halves are present and well-formed.
  $transaction->field_status_date[LANGUAGE_NONE][0]['value'] = trim($form_state['values']['field_status_date']) . ':00';
  // Only 'value' is written, no 'format', exactly like SPEC 92: the column is
  // stored raw and whoever displays it escapes it.
  $transaction->field_comment[LANGUAGE_NONE][0]['value'] = $form_state['values']['field_comment'];

  node_save($transaction);

  $form_state['redirect'] = 'node/' . $request_nid . '/edit';
}

/**
 * Page callback of node/%node/service-transaction/add.
 *
 * A plain page — no modal, no AJAX (see the form above). Access is already
 * resolved by myapi_service_transaction_add_access() (myapi.module) before
 * this runs, so $request_node is guaranteed to be a 'service_request' the
 * current user may update.
 *
 * @param object $request_node
 *   The 'service_request' node loaded from the %node wildcard.
 *
 * @return array
 *   A render array (the form).
 */
function myapi_service_transaction_add_page_callback($request_node) {
  return drupal_get_form('myapi_service_transaction_create_form', $request_node);
}

/* ---------------------------------------------------------------------------
 * Timeline render.
 * ------------------------------------------------------------------------ */

/**
 * The 'Editar' link of one timeline row, or nothing when it may not be used.
 *
 * There is no edit route of this module's own: the link points at the NATIVE
 * node/<nid>/edit form of the transaction, exactly as SPEC 59 decided for
 * claims. All this spec does to that form is lock field_request and force the
 * redirect back — see myapi_service_transaction_transaction_form_alter().
 *
 * The link is HIDDEN rather than disabled for users without access: a link
 * that leads to a 403 is worse than no link, and it is the same criterion the
 * creation route already follows (myapi_service_transaction_add_access(),
 * myapi.module).
 *
 * node_access('update', ...) is the single source of truth, not a hand-rolled
 * role check: it already covers 'bypass node access' for administrator/backend
 * and every hook_node_access() implementation in play. Reimplementing that
 * here would duplicate logic (Regla 3 de CLAUDE.md) and could silently drift
 * from it.
 *
 * This is why the row's raw nid is not enough and node_load() is called per
 * row. The cost is the one SPEC 94 accepts explicitly over the low per-request
 * volume: a transaction is a status change, not a chat. Whichever spec adds a
 * pager decides this too.
 *
 * @param int $nid
 *   The 'service_transaction' node id of the row.
 *
 * @return string
 *   The rendered link, or '' when the node is gone or the user may not update
 *   it. No substitute text: the cell is simply left empty.
 */
function myapi_service_transaction_edit_link($nid) {
  $transaction_node = node_load($nid);
  if (!$transaction_node || !node_access('update', $transaction_node)) {
    return '';
  }

  return l(t('Editar'), 'node/' . $nid . '/edit');
}

/**
 * The 'Borrar' link of one timeline row, or nothing when it may not be used.
 *
 * The first node deletion this module ever offers, hence a route and a
 * confirmation form of its own rather than core's node/<nid>/delete: the
 * native one deletes correctly but leaves the operator on the front page,
 * outside the request they came from.
 *
 * Access is node_access('delete', ...) PURE. SPEC 94 grants no permission to
 * anybody: 'delete any service_transaction content' is not conceded in any
 * hook_update_N, and myapi_building_admin_permissions() has a unit test that
 * fails if any 'delete any ...' ever appears there — the module's rule is that
 * content is unpublished or cancelled, not deleted. A site that wants
 * 'backend' to delete transactions grants it from /admin/people/permissions;
 * the code does not decide that for it. Meanwhile whoever lacks it sees an
 * EMPTY cell instead of a link that answers 403, same criterion as the
 * 'Editar' link above.
 *
 * @param int $request_nid
 *   The 'service_request' the row belongs to. Part of the route, and what
 *   myapi_service_transaction_delete_access() checks the transaction against.
 * @param int $nid
 *   The 'service_transaction' node id of the row.
 *
 * @return string
 *   The rendered link, or '' when the node is gone or the user may not delete
 *   it. No substitute text.
 */
function myapi_service_transaction_delete_link($request_nid, $nid) {
  $transaction_node = node_load($nid);
  if (!$transaction_node || !node_access('delete', $transaction_node)) {
    return '';
  }

  return l(t('Borrar'), 'node/' . $request_nid . '/service-transaction/' . $nid . '/delete');
}

/**
 * Builds the timeline table body from the query rows.
 *
 * Status is labelled against myapi_services_request_statuses() (SPEC 77),
 * loaded at the top of this file and never transcribed. A key that is not in
 * the catalogue degrades to the raw stored value, which still reads, rather
 * than to an empty cell — the same fallback
 * myapi_service_transaction_initial_comment() (SPEC 92) already applies to the
 * same catalogue.
 *
 * The status date cell is a SUBSTRING of the stored value, not a
 * format_date(strtotime(...)) like its claims twin. field_status_date was
 * created with tz_handling = 'none' (SPEC 55, shared with claim_transaction),
 * so what is stored is a naive local time: converting it would shift the hour
 * somebody typed by hand. The cut to 16 characters drops only the seconds,
 * which this module always pins to :00, and leaves exactly the
 * 'AAAA-MM-DD HH:MM' the creation form asks for. 'created' follows the
 * opposite rule and is a real timestamp — the same two-column, two-rules split
 * SPEC 93 documents for the API.
 *
 * @param array $rows
 *   Rows from myapi_service_transaction_timeline_rows().
 *
 * @return array
 *   One row per transaction, ready for '#theme' => 'table'.
 */
function myapi_service_transaction_timeline_table_rows(array $rows, $request_nid) {
  $statuses = myapi_services_request_statuses();
  $table_rows = array();

  foreach ($rows as $row) {
    $status = $row->status;
    $label = ($status !== NULL && isset($statuses[$status])) ? $statuses[$status] : $status;

    $table_rows[] = array(
      ($label === NULL || $label === '') ? '—' : check_plain($label),
      ($row->status_date === NULL || $row->status_date === '') ? '—' : check_plain(substr($row->status_date, 0, 16)),
      ($row->comment === NULL || $row->comment === '') ? '—' : check_plain($row->comment),
      myapi_service_transaction_author_label($row),
      // Already-rendered markup, so it goes in as a '#markup' render element
      // and not as a plain string: theme_table() runs check_plain() over a
      // string cell, which would print the <a> tag instead of the link. Empty
      // for the rows the current user may not update.
      array('data' => array('#markup' => myapi_service_transaction_edit_link($row->nid))),
      array('data' => array('#markup' => myapi_service_transaction_delete_link($request_nid, $row->nid))),
    );
  }

  return $table_rows;
}

/**
 * Builds the transactions timeline block of a service request.
 *
 * @param object $request_node
 *   The 'service_request' node being edited.
 *
 * @return array
 *   A render array.
 */
function myapi_service_transaction_timeline_build($request_node) {
  $rows = myapi_service_transaction_timeline_rows($request_node->nid);

  $build = array();

  // FIRST, above the table: the operator's action on this screen is adding the
  // next entry, and the timeline below is read-only. A plain link to
  // node/%node/service-transaction/add — no AJAX, no modal.
  $build['create_link'] = array(
    '#markup' => '<p>' . l(t('Crear transacción'), 'node/' . $request_node->nid . '/service-transaction/add', array(
      'attributes' => array('class' => array('button')),
    )) . '</p>',
  );

  $build['table'] = array(
    '#theme' => 'table',
    '#header' => array(t('Estado'), t('Fecha del estado'), t('Comentario'), t('Autor'), t('Editar'), t('Borrar')),
    '#rows' => myapi_service_transaction_timeline_table_rows($rows, $request_node->nid),
    '#empty' => t('Todavía no hay transacciones para esta solicitud.'),
  );

  return $build;
}

/* ---------------------------------------------------------------------------
 * 'service_request' node form alter.
 * ------------------------------------------------------------------------ */

/**
 * Delegate of myapi_form_service_request_node_form_alter() (myapi.module).
 *
 * Only touches the form in edit mode ($form['#node']->nid set). On
 * node/add/service_request field_request_status stays editable and no
 * fieldset is appended: that form is where the INITIAL status is chosen, the
 * one myapi_service_transaction_create_initial() (SPEC 92) copies into the
 * automatic first transaction, and a request being created has no timeline to
 * show yet. A literal mirror of
 * myapi_claim_transaction_reclamo_form_alter() (SPEC 57), including this
 * asymmetry.
 *
 * #disabled, not #access = FALSE: the operator has to SEE which status the
 * request is in while deciding which transaction to create; what they must
 * not do is rewrite it from here without leaving a trace. The status moves by
 * creating a transaction, which records who, when and why. Drupal also
 * resubmits a disabled element's #default_value, so saving the rest of the
 * request's form never blanks field_request_status.
 *
 * Same traversal as the claims twin: field_request_status is a single-value
 * ('options_select') field, so element_children() over the langcode level is
 * enough — #disabled set there propagates down to every delta, so no per-delta
 * loop is needed. The isset() guards the case where another module, or a
 * field_access rule, removed the field from the form altogether.
 *
 * @param array $form
 * @param array $form_state
 */
function myapi_service_transaction_request_form_alter(&$form, &$form_state) {
  if (empty($form['#node']->nid)) {
    return;
  }

  if (isset($form['field_request_status'])) {
    foreach (element_children($form['field_request_status']) as $langcode) {
      $form['field_request_status'][$langcode]['#disabled'] = TRUE;
    }
  }

  $form['myapi_service_transactions'] = array(
    '#type' => 'fieldset',
    '#title' => t('Línea de tiempo de transacciones'),
    '#weight' => 900,
  ) + myapi_service_transaction_timeline_build($form['#node']);
}

/* ---------------------------------------------------------------------------
 * 'service_transaction' node form alter.
 * ------------------------------------------------------------------------ */

/**
 * Delegate of myapi_form_service_transaction_node_form_alter() (myapi.module).
 *
 * Two things, both only in edit mode ($form['#node']->nid set): field_request
 * is locked, and the redirect handler below is appended. On
 * node/add/service_transaction neither happens — a transaction being created
 * belongs to no request yet, so there is nothing to protect and nowhere to
 * redirect to. Same criterion as
 * myapi_service_transaction_request_form_alter() on node/add/service_request,
 * and the same one SPEC 59 fixed for claims.
 *
 * #disabled, not #access = FALSE: the operator keeps seeing WHICH request the
 * transaction belongs to, and Drupal resubmits a disabled element's value, so
 * saving never blanks it — nor accepts a different one sent by a hand-crafted
 * POST, which is the risk this lock exists for.
 *
 * The walk goes one level deeper than the field_request_status one:
 * field_request uses the 'entityreference_autocomplete' widget, which nests
 * the real textfield under 'target_id' inside each delta, whereas
 * 'options_select' makes the langcode-level element itself the select.
 *
 * The isset() guards the LOOP only, never the #submit: if another module or a
 * field_access rule removed field_request from the form there is nothing to
 * disable, but redirecting to the request is still right — the handler
 * resolves it from the saved node, not from the form.
 *
 * The handler is appended to BOTH $form['#submit'] and the Save button's own
 * $form['actions']['submit']['#submit'], for the reason SPEC 59 had to
 * discover on the site: form_execute_handlers() runs the TRIGGERING ELEMENT's
 * list when it has one and ignores the form-level one entirely, and node_form()
 * gives its Save button its own array('node_form_submit'). Only one of the two
 * lists ever executes, so this never runs twice; and even if it did, assigning
 * the same redirect twice is idempotent. Without the button list, saving lands
 * on Drupal's native node/<nid> as if the handler did not exist — which is
 * exactly what SPEC 94's acceptance criterion 28 forbids.
 *
 * @param array $form
 * @param array $form_state
 */
function myapi_service_transaction_transaction_form_alter(&$form, &$form_state) {
  if (empty($form['#node']->nid)) {
    return;
  }

  if (isset($form['field_request'])) {
    foreach (element_children($form['field_request']) as $langcode) {
      foreach (element_children($form['field_request'][$langcode]) as $delta) {
        if (isset($form['field_request'][$langcode][$delta]['target_id'])) {
          $form['field_request'][$langcode][$delta]['target_id']['#disabled'] = TRUE;
        }
      }
    }
  }

  $form['#submit'][] = 'myapi_service_transaction_edit_form_submit_redirect';

  if (isset($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = 'myapi_service_transaction_edit_form_submit_redirect';
  }
}

/**
 * Sends the operator back to the request after saving a transaction.
 *
 * Appended to the END of the submit chain by the alter above, so it runs after
 * node_form_submit() has saved the node and left the updated object in
 * $form_state['node'] — field_request included, which Drupal resubmits despite
 * the #disabled.
 *
 * Overriding $form_state['redirect'] is the standard FAPI way to change where
 * a form lands, and is why this is a submit handler rather than a drupal_goto()
 * inside hook_node_update(): a goto there would abort the other
 * hook_node_update() implementations queued behind it — this module's own
 * status sync among them.
 *
 * When field_request does not resolve, the redirect is left ALONE rather than
 * set to something invalid: Drupal then falls back to its native destination,
 * node/<nid>. The empty($form_state['node']) guard is the counterpart for a
 * submit chain another module altered — reading a missing index would be a PHP
 * notice.
 *
 * @param array $form
 * @param array $form_state
 */
function myapi_service_transaction_edit_form_submit_redirect($form, &$form_state) {
  if (empty($form_state['node'])) {
    return;
  }

  $request_nid = myapi_building_admin_field_target_id($form_state['node'], 'field_request');
  if ($request_nid) {
    $form_state['redirect'] = 'node/' . $request_nid . '/edit';
  }
}

/* ---------------------------------------------------------------------------
 * Deletion.
 * ------------------------------------------------------------------------ */

/**
 * Confirmation form to delete one 'service_transaction' node.
 *
 * confirm_form() is Drupal core's (includes/form.inc) with nothing of this
 * module's own around it: it builds the question, the description, the two
 * buttons and the 'Cancelar' link, and registers the standard confirm submit
 * flow. The cancel path is the request's edit page, so saying no lands exactly
 * where saying yes does.
 *
 * The description says out loud that the request's status does NOT change,
 * because that is precisely what an operator could assume the other way round.
 * Deleting corrects the log; it is not a second — invisible, unauditable — way
 * of moving the status. Moving it is done by creating a transaction.
 *
 * Both nodes travel as #type => 'value' rather than being re-loaded in the
 * submit handler: they are already loaded and already validated by
 * myapi_service_transaction_delete_access() (myapi.module), which is also what
 * checked that this transaction really belongs to this request.
 *
 * @param array $form
 * @param array $form_state
 * @param object $request_node
 *   The 'service_request' the transaction belongs to.
 * @param object $transaction_node
 *   The 'service_transaction' about to be deleted.
 */
function myapi_service_transaction_delete_form($form, &$form_state, $request_node, $transaction_node) {
  $form['request_nid'] = array('#type' => 'value', '#value' => $request_node->nid);
  $form['transaction_nid'] = array('#type' => 'value', '#value' => $transaction_node->nid);

  return confirm_form(
    $form,
    t('¿Borrar esta transacción?'),
    'node/' . $request_node->nid . '/edit',
    t('Se borrará la transacción «@title». Esta acción no se puede deshacer. El estado de la solicitud no cambia.', array('@title' => $transaction_node->title)),
    t('Borrar'),
    t('Cancelar')
  );
}

/**
 * Submit handler of myapi_service_transaction_delete_form().
 *
 * node_delete() and the redirect back, and NOTHING else. In particular it does
 * not touch the request's field_request_status: recalculating it from the most
 * recent surviving transaction would turn deletion into a second way of
 * changing the status — with no author and no comment — and would force a
 * decision about which status is left when no transaction survives at all.
 *
 * The automatic initial transaction of SPEC 92 is deleted like any other:
 * nothing distinguishes it today, and protecting it would need either a new
 * field or the guess that it is the one with the lowest nid, a heuristic that
 * breaks the moment somebody deletes it and the next one inherits the post.
 */
function myapi_service_transaction_delete_form_submit($form, &$form_state) {
  node_delete($form_state['values']['transaction_nid']);

  $form_state['redirect'] = 'node/' . $form_state['values']['request_nid'] . '/edit';
}

/**
 * Page callback of node/%node/service-transaction/%node/delete.
 *
 * Access is already resolved by myapi_service_transaction_delete_access()
 * (myapi.module) before this runs: both nodes are of the expected bundles, the
 * transaction really belongs to this request, and the current user may update
 * the request and delete the transaction.
 *
 * @param object $request_node
 *   The 'service_request' loaded from the first %node wildcard.
 * @param object $transaction_node
 *   The 'service_transaction' loaded from the second one.
 *
 * @return array
 *   A render array (the confirmation form).
 */
function myapi_service_transaction_delete_page_callback($request_node, $transaction_node) {
  return drupal_get_form('myapi_service_transaction_delete_form', $request_node, $transaction_node);
}

/* ---------------------------------------------------------------------------
 * Status sync: transaction -> request.
 * ------------------------------------------------------------------------ */

/**
 * Rewrites the request's field_request_status to the transaction's own, when
 * they differ.
 *
 * Delegate of BOTH myapi_node_insert() and myapi_node_update()'s
 * 'service_transaction' branches (myapi.module). The rule lives in the node
 * hooks and not in myapi_service_transaction_create_form_submit() precisely so
 * that node/add/service_transaction and node/%nid/edit of a transaction — the
 * native forms, which never go through this file's creation page — are covered
 * too, without the sync being written twice.
 *
 * SPEC 92 deliberately did NOT sync, and said why: field_request_status has a
 * transition graph, myapi_services_request_transitions(), that nobody
 * validates, so syncing would let anyone put a request into an impossible
 * state. SPEC 94 reverts that decision knowingly. Without the sync, "the
 * operator can change the status" means nothing here: the transaction would be
 * a log entry and the real status would have to be moved from a field this
 * screen locks. And validating the graph ONLY here would make this door
 * stricter than api/v1, which does not validate it either — two doors with
 * different rules is worse than two doors equally permissive. Validating
 * transitions is its own spec, for both doors at once.
 *
 * Three properties that have to be read together, because they are the reason
 * this cannot loop:
 *
 *   1. THE INITIAL TRANSACTION FIRES NOTHING. SPEC 92's automatic transaction
 *      is born copying the status the request already has, so the comparison
 *      below returns before the node_save(). Creating a request still saves
 *      exactly two nodes.
 *   2. NO CASCADE. The node_save($request) here is an UPDATE of a
 *      'service_request', and myapi_node_update() has no 'service_request'
 *      branch; the one that does exist, in myapi_node_insert(), only runs on
 *      insert. SPEC 92 wrote that property down and asked whoever added a
 *      'service_transaction' branch to keep it — it is kept, and written down
 *      again here for whoever comes next.
 *   3. NO GRAPH VALIDATION. myapi_services_request_transitions() is not
 *      consulted. That is the decision above, not an oversight: a 'closed' ->
 *      'open' transaction saves without error, exactly as it would through the
 *      API today.
 *
 * There is no transient previous-status property, unlike its claims twin
 * myapi_claim_transaction_sync_claim_status() (SPEC 71): that stash exists to
 * feed a notifier, and the marketplace has none yet.
 *
 * myapi_building_admin_field_target_id() / myapi_building_admin_field_value()
 * (includes/myapi.building_admin.inc, SPEC 49) are reused as-is rather than
 * re-reading $node->field_x[LANGUAGE_NONE][0] by hand.
 *
 * @param object $node
 *   The just-saved 'service_transaction' node.
 */
function myapi_service_transaction_sync_request_status($node) {
  $request_nid = myapi_building_admin_field_target_id($node, 'field_request');
  $status = myapi_building_admin_field_value($node, 'field_request_status');

  // A transaction with no request, or with no status of its own, has nothing
  // to sync. It records what there was; it does not blank the request.
  if (!$request_nid || $status === NULL || $status === '') {
    return;
  }

  $request = node_load($request_nid);
  if (!$request || $request->type !== MYAPI_SERVICES_REQUEST_TYPE) {
    return;
  }

  if (myapi_building_admin_field_value($request, 'field_request_status') === $status) {
    // Already in that status: not one node_save() more. This is the branch
    // SPEC 92's automatic initial transaction always takes.
    return;
  }

  $request->field_request_status[LANGUAGE_NONE][0]['value'] = $status;
  node_save($request);
}
