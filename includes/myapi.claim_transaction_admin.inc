/**
 * Page callback of node/%node/claim-transaction/add (SPEC 57).
 *
 * A plain page — no modal, no AJAX. Access is already resolved by
 * myapi_claim_transaction_add_access() (myapi.module) before this runs —
 * $claim_node is guaranteed to be a 'reclamo' the current user may update.
 *
 * Originally this route also served an AJAX/jQuery UI Dialog modal on top of
 * this same form (opened from an 'use-ajax' link on node/%nid/edit). Dropped
 * during implementation at the user's request: the jQuery UI dialog styling
 * did not fit the site (missing theme CSS, a duplicated date_popup label),
 * and a plain page/redirect flow was preferred outright over fixing it. The
 * whole POST/redirect submit design (myapi_claim_transaction_create_form(),
 * still unchanged) already assumed a full-page fallback, so nothing about
 * the form or its submit handler needed to change — only this callback and
 * the link in myapi_claim_transaction_timeline_build() (below) did.
 *
 * @param object $claim_node
 *   The 'reclamo' node loaded from the %node wildcard.
 *
 * @return array  A render array (the form).
 */
function myapi_claim_transaction_add_page_callback($claim_node) {
  return drupal_get_form('myapi_claim_transaction_create_form', $claim_node);
}

/* ---------------------------------------------------------------------------
 * 'reclamo' node form alter (SPEC 57).
 * ------------------------------------------------------------------------ */

/**
 * Delegate of myapi_form_reclamo_node_form_alter() (myapi.module).
 *
 * Only touches the form in edit mode ($form['#node']->nid set). On
 * node/add/reclamo the newly-created claim's field_status is exactly what
 * myapi_node_insert()'s 'reclamo' branch copies into the automatic initial
 * transaction (see Modelo de datos), so it stays untouched and editable
 * there — deliberately, not an oversight (see SPEC 57 "Decisiones tomadas y
 * descartadas").
 *
 * #disabled, not #access = FALSE: the value stays visible and Drupal still
 * resubmits a disabled element's #default_value, so saving the rest of the
 * claim's form never blanks field_status. Same traversal pattern as
 * myapi_building_admin_restrict_bulletin_form() (includes/myapi.building_admin.inc):
 * field_status is a single-value ('options_select') field, so
 * element_children() over the langcode level is enough — no per-delta loop
 * is needed for a cardinality-1 field.
 *
 * @param array $form
 * @param array $form_state
 */
function myapi_claim_transaction_reclamo_form_alter(&$form, &$form_state) {
  if (empty($form['#node']->nid)) {
    return;
  }

  foreach (element_children($form['field_status']) as $langcode) {
    $form['field_status'][$langcode]['#disabled'] = TRUE;
  }

  $form['myapi_claim_transactions'] = array(
    '#type' => 'fieldset',
    '#title' => t('Línea de tiempo de transacciones'),
    '#weight' => 900,
  ) + myapi_claim_transaction_timeline_build($form['#node']);
}

/* ---------------------------------------------------------------------------
 * 'claim_transaction' node form alter (SPEC 59).
 * ------------------------------------------------------------------------ */

/**
 * Delegate of myapi_form_claim_transaction_node_form_alter() (myapi.module).
 *
 * Three things. The native title field is hidden in BOTH modes (SPEC 60 — see
 * the comment on that block); the other two happen only in edit mode
 * ($form['#node']->nid set): field_claim is locked, and the redirect handler
 * below is appended. On node/add/claim_transaction neither of those two is
 * touched — a transaction being created does not belong to any claim yet, so
 * there is nothing to protect and nowhere to redirect to; same criterion as
 * myapi_claim_transaction_reclamo_form_alter() on node/add/reclamo.
 *
 * #disabled, not #access = FALSE, for the same reason as field_status in that
 * other alter (SPEC 57): the operator keeps seeing WHICH claim the transaction
 * belongs to, and Drupal resubmits a disabled element's value, so saving never
 * blanks it — nor accepts a different one sent by a hand-crafted POST, which
 * is the risk this lock exists for.
 *
 * The walk goes one level deeper than the field_status one: field_claim uses
 * the 'entityreference_autocomplete' widget, which nests the real textfield
 * under 'target_id' inside each delta, whereas 'options_select' makes the
 * langcode-level element itself the select.
 *
 * The isset() guards the LOOP only, not the #submit: if another module (or a
 * field_access rule) removed field_claim from the form there is nothing to
 * disable, but redirecting to the claim is still right — the handler resolves
 * it from the saved node, not from the form.
 *
 * The handler is appended to BOTH $form['#submit'] and the Save button's own
 * $form['actions']['submit']['#submit'], because form_execute_handlers() runs
 * the TRIGGERING ELEMENT's list when it has one and ignores the form-level one
 * entirely — and node_form() gives its Save button its own
 * array('node_form_submit'). Only one of the two lists ever executes, so this
 * never runs twice; and even if it did, assigning the same redirect twice is
 * idempotent. Without the button list, saving landed on Drupal's native
 * node/<nid> as if the handler did not exist.
 *
 * form_load_include() rather than plain module_load_include(): this form has
 * managed_file fields (field_images, field_attachment), which make Drupal
 * CACHE it, so the POST is served from the cached array and hook_form_alter()
 * — with it, myapi.module's module_load_include() — never runs again. The
 * cached #submit would then point at a function whose file was never loaded,
 * which is exactly the "Call to undefined function
 * myapi_claim_transaction_edit_form_submit_redirect()" seen on the site. What
 * fixes it is the side effect: form_load_include() records the file in
 * $form_state['build_info']['files'], and Drupal reloads those when it
 * retrieves a cached form.
 *
 * @param array $form
 * @param array $form_state
 */
function myapi_claim_transaction_transaction_form_alter(&$form, &$form_state) {
  // SPEC 60, and the only part of this alter that also applies on
  // node/add/claim_transaction — hence above the edit-mode guard. Since the
  // title is regenerated by myapi_claim_transaction_set_title() on every save,
  // anything typed here would be overwritten; showing the field would be
  // lying to the operator.
  //
  // #access = FALSE is what hides it, and it also disables the native
  // #required: _form_builder_handle_input_element() derives $process_input from
  // #access, so an inaccessible element is never flagged #needs_validation and
  // "El campo Título es obligatorio" cannot fire on a field nobody can see. The
  // explicit #required = FALSE states that intent rather than relying on it —
  // the same belt-and-braces pair the contributed auto_nodetitle uses.
  if (isset($form['title'])) {
    $form['title']['#required'] = FALSE;
    $form['title']['#access'] = FALSE;
  }

  if (empty($form['#node']->nid)) {
    return;
  }

  if (isset($form['field_claim'])) {
    foreach (element_children($form['field_claim']) as $langcode) {
      foreach (element_children($form['field_claim'][$langcode]) as $delta) {
        if (isset($form['field_claim'][$langcode][$delta]['target_id'])) {
          $form['field_claim'][$langcode][$delta]['target_id']['#disabled'] = TRUE;
        }
      }
    }
  }

  form_load_include($form_state, 'inc', 'myapi', 'includes/myapi.claim_transaction_admin');

  $form['#submit'][] = 'myapi_claim_transaction_edit_form_submit_redirect';

  if (isset($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = 'myapi_claim_transaction_edit_form_submit_redirect';
  }
}

/**
 * Sends the operator back to the claim after saving a transaction (SPEC 59).
 *
 * Appended to the END of $form['#submit'] by the alter above, so it runs after
 * node_form_submit() has saved the node and left the updated object in
 * $form_state['node'] — field_claim included, which Drupal resubmits despite
 * the #disabled (same mechanism SPEC 57 documents for field_status).
 *
 * Overriding $form_state['redirect'] is the standard FAPI way to change where
 * a form lands, and is why this is a submit handler rather than a
 * drupal_goto() inside hook_node_update(): a goto there would abort the other
 * hook_node_update() implementations queued behind it — including this
 * module's own status sync.
 *
 * When field_claim does not resolve (the corrupt-data case SPEC 56/57 already
 * document) the redirect is left ALONE rather than set to something invalid:
 * Drupal then falls back to its native destination, node/<nid>. The
 * empty($form_state['node']) guard is the counterpart for a submit chain
 * another module altered — reading a missing index would be a PHP notice.
 *
 * @param array $form
 * @param array $form_state
 */
function myapi_claim_transaction_edit_form_submit_redirect($form, &$form_state) {
  if (empty($form_state['node'])) {
    return;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $claim_nid = myapi_building_admin_field_target_id($form_state['node'], 'field_claim');
  if ($claim_nid) {
    $form_state['redirect'] = 'node/' . $claim_nid . '/edit';
  }
}

/* ---------------------------------------------------------------------------
 * Timeline render.
 * ------------------------------------------------------------------------ */

/**
 * Human label for the author of a timeline row.
 *
 * Only two cases, unlike myapi_claims_requester_label() (SPEC 56): 'uid'
 * here is the transaction node's own native author column (node.uid),
 * never NULL, so there is no "nobody set" case to cover — only "the account
 * was deleted since" (user_name NULL through the LEFT JOIN) versus present.
 *
 * @param object $row  Row from myapi_claim_transaction_timeline_rows().
 *
 * @return string  Already escaped.
 */
function myapi_claim_transaction_author_label($row) {
  if ($row->user_name === NULL) {
    return t('Usuario eliminado (#@uid)', array('@uid' => $row->uid));
  }
  return check_plain($row->user_name);
}

/**
 * The 'Editar' link of one timeline row, or nothing when it may not be used
 * (SPEC 59).
 *
 * The link is HIDDEN rather than disabled for users without access: a link
 * that leads to a 403 is worse than no link, and it is the same criterion the
 * creation route already follows (myapi_claim_transaction_add_access(),
 * myapi.module, which also resolves access before showing its own link).
 *
 * node_access('update', ...) is the single source of truth here, not a
 * hand-rolled rule: it already covers 'bypass node access' for
 * administrator/backend AND the per-condominium 'via_claim' filter that
 * SPEC 56 gave 'administrador edificio'. Reimplementing that here would
 * duplicate logic (Regla 3 de CLAUDE.md) and could silently drift from it.
 *
 * This is why the row's raw nid is not enough and node_load() is called per
 * row: node_access() needs the node object. The cost is the one SPEC 56
 * already accepted for 'via_claim' ("se paga por nodo cargado") over the low
 * per-claim volume SPEC 57 assumes (no pager).
 *
 * @param int $nid
 *   The 'claim_transaction' node id of the row.
 *
 * @return string
 *   The rendered link, or '' when the node is gone or the user may not update
 *   it. No substitute text: the cell is simply left empty.
 */
function myapi_claim_transaction_edit_link($nid) {
  $transaction_node = node_load($nid);
  if (!$transaction_node || !node_access('update', $transaction_node)) {
    return '';
  }

  return l(t('Editar'), 'node/' . $nid . '/edit');
}

/**
 * Builds the timeline table body from the query rows.
 *
 * Status is labelled with myapi_claims_status_label() (SPEC 56,
 * includes/myapi.claims_admin.inc) — already loaded at the top of this file
 * — for the same reuse reason as myapi_claims_status_options(): one field,
 * one label source, shared by both bundles.
 *
 * The status date cell shows 'd/m/Y H:i' (SPEC 58), the same custom format
 * myapi.reservation_calendar.inc and myapi.reservation_notification.inc use
 * for their timestamps. Transactions created before SPEC 58 were stored with
 * a '00:00' time and therefore display as such: that is the value actually
 * recorded, not a formatting bug.
 *
 * The last cell is the 'Editar' link (SPEC 59), which is already-rendered
 * markup and therefore goes in as a '#markup' render element rather than as a
 * plain string: theme_table() runs check_plain() over a string cell, which
 * would print the <a> tag instead of the link. Empty for the rows the current
 * user may not update — see myapi_claim_transaction_edit_link().
 *
 * @param array $rows  Rows from myapi_claim_transaction_timeline_rows().
 *
 * @return array  One row per transaction, ready for '#theme' => 'table'.
 */
function myapi_claim_transaction_timeline_table_rows(array $rows) {
  $table_rows = array();

  foreach ($rows as $row) {
    $table_rows[] = array(
      myapi_claims_status_label($row->status),
      $row->status_date === NULL ? '—' : check_plain(format_date(strtotime($row->status_date), 'custom', 'd/m/Y H:i')),
      ($row->comment === NULL || $row->comment === '') ? '—' : check_plain($row->comment),
      myapi_claim_transaction_author_label($row),
      array('data' => array('#markup' => myapi_claim_transaction_edit_link($row->nid))),
    );
  }

  return $table_rows;
}

/**
 * Builds the transactions timeline block: the 'Crear transacción' link and
 * the read-only table.
 *
 * The link comes FIRST (SPEC 57 acceptance criteria: "al inicio de la línea
 * de tiempo, no al final"), and is a plain link to
 * node/%node/claim-transaction/add (myapi_claim_transaction_add_page_callback()) —
 * no AJAX, no modal. Clicking it navigates away and back, same as any other
 * admin action link on this page (e.g. the claims listing's own 'Crear
 * reclamo' button, docs/claims-list.md).
 *
 * @param object $claim_node
 *   The 'reclamo' node being edited.
 *
 * @return array  A render array.
 */
function myapi_claim_transaction_timeline_build($claim_node) {
  $rows = myapi_claim_transaction_timeline_rows($claim_node->nid);

  $build = array();

  $build['create_link'] = array(
    '#markup' => '<p>' . l(t('Crear transacción'), 'node/' . $claim_node->nid . '/claim-transaction/add', array(
      'attributes' => array('class' => array('button')),
    )) . '</p>',
  );

  $build['table'] = array(
    '#theme' => 'table',
    '#header' => array(t('Estado'), t('Fecha de estado'), t('Comentario'), t('Autor'), t('Editar')),
    '#rows' => myapi_claim_transaction_timeline_table_rows($rows),
    '#empty' => t('Todavía no hay transacciones para este reclamo.'),
  );

  return $build;
}

/* ---------------------------------------------------------------------------
 * Automatic initial transaction (SPEC 57).
 * ------------------------------------------------------------------------ */

/**
 * The acknowledgement comment the automatic initial transaction is born with.
 *
 * SPEC 61. Until then the initial transaction was saved with field_comment
 * empty, so the claim's timeline opened with a row whose "Comentario" column
 * read '—': the resident (and the operator) got no confirmation that the claim
 * had been received at all. This is the text that fills it:
 *
 *   Hemos recibido su reclamo. Será revisado por la administración y se le
 *   notificará cualquier novedad.
 *
 * The noun follows field_claim_type, whose two stored values are 'claim' and
 * 'requirement' (myapi.install, SPEC 55). It is written here rather than
 * lowercased off myapi_claims_claim_type_options(): that catalogue supplies
 * SELECT labels ('Reclamo', 'Requerimiento'), and a site administrator editing
 * an allowed_value from the UI would silently rewrite this sentence
 * mid-phrase. Same criterion myapi_claims_valid_claim_type() already states for
 * the stored values themselves (includes/myapi.claims_admin.inc, SPEC 56):
 * labels come from the field, meaning does not.
 *
 * Both nouns are masculine, so the rest of the sentence is invariable — no
 * gender-dependent branch is needed beyond the noun itself.
 *
 * Pure by design (t() only), which is what puts it in tests/unit — same split
 * as SPEC 60's myapi_claim_transaction_title() versus set_title().
 *
 * @param string|null $claim_type
 *   field_claim_type of the claim, as stored.
 *
 * @return string
 *   The comment text. An unknown or missing type falls back to 'reclamo', the
 *   bundle's own name, rather than to no comment at all.
 */
function myapi_claim_transaction_initial_comment($claim_type) {
  $noun = ($claim_type === 'requirement') ? t('requerimiento') : t('reclamo');

  return t('Hemos recibido su @noun. Será revisado por la administración y se le notificará cualquier novedad.', array('@noun' => $noun));
}

/**
 * Creates the automatic initial transaction of a newly-created 'reclamo'.
 *
 * Delegate of myapi_node_insert()'s 'reclamo' branch (myapi.module).
 * hook_node_insert() covers every creation path of a 'reclamo' — the admin
 * node form, and any future programmatic one (migration, api/v1/... resource)
 * — not just the UI, which is the whole point of hanging this off the node
 * hook rather than the node/add/reclamo form itself (see SPEC 57 "Decisiones
 * tomadas y descartadas").
 *
 * field_status is copied from the claim as chosen on node/add/reclamo — where
 * it stays editable, unlike node/%nid/edit — NOT forced to 'received'. Because
 * the transaction is born with the SAME status the claim already has, the
 * sync branch (myapi_claim_transaction_sync_claim_status(), below) never
 * finds a difference and never re-saves the claim: no insert-triggers-update
 * cascade. An acceptance criterion of SPEC 57 checks this directly.
 *
 * field_comment carries the acknowledgement text composed by
 * myapi_claim_transaction_initial_comment() above (SPEC 61), which is why this
 * function now reads field_claim_type off the claim as well. Side effect worth
 * stating: since the transaction is no longer commentless, SPEC 60's
 * autogenerated title gains its fourth segment for this path too.
 *
 * Only ever called from hook_node_insert(), never hook_node_update(): editing
 * an existing claim must not create a second initial transaction.
 *
 * myapi_building_admin_field_value() (includes/myapi.building_admin.inc,
 * SPEC 49) is reused as-is rather than re-reading
 * $node->field_status[LANGUAGE_NONE][0]['value'] by hand — same reuse
 * reasoning as everywhere else in this spec.
 *
 * @param object $node
 *   The just-inserted 'reclamo' node.
 */
function myapi_claim_transaction_create_initial($node) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $transaction = (object) array(
    'type' => 'claim_transaction',
    'uid' => $node->uid,
    'status' => 1,
  );
  node_object_prepare($transaction);

  $transaction->field_claim[LANGUAGE_NONE][0]['target_id'] = $node->nid;
  $transaction->field_status[LANGUAGE_NONE][0]['value'] = myapi_building_admin_field_value($node, 'field_status');
  // 'Y-m-d H:i:00' since SPEC 58: the automatic initial transaction records
  // the real instant the claim was created, not that day at midnight. Same
  // pinned ':00' seconds as the creation form's submit handler.
  $transaction->field_status_date[LANGUAGE_NONE][0]['value'] = date('Y-m-d H:i:00');
  // SPEC 61. Only 'value' is written, no 'format', exactly like
  // myapi_claim_transaction_create_form_submit() above: the timeline reads the
  // raw column and check_plain()s it itself.
  $transaction->field_comment[LANGUAGE_NONE][0]['value'] = myapi_claim_transaction_initial_comment(
    myapi_building_admin_field_value($node, 'field_claim_type')
  );

  // SPEC 68. Transient flag, not a field: it lives only for this save and is
  // what keeps THIS transaction — and only this one — out of the notification
  // hook. The fact it records ("the claim was received") is already notified by
  // the creation of the claim itself; announcing both would be the same message
  // twice, seconds apart. Every other transaction carries no flag and notifies,
  // which is the right default for any future path.
  $transaction->myapi_skip_claim_notification = TRUE;

  node_save($transaction);
}

/* ---------------------------------------------------------------------------
 * Status sync (SPEC 57).
 * ------------------------------------------------------------------------ */

/**
 * Syncs the parent claim's field_status to a transaction's own, when they
 * differ.
 *
 * Delegate of BOTH myapi_node_insert() and myapi_node_update()'s
 * 'claim_transaction' branches (myapi.module). The rule lives in the node
 * hook, not in myapi_claim_transaction_create_form_submit(), precisely so
 * that node/add/claim_transaction and node/%nid/edit of a transaction (the
 * native forms, for 'administrator'/'backend', which never go through
 * myapi_claim_transaction_create_form()) are covered too, without
 * duplicating the sync in two places. See SPEC 57 "Decisiones tomadas y
 * descartadas".
 *
 * Direction is transaction -> claim only: nothing here ever creates or
 * touches another transaction, so there is no insert/update cascade beyond
 * the one already accounted for by myapi_claim_transaction_create_initial() —
 * that transaction is born with the SAME status the claim already has, so
 * this function never finds a difference for it and never re-saves the
 * claim.
 *
 * myapi_building_admin_field_target_id() / myapi_building_admin_field_value()
 * (includes/myapi.building_admin.inc, SPEC 49) are reused as-is — same
 * reasoning as everywhere else in this spec.
 *
 * @param object $node
 *   The just-saved 'claim_transaction' node.
 */
function myapi_claim_transaction_sync_claim_status($node) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $claim_nid = myapi_building_admin_field_target_id($node, 'field_claim');
  $claim = $claim_nid ? node_load($claim_nid) : NULL;

  if (!$claim) {
    return;
  }

  $transaction_status = myapi_building_admin_field_value($node, 'field_status');
  $claim_status = myapi_building_admin_field_value($claim, 'field_status');

  if ($transaction_status === $claim_status) {
    return;
  }

  $claim->field_status[LANGUAGE_NONE][0]['value'] = $transaction_status;
  node_save($claim);
}
