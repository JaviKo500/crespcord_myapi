<?php

/**
 * @file
 * Routing for the myapi module.
 */

// The i18n helpers (myapi_get_lang() / myapi_t()) are used by the shared
// response and request helpers, so load them globally on every request.
module_load_include('inc', 'myapi', 'includes/myapi.i18n');

// The people filter of SPEC 51. Loaded globally, like the i18n helpers above,
// and for a reason that is not obvious: myapi_menu_alter() installs
// myapi_building_admin_user_view_access() as the access callback of user/%user,
// and _menu_check_access() calls the callback behind a function_exists() gate —
// it does NOT include the router item's 'file' first, that happens later in
// menu_execute_active_handler(). With the include missing, the callback would
// simply not exist and access would fall through to FALSE: every profile page
// of the site, for every role, would answer 403. Loading it here is one
// require_once and removes that failure mode entirely.
//
// It costs nothing on an api/v1 request either: the two includes this file
// leans on are loaded from inside its own functions, only when the filter is
// actually active.
module_load_include('inc', 'myapi', 'includes/myapi.building_admin_user');

// OneSignal push queue name. Defined here in the always-loaded .module (not only
// in includes/myapi.notification.inc) because hook_cron_queue_info() references
// it to register the worker: during cron that hook can run before its include
// is loaded, and an undefined constant would register the worker under the wrong
// queue name, so items enqueued as 'myapi_onesignal_push' would never drain.
if (!defined('MYAPI_ONESIGNAL_QUEUE')) {
  define('MYAPI_ONESIGNAL_QUEUE', 'myapi_onesignal_push');
}

// Deferred mail queue name. Defined here for the same reason as the OneSignal
// queue above: hook_cron_queue_info() references it to register the worker
// before includes/myapi.mail_queue.inc is necessarily loaded.
if (!defined('MYAPI_MAIL_QUEUE')) {
  define('MYAPI_MAIL_QUEUE', 'myapi_mail_send');
}

/**
 * Implements hook_menu().
 */
function myapi_menu() {
  $items = [];

  $items['api/v1/ping'] = [
    'page callback'    => 'myapi_ping_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/ping.resource.inc',
  ];

  $items['api/v1/auth/login'] = [
    'page callback'    => 'myapi_auth_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/auth.resource.inc',
  ];

  $items['api/v1/auth/refresh'] = [
    'page callback'    => 'myapi_auth_refresh_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/auth.resource.inc',
  ];

  $items['api/v1/auth/logout'] = [
    'page callback'    => 'myapi_auth_logout_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/auth.resource.inc',
  ];

  $items['api/v1/auth/password/forgot'] = [
    'page callback'    => 'myapi_auth_password_forgot_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/auth.resource.inc',
  ];

  $items['api/v1/auth/password/reset'] = [
    'page callback'    => 'myapi_auth_password_reset_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/auth.resource.inc',
  ];

  $items['password/reset'] = [
    'page callback'    => 'myapi_auth_password_reset_page',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/auth.resource.inc',
  ];

  $items['api/v1/units'] = [
    'page callback'    => 'myapi_unit_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/unit.resource.inc',
  ];

  $items['api/v1/units/%/receipts'] = [
    'page callback'    => 'myapi_receipt_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/receipt.resource.inc',
  ];

  $items['api/v1/units/%/extra-fees'] = [
    'page callback'    => 'myapi_extra_fee_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/extra_fee.resource.inc',
  ];

  $items['api/v1/units/%/payments'] = [
    'page callback'    => 'myapi_payment_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment.resource.inc',
  ];

  $items['api/v1/units/%/reservations'] = [
    'page callback'    => 'myapi_reservation_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/reservations'] = [
    'page callback'    => 'myapi_reservation_create_dispatch',
    'page arguments'   => [],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/reservations/%/cancel'] = [
    'page callback'    => 'myapi_reservation_cancel_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/reservations/%/details'] = [
    'page callback'    => 'myapi_reservation_details_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/payments'] = [
    'page callback'    => 'myapi_payment_create_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment.resource.inc',
  ];

  $items['api/v1/payments/%/cancel'] = [
    'page callback'    => 'myapi_payment_cancel_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment.resource.inc',
  ];

  $items['api/v1/payments/%'] = [
    'page callback'    => 'myapi_payment_detail_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment.resource.inc',
  ];

  $items['api/v1/condominiums/%/expenses'] = [
    'page callback'    => 'myapi_expense_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/expense.resource.inc',
  ];

  $items['api/v1/condominiums/%/summary'] = [
    'page callback'    => 'myapi_condominium_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/condominium.resource.inc',
  ];

  $items['api/v1/condominiums/%/areas'] = [
    'page callback'    => 'myapi_area_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/area.resource.inc',
  ];

  $items['api/v1/areas/%'] = [
    'page callback'    => 'myapi_area_details_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/area.resource.inc',
  ];

  $items['api/v1/areas/%/availability'] = [
    'page callback'    => 'myapi_area_availability_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/area.resource.inc',
  ];

  $items['api/v1/banks'] = [
    'page callback'    => 'myapi_bank_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/bank.resource.inc',
  ];

  $items['api/v1/payment-methods'] = [
    'page callback'    => 'myapi_payment_method_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment_method.resource.inc',
  ];

  $items['api/v1/service-categories'] = [
    'page callback'    => 'myapi_service_category_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_category.resource.inc',
  ];

  $items['api/v1/notifications'] = [
    'page callback'    => 'myapi_notification_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/notification.resource.inc',
  ];

  // The exact 'read-all' path must be registered alongside the '%' wildcard;
  // Drupal's router prefers the literal path, so both can coexist.
  $items['api/v1/notifications/read-all'] = [
    'page callback'    => 'myapi_notification_read_all_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/notification.resource.inc',
  ];

  $items['api/v1/notifications/%'] = [
    'page callback'    => 'myapi_notification_read_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/notification.resource.inc',
  ];

  $items['api/v1/bulletins'] = [
    'page callback'    => 'myapi_bulletin_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/bulletin.resource.inc',
  ];

  // Claims, read-only (SPEC 64). Both routes share one dispatcher: the item
  // path passes the nid as its only page argument and the collection passes
  // nothing, which is what myapi_claim_dispatch() routes on. Same shape as
  // api/v1/payments and api/v1/payments/%.
  $items['api/v1/claims'] = [
    'page callback'    => 'myapi_claim_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  $items['api/v1/claims/%'] = [
    'page callback'    => 'myapi_claim_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  // Closing of a claim by its requester (SPEC 70). Its own route and its own
  // dispatcher, not a branch of myapi_claim_dispatch(): a state transition is
  // not an edition of the resource, and the module already spells this shape
  // twice — api/v1/reservations/%/cancel and api/v1/payments/%/cancel.
  $items['api/v1/claims/%/close'] = [
    'page callback'    => 'myapi_claim_close_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  // Authenticated download of a claim file (SPEC 65). Its own dispatcher and
  // not a third case of myapi_claim_dispatch(): see myapi_claim_file_dispatch().
  // The two wildcards are the CLAIM's nid and the fid — arguments 3 and 5 —
  // and the nid is always the claim's, also for the files of a transaction.
  //
  // 'access callback' TRUE like every other api/v1 route: the token is
  // resolved inside the callback so the response is this module's JSON
  // envelope and not Drupal's 403 page.
  $items['api/v1/claims/%/files/%'] = [
    'page callback'    => 'myapi_claim_file_dispatch',
    'page arguments'   => [3, 5],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  // The marketplace listing (SPEC 83): the active providers of the site, with
  // their categories, rating, short description and hourly rate. Read-only and
  // authenticated like every other api/v1 route; a provider is loaded and
  // suspended from the back office.
  //
  // The collection root of the namespace SPEC 82 reserved below.
  $items['api/v1/providers'] = [
    'page callback'    => 'myapi_provider_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/provider.resource.inc',
  ];

  // The account's OWN providers (SPEC 97): the provider nodes linked to the
  // token's user through field_provider_users, active or not. The first api/v1
  // route of the module authorised by the 'proveedor' role — anybody else gets
  // a 403, administrators included.
  //
  // A LITERAL path living beside the wildcard below, and it does not compete
  // with it: Drupal 7 resolves the literal part of a pattern before falling
  // back to '%', so 'api/v1/providers/mine' never reaches
  // myapi_provider_detail_dispatch() and no nid is swallowed by this route.
  // Written BEFORE the wildcard for the same readability reason as the gallery
  // comment further down.
  $items['api/v1/providers/mine'] = [
    'page callback'    => 'myapi_provider_mine_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/provider.resource.inc',
  ];

  // One provider's detail (SPEC 84): the phone, the address, the long
  // description, the tags, the full gallery and the last three ratings, on
  // top of the seven fields the listing above already answers. Read-only and
  // authenticated, and existing but unpublished is the same 404 the gallery
  // below already gives.
  //
  // Sibling route of the collection above and NOT displaced by it, same as
  // the gallery routes below: Drupal matches by the number of path components
  // first, so 'api/v1/providers' and 'api/v1/providers/%' never compete for
  // the same request.
  $items['api/v1/providers/%'] = [
    'page callback'    => 'myapi_provider_detail_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/provider.resource.inc',
  ];

  // The private gallery of a provider (SPEC 82), the same pair of routes the
  // claim files got in SPEC 65: one lists the images, the other serves the
  // bytes of one of them, and both need a Bearer token.
  //
  // Sibling routes of the collection above and NOT displaced by it: Drupal
  // matches by the number of path components first, so 'api/v1/providers' and
  // 'api/v1/providers/%/gallery' never compete for the same request.
  $items['api/v1/providers/%/gallery'] = [
    'page callback'    => 'myapi_provider_gallery_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/provider.resource.inc',
  ];

  $items['api/v1/providers/%/gallery/%'] = [
    'page callback'    => 'myapi_provider_gallery_file_dispatch',
    'page arguments'   => [3, 5],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/provider.resource.inc',
  ];

  // The resident's own service requests (SPEC 88): the first route of the
  // 'service_request' bundle, whose schema SPEC 77, 86 and 87 built without one.
  // Read-only and authenticated; the scope is field_requester = uid and NOT the
  // reader's roles, so a resident who also holds 'proveedor' reads here what
  // they created as a resident. Every write answers 405.
  //
  // Plural and in English, like the fifteen routes before it — the singular
  // 'api/v1/services-request' would be the one path the app has to remember as
  // a special case.
  $items['api/v1/service-requests'] = [
    'page callback'    => 'myapi_service_request_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  // The provider's own board (SPEC 98): the requests that concern one of the
  // token's providers — the ones they already offered on, the unassigned ones
  // of their categories, and the ones awarded to them in ANY status. The
  // 'proveedor' role is the gate, the same 403 'provider_role_required' as
  // api/v1/providers/mine above; anybody else is refused, administrators
  // included. Read-only: every write answers 405, and offering is another spec.
  //
  // A LITERAL path living beside the wildcard below, and written BEFORE it for
  // exactly the reason api/v1/providers/mine is written before
  // api/v1/providers/%: Drupal 7 resolves the literal part of a pattern before
  // falling back to '%', so this route never reaches
  // myapi_service_request_item_dispatch() and no nid is swallowed by it. The
  // ordering here is readability, not routing — the core behaviour is what the
  // two rely on, and api/v1/providers/mine has relied on it since SPEC 97.
  $items['api/v1/service-requests/provider'] = [
    'page callback'    => 'myapi_service_request_provider_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  // The provider's detail of one request (SPEC 99), the item of the board
  // above. Its own gate — 403 'provider_role_required' without the role — its
  // own key `my_offers` instead of the general detail's trimmed `offers`, and
  // the `unit` of decision 5, visible only once the job is already the
  // reader's. Read-only, like the listing: every write answers 405.
  //
  // FIVE COMPONENTS, and it competes with nothing. Drupal 7 matches by the
  // number of path components first, which alone separates this route from
  // three of the four already here: 'api/v1/service-requests/provider' (four)
  // still resolves the listing, 'api/v1/service-requests/%' (four) still
  // resolves the general detail, and '%/files/%' has six.
  //
  // The one route with the same count is 'api/v1/service-requests/%/cancel',
  // and the two are told apart by WHERE the literal sits: 'provider' in
  // position 3 with the wildcard in 4, against a wildcard in 3 with 'cancel'
  // in 4. '/service-requests/provider/7' cannot match the second — part 4 is
  // '7' and not 'cancel' — and '/service-requests/7/cancel' cannot match this
  // one, because part 3 is '7' and not 'provider'. Different masks, disjoint
  // by construction.
  //
  // 'page arguments' => [4] and NOT [3]: the wildcard is the FIFTH component
  // — api / v1 / service-requests / provider / % — and [3] would hand the
  // dispatcher the literal 'provider'.
  //
  // No sibling files route: images and attachment keep pointing at
  // api/v1/service-requests/%/files/%, which authorises with the very same
  // myapi_service_request_viewer() this detail does (decision 10). Two routes,
  // one rule, no possible divergence.
  $items['api/v1/service-requests/provider/%'] = [
    'page callback'    => 'myapi_service_request_provider_item_dispatch',
    'page arguments'   => [4],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  // The detail of one request and the bytes of its private files (SPEC 89).
  //
  // Siblings of the collection above and NOT displaced by it: Drupal 7 matches
  // by the number of path components first, so the three routes never compete
  // for the same request — the same reasoning the provider gallery routes carry.
  //
  // 'access callback' => TRUE on both, like every other api/v1 route of this
  // module: Drupal's access layer is not the one deciding here. The token is
  // checked inside the dispatcher, and WHO may read this particular request is
  // myapi_service_request_viewer(), the single function both callbacks call.
  //
  // The second route is not optional decoration: field_images and
  // field_attachment are private:// at the field level since SPEC 77, so
  // without it the detail would answer filenames the app cannot open. Same pair
  // of routes SPEC 65 gave claims and SPEC 82 gave provider galleries.
  $items['api/v1/service-requests/%'] = [
    'page callback'    => 'myapi_service_request_item_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  $items['api/v1/service-requests/%/files/%'] = [
    'page callback'    => 'myapi_service_request_file_dispatch',
    'page arguments'   => [3, 5],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  // Cancellation of a request by its requester (SPEC 95). Its own route and its
  // own single-method dispatcher, not a PUT branch of
  // myapi_service_request_item_dispatch(): a state transition is not an edition
  // of the resource, and the module already spells this shape three times —
  // api/v1/reservations/%/cancel, api/v1/payments/%/cancel and
  // api/v1/claims/%/close.
  $items['api/v1/service-requests/%/cancel'] = [
    'page callback'    => 'myapi_service_request_cancel_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  // The requester closes their own request and rates the provider that did the
  // job (SPEC 108). FIVE COMPONENTS, like 'api/v1/service-requests/%/cancel'
  // just above and 'api/v1/service-requests/%/offers' just below, and the three
  // are told apart by the literal in the fifth position — Drupal 7 compares the
  // number of components first, which already separates all three from the
  // four-part routes and from the six-part file one, and 'close' cannot be
  // confused with 'cancel' or with 'offers'.
  //
  // Its own single-method dispatcher and not a branch of
  // myapi_service_request_item_dispatch(), the same shape and the same argument
  // as the cancellation: a state transition is not an edition of the resource.
  // It is the SECOND '/close' of the module, after api/v1/claims/%/close, which
  // SPEC 70 gave to the very same actor for the very same verb.
  $items['api/v1/service-requests/%/close'] = [
    'page callback'    => 'myapi_service_request_close_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_request.resource.inc',
  ];

  // A provider bids on a request (SPEC 100). FIVE COMPONENTS, exactly like
  // 'api/v1/service-requests/%/cancel' above, and the two are told apart by the
  // literal in the fifth position — Drupal 7 compares the number of components
  // first, which already separates this from the four-part routes and from the
  // six-part file one, and 'offers' cannot be confused with 'cancel'. Same
  // reasoning SPEC 99 wrote down for its own route.
  //
  // Its callback lives in a resource of its own because the offer IS a resource
  // of its own (Rules 2 and 5 of CLAUDE.md), even though the path hangs off the
  // request: an offer does not exist outside its request, and the nid in the
  // route is what makes a contradicting request_id in the body impossible.
  $items['api/v1/service-requests/%/offers'] = [
    'page callback'    => 'myapi_service_offer_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_offer.resource.inc',
  ];

  // The provider's own archive of quotes (SPEC 102): "what have I quoted?",
  // across every request, for ONE of the token's providers — '?provider_id' is
  // mandatory here, unlike in the board above. Same gate and same 403
  // 'provider_role_required' as the two provider routes before it; read-only,
  // so every write answers 405 before the token.
  //
  // THE FIRST ROUTE OF THE 'service-offers' PREFIX, and it does not compete
  // with 'api/v1/service-requests/%/offers' above: that one has FIVE
  // components and this one FOUR, and Drupal 7 compares the number of
  // components before anything else. The third component differs too.
  //
  // A LITERAL FOURTH COMPONENT, chosen so the prefix stays open. The day
  // 'api/v1/service-offers/%' arrives for the detail of one offer, Drupal 7
  // resolves the literal before falling back to '%' — the same core behaviour
  // api/v1/providers/mine has relied on since SPEC 97 and SPEC 98 wrote down
  // for api/v1/service-requests/provider. Nothing about this route will have
  // to change that day.
  //
  // Its callback is the SECOND dispatcher of resources/service_offer.resource.inc,
  // and that is Rule 2 rather than an exception to it: the offer is one
  // resource whether it is written or read, and a second file would be two
  // files sharing myapi_service_offer_build().
  $items['api/v1/service-offers/provider'] = [
    'page callback'    => 'myapi_service_offer_provider_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_offer.resource.inc',
  ];

  // The detail of ONE offer, to the provider who sent it (SPEC 103). It closes
  // what the listing above left open by design: those items are referential —
  // eight keys — and until today a row of that listing could not be opened
  // without downloading the whole detail of its request.
  //
  // FIVE COMPONENTS, so it competes with nothing already here: the listing
  // above has four and 'api/v1/service-requests/%/offers' has five but a
  // different third component. Against the wildcard route below — which has
  // four — Drupal 7 separates them by count before anything else.
  //
  // 'page arguments' => [4] and NOT [3]: the wildcard is the FIFTH component
  // — api / v1 / service-offers / provider / % — and [3] would hand the
  // dispatcher the literal 'provider'. Same trap, same answer, as
  // 'api/v1/service-requests/provider/%' above.
  $items['api/v1/service-offers/provider/%'] = [
    'page callback'    => 'myapi_service_offer_provider_item_dispatch',
    'page arguments'   => [4],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_offer.resource.inc',
  ];

  // The detail of ONE offer, to the resident who received it (SPEC 103). No
  // role is demanded on this one: there is no 'residente' role in this module,
  // and what grants access is a fact about the data — being the requester of
  // the request the offer hangs on — resolved by
  // myapi_service_request_viewer(), the same function the request's own detail
  // calls (decisions 10 and 13).
  //
  // THE WILDCARD ROUTE OF THE PREFIX, AND IT IS THE LAST ONE ON PURPOSE. It
  // has four components, exactly like 'api/v1/service-offers/provider' above,
  // and the two are told apart by the LITERAL: Drupal 7 resolves a literal
  // component before falling back to '%', which is the core behaviour SPEC 102
  // wrote down when it chose a literal fourth component precisely so this day
  // would cost nothing. So '/service-offers/provider' still answers the
  // listing, '/service-offers/provider/41' answers the route above, and
  // '/service-offers/901' answers this one.
  //
  // The three of them are read-only and answer 405 before the token to every
  // other method.
  $items['api/v1/service-offers/%'] = [
    'page callback'    => 'myapi_service_offer_item_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_offer.resource.inc',
  ];

  // Withdrawing an offer (SPEC 105): the provider takes back a quote that is
  // still 'sent'. A PUT and not a DELETE, because NOTHING DISAPPEARS — the
  // offer stays published, travels whole in both details, shows up in the
  // archive above and STILL COUNTS in offers_count, which is SPEC 88's explicit
  // decision: "how many offers did I receive" includes the ones that were taken
  // back. A DELETE would promise a disappearance that does not happen
  // (decision 5), and it is the same shape SPECS 23, 36 and 95 already use for
  // "move a resource out of its normal cycle".
  //
  // FIVE COMPONENTS, so it competes with nothing: the wildcard route above has
  // four, and 'api/v1/service-offers/provider/%' has five but a LITERAL third
  // component, which Drupal 7 always prefers over the '%' this one carries
  // there. SPEC 106 added a SECOND five-component route to this prefix,
  // 'api/v1/service-offers/%/accept', and it does not compete with this one
  // either: the two differ in their FIFTH component, which is a literal on
  // both sides, so '/service-offers/901/withdraw' and '/service-offers/901/accept'
  // resolve to different callbacks with nothing to disambiguate.
  //
  // 'page arguments' => [3]: the wildcard is the FOURTH component —
  // api / v1 / service-offers / % / withdraw — and the literal is the fifth.
  // The opposite trap to the provider route above, and the same answer: count
  // the components and hand over the one that is the id.
  $items['api/v1/service-offers/%/withdraw'] = [
    'page callback'    => 'myapi_service_offer_withdraw_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_offer.resource.inc',
  ];

  // Awarding an offer (SPEC 106): the resident picks one of the offers on their
  // own request. A PUT on the OFFER and not a POST on the request, because
  // nothing is born — so no 201 — and the object whose state changes by the
  // resident's decision IS the offer; the request turning 'assigned' is the
  // consequence, not the action (decision 1). The URL identifies the offer on
  // its own, so the body goes empty and the case "the offer you sent is not of
  // this request" cannot exist.
  //
  // It executes an arc the module has had declared since SPEC 77 and nobody
  // walked: 'selected' in the offer status catalogue, 'assigned' in the
  // request's, the 'offered' -> 'assigned' edge in
  // myapi_services_request_transitions(), and field_assigned_offer and
  // field_assigned_provider installed and never written.
  //
  // FIVE COMPONENTS, and it competes with neither of the other two: '901' sits
  // in [3], so it can never be the 'provider' route — that one carries a
  // literal there — and 'accept' sits in [4], so it can never be the withdrawal.
  // Drupal 7 resolves the three literals with nothing left ambiguous.
  //
  // 'page arguments' => [3]: same count as the withdrawal above — the wildcard
  // is the FOURTH component and the literal is the fifth.
  $items['api/v1/service-offers/%/accept'] = [
    'page callback'    => 'myapi_service_offer_accept_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/service_offer.resource.inc',
  ];

  // The chat credential (SPEC 115): the app trades this API's Bearer for a
  // Firebase custom token whose custom claims declare which chat threads the
  // account takes part in, so the Realtime Database rules can authorise the
  // conversation between a resident and their awarded provider without Firebase
  // ever asking Drupal. No message travels through this module, today or ever.
  //
  // 'chat/token' AND NOT 'firebase/token' (SPEC 115, decision 1).
  // myapi.install already wrote down that the transport "may not end up being
  // Firebase at all". The URL names what the app needs; who signs it is a detail
  // of the server, and the day the transport changes it is the BODY of the
  // response that changes — not a URL already-published versions of the app
  // depend on.
  //
  // THREE LITERAL COMPONENTS, no wildcard and therefore no 'page arguments'.
  // It opens the 'chat' prefix, which nothing else uses, so it competes with no
  // existing route: Drupal 7 never even reaches the count-the-components
  // question that the 'service-offers' family needed spelled out above.
  //
  // 'access callback' => TRUE like every api/v1 route of this module:
  // authentication is the resource's job — it answers the envelope with 401,
  // and Drupal's own 403 page would break the contract.
  $items['api/v1/chat/token'] = [
    'page callback'    => 'myapi_chat_token_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/chat.resource.inc',
  ];

  // Back-office reservation calendar (SPEC 47). The only route of this module
  // that is not an api/v1 endpoint: it renders HTML for an operator, not the
  // JSON envelope for the app, which is why its callback lives in includes/
  // and not in resources/. MENU_NORMAL_ITEM so it shows up under Contenido in
  // the administration menu; a local task would need a parent route that does
  // not exist today.
  $items['admin/content/reservation-calendar'] = [
    'title'            => 'Calendario de reservas',
    'page callback'    => 'myapi_reservation_calendar_page',
    'access callback'  => 'myapi_calendar_access',
    'type'             => MENU_NORMAL_ITEM,
    'file'             => 'includes/myapi.reservation_calendar.inc',
  ];

  // Back-office claims listing (SPEC 56). Same non-api/v1 pattern as
  // admin/content/reservation-calendar just above: HTML for an operator, not
  // the JSON envelope, so its callback lives in includes/ and not resources/.
  // MENU_NORMAL_ITEM so it shows up under Contenido in the administration
  // menu, next to the calendar.
  $items['admin/content/claims'] = [
    'title'            => 'Reclamos',
    'page callback'    => 'myapi_claims_list_page',
    'access callback'  => 'myapi_claims_admin_access',
    'type'             => MENU_NORMAL_ITEM,
    'file'             => 'includes/myapi.claims_admin.inc',
  ];

  // Claim transaction creation page (SPEC 57). Same non-api/v1 pattern as
  // admin/content/claims just above: HTML for an operator, not the JSON
  // envelope. MENU_CALLBACK (not a menu-visible item) since it is only ever
  // reached from the 'Crear transacción' link of node/%nid/edit of a
  // 'reclamo', never navigated to directly.
  $items['node/%node/claim-transaction/add'] = [
    'title'            => 'Crear transacción',
    'page callback'    => 'myapi_claim_transaction_add_page_callback',
    'page arguments'   => [1],
    'access callback'  => 'myapi_claim_transaction_add_access',
    'access arguments' => [1],
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/myapi.claim_transaction_admin.inc',
  ];

  // Service transaction creation page (SPEC 94). Same shape and same reasons
  // as the claims route just above: HTML for an operator, not the JSON
  // envelope, and MENU_CALLBACK because it is only ever reached from the
  // 'Crear transacción' link of the timeline fieldset on node/%nid/edit of a
  // 'service_request'.
  $items['node/%node/service-transaction/add'] = [
    'title'            => 'Crear transacción',
    'page callback'    => 'myapi_service_transaction_add_page_callback',
    'page arguments'   => [1],
    'access callback'  => 'myapi_service_transaction_add_access',
    'access arguments' => [1],
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/myapi.service_transaction_admin.inc',
  ];

  // Service transaction deletion confirmation (SPEC 94). The first node
  // deletion this module offers, and it gets a route of its own rather than
  // core's node/%node/delete because that one leaves the operator on the front
  // page instead of back on the request. Two %node wildcards: the request the
  // operator came from and the transaction to delete — the access callback
  // checks the second really belongs to the first.
  $items['node/%node/service-transaction/%node/delete'] = [
    'title'            => 'Borrar transacción',
    'page callback'    => 'myapi_service_transaction_delete_page_callback',
    'page arguments'   => [1, 3],
    'access callback'  => 'myapi_service_transaction_delete_access',
    'access arguments' => [1, 3],
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/myapi.service_transaction_admin.inc',
  ];

  return $items;
}

/**
 * Implements hook_menu_alter().
 *
 * The direct-URL half of the people filter of SPEC 51: /user/N of a resident of
 * another condominium answers 403 to a building admin. The listing half is
 * myapi_query_user_access_alter().
 *
 * It swaps the access callback of the two profile routes and gives BOTH the
 * 'access arguments' of 'user/%user' — array(1), the loaded account — so the
 * replacement receives the same argument core's user_view_access() did. That
 * replacement calls the original FIRST and only narrows afterwards: it can take
 * access away, never hand it out.
 *
 * Writing the arguments explicitly is not decoration, it is the fix to a
 * crash. 'user/%user/view' is a MENU_DEFAULT_LOCAL_TASK: core declares neither
 * an access callback nor access arguments for it and _menu_router_build()
 * copies both from the parent — but only for an item that has NO access
 * callback yet. This hook runs BEFORE that build, so setting just the callback
 * cancelled the inheritance and left the item with no arguments at all;
 * _menu_check_access() then called the callback with zero arguments and every
 * page rendering the "Mi cuenta" link died with an ArgumentCountError. Setting
 * both keys makes the item self-sufficient and independent of that inheritance.
 *
 * The arguments are copied from 'user/%user' rather than written as array(1),
 * so that if core ever changes them the two stay in step.
 *
 * 'user/%user/edit' is deliberately NOT touched. Without 'administer users',
 * user_edit_access() already refuses somebody else's account, and the operator
 * keeps their own.
 *
 * This hook only runs on a menu rebuild; its result is cached in the
 * menu_router table. That is why 'drush cc all' is not optional when deploying
 * SPEC 51 — see docs/building-admin-role.md.
 *
 * @param array $items
 *   The whole menu router, by reference.
 */
function myapi_menu_alter(&$items) {
  if (!isset($items['user/%user'])) {
    return;
  }

  $arguments = isset($items['user/%user']['access arguments'])
    ? $items['user/%user']['access arguments']
    : [1];

  foreach (['user/%user', 'user/%user/view'] as $path) {
    if (isset($items[$path])) {
      $items[$path]['access callback']  = 'myapi_building_admin_user_view_access';
      $items[$path]['access arguments'] = $arguments;
    }
  }
}

/**
 * Implements hook_permission().
 *
 * Declares the calendar capability so it is visible at
 * admin/people/permissions under "My API", where an administrator looks for
 * it.
 *
 * Careful: myapi_calendar_access() does NOT check this permission. Granting it
 * to a role does not open the calendar to that role — access is by role name
 * only. See the docblock of myapi_calendar_access() and
 * docs/reservation-calendar.md for why.
 */
function myapi_permission() {
  return [
    'view reservation calendar' => [
      'title'       => t('Ver el calendario de reservas'),
      'description' => t('Capacidad declarada para que sea visible aquí. El acceso a admin/content/reservation-calendar se decide por rol (administrator, backend), no por este permiso.'),
    ],
  ];
}

/**
 * The roles allowed into the back-office reservation calendar (SPEC 47).
 *
 * Single source of truth for that list: myapi_calendar_access() is its only
 * caller, and adding a fourth role means editing this one line. Names, never
 * rids: a rid is assigned per environment, so the 4 of production may well be
 * a different role on the client's site or in local.
 *
 * 'administrador edificio' joined in SPEC 49, and it is the only one of the
 * three that does not see the whole site: the calendar page narrows its
 * condominium select and its reservation query to the condominiums assigned to
 * the user. Getting in is one thing, what is shown once in is another.
 *
 * @return array  Role names.
 */
function myapi_calendar_admin_roles() {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  return ['administrator', 'backend', MYAPI_BUILDING_ADMIN_ROLE];
}

/**
 * Access callback of admin/content/reservation-calendar (SPEC 47).
 *
 * By ROLE only. The 'view reservation calendar' permission is declared in
 * myapi_permission() so the capability is discoverable, but it is deliberately
 * NOT consulted here: with an "either the permission or the role" rule,
 * granting the permission to "authenticated user" by mistake would open every
 * resident's reservations — names and emails included — to the whole site.
 * That this is counter-intuitive is accepted, and it is written down in the
 * hook_permission() description, in docs/reservation-calendar.md and in an
 * acceptance criterion of the spec.
 *
 * Returning FALSE makes Drupal answer 403, not a redirect to the login form
 * nor a blank page.
 *
 * uid 1 is let in explicitly: Drupal's superuser bypass lives inside
 * user_access(), which this callback never calls, so without this guard the
 * site owner could be locked out of their own calendar.
 *
 * $user->roles is rid => name in Drupal 7, so array_intersect() compares names
 * and no rid ever enters the logic.
 *
 * @return bool  TRUE when the current user may see the calendar.
 */
function myapi_calendar_access() {
  global $user;

  if ((int) $user->uid === 1) {
    return TRUE;
  }

  return (bool) array_intersect($user->roles, myapi_calendar_admin_roles());
}

/**
 * The roles allowed into the back-office claims listing (SPEC 56).
 *
 * Single source of truth for that list, same criterion as
 * myapi_calendar_admin_roles(): myapi_claims_admin_access() is its only
 * caller, and names are compared, never rids.
 *
 * 'administrador edificio' is here for the same reason it is in the
 * calendar's list: it is exactly the role that can already create and edit
 * claims (SPEC 49/55) but had nowhere to see them grouped together, nor
 * access to their transactions. Getting into the page is one thing, what is
 * shown once in is another — see myapi_claims_admin_access().
 *
 * @return array  Role names.
 */
function myapi_claims_admin_roles() {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  return ['administrator', 'backend', MYAPI_BUILDING_ADMIN_ROLE];
}

/**
 * Access callback of admin/content/claims (SPEC 56).
 *
 * By ROLE only, same criterion as myapi_calendar_access(). An 'administrador
 * edificio' with no condominium assigned still gets in: this callback only
 * asks "does the role apply", never "does this user have anything to see" —
 * that second question belongs to the query
 * (->addTag('node_access') on myapi_claims_list_rows()), which is what
 * decides an empty listing instead of a 403. Conflating the two would deny
 * access to an operator whose assignment is simply pending, which reads as a
 * broken account rather than an empty one.
 *
 * Returning FALSE makes Drupal answer 403, not a redirect nor a blank page.
 *
 * uid 1 is let in explicitly, same guard as myapi_calendar_access() and for
 * the same reason: the superuser bypass lives inside user_access(), which
 * this callback never calls.
 *
 * @return bool  TRUE when the current user may see the claims listing.
 */
function myapi_claims_admin_access() {
  global $user;

  if ((int) $user->uid === 1) {
    return TRUE;
  }

  return (bool) array_intersect($user->roles, myapi_claims_admin_roles());
}

/**
 * Access callback of node/%node/claim-transaction/add (SPEC 57).
 *
 * Unlike myapi_claims_admin_access() above, this is a per-NODE check, not a
 * per-role one: it defers entirely to node_access(), which already handles
 * the 'bypass node access' superuser shortcut and, for 'administrador
 * edificio', the condominium scoping of SPEC 49/56 via
 * myapi_node_access() (hook_node_access() in this same file). Nothing here
 * duplicates that logic.
 *
 * FALSE for any node that is not a 'reclamo': the route is
 * node/%node/claim-transaction/add for any node id, and this closes it for
 * every other content type.
 *
 * @param object $node
 *   The node loaded from the %node wildcard.
 *
 * @return bool  TRUE when the current user may open the creation page for
 *   this claim.
 */
function myapi_claim_transaction_add_access($node) {
  if (!is_object($node) || $node->type !== 'reclamo') {
    return FALSE;
  }

  return node_access('update', $node) && node_access('create', 'claim_transaction');
}

/**
 * Access callback of node/%node/service-transaction/add (SPEC 94).
 *
 * The exact same shape as myapi_claim_transaction_add_access() just above, and
 * for the same reasons: a per-NODE check that defers entirely to
 * node_access(), which already handles the 'bypass node access' superuser
 * shortcut and whatever hook_node_access() implementations are in play. No
 * permission is invented here and none is granted anywhere by SPEC 94 — the
 * operator is 'administrator' / 'backend' and nobody else.
 *
 * FALSE for any node that is not a 'service_request': the route is
 * node/%node/service-transaction/add for ANY node id, and this closes it for
 * every other content type.
 *
 * The include is loaded for its constants, the same way myapi_node_access()
 * does it: myapi.module never hardcodes a bundle name that
 * includes/myapi.services_common.inc already owns.
 *
 * @param object $node
 *   The node loaded from the %node wildcard.
 *
 * @return bool
 *   TRUE when the current user may open the creation page for this request.
 */
function myapi_service_transaction_add_access($node) {
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');

  if (!is_object($node) || empty($node->type) || $node->type !== MYAPI_SERVICES_REQUEST_TYPE) {
    return FALSE;
  }

  return node_access('update', $node) && node_access('create', MYAPI_SERVICES_TRANSACTION_TYPE);
}

/**
 * Access callback of node/%node/service-transaction/%node/delete (SPEC 94).
 *
 * Four conditions, and the third one is the whole point of this function
 * existing instead of reusing the one above:
 *
 *   1. the first node is a 'service_request';
 *   2. the second is a 'service_transaction';
 *   3. THAT TRANSACTION BELONGS TO THAT REQUEST. Without this line the route
 *      deletes any transaction on the site by hanging it off a request the
 *      current user happens to be able to edit;
 *   4. the user may update the request AND delete the transaction.
 *
 * node_access('delete', ...) is consulted PURE: SPEC 94 grants
 * 'delete any service_transaction content' to nobody, so whoever the site has
 * not given it to gets a 403 here and an empty cell in the timeline.
 *
 * The two includes are loaded for the same reason as in the callback above —
 * the bundle constants and the field reader belong to them, not to this file.
 *
 * @param object $request_node
 *   The node loaded from the first %node wildcard.
 * @param object $transaction_node
 *   The node loaded from the second one.
 *
 * @return bool
 *   TRUE when the current user may open the deletion confirmation.
 */
function myapi_service_transaction_delete_access($request_node, $transaction_node) {
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  if (!is_object($request_node) || empty($request_node->type) || $request_node->type !== MYAPI_SERVICES_REQUEST_TYPE) {
    return FALSE;
  }
  if (!is_object($transaction_node) || empty($transaction_node->type) || $transaction_node->type !== MYAPI_SERVICES_TRANSACTION_TYPE) {
    return FALSE;
  }
  if ((int) myapi_building_admin_field_target_id($transaction_node, 'field_request') !== (int) $request_node->nid) {
    return FALSE;
  }

  return node_access('update', $request_node) && node_access('delete', $transaction_node);
}

/**
 * Implements hook_mail().
 *
 * Glue only: loads the mail include and delegates the formatting. The
 * reservation keys are reached from the deferred mail queue during cron (see
 * includes/myapi.mail_queue.inc), the password reset one from the request that
 * asks for it.
 */
function myapi_mail($key, &$message, $params) {
  module_load_include('inc', 'myapi', 'includes/myapi.mail');

  switch ($key) {
    case 'password_reset':
      myapi_mail_format_password_reset($message, $params);
      break;

    // Both resident keys share a formatter: they differ only in the subject,
    // the context sentence and the closing line.
    case 'reservation_created_user':
    case 'reservation_cancelled_user':
      myapi_mail_format_reservation_user($message, $params, $key);
      break;

    // Both 'backend' keys share a formatter too: they differ only in the
    // subject, the heading and the two extra lines of the cancellation.
    case 'reservation_created_admin':
    case 'reservation_cancelled_admin':
      myapi_mail_format_reservation_admin($message, $params, $key);
      break;

    // SPEC 68. Five claim keys, four formatters: the two transaction ones
    // differ in their subject and their context sentence and in nothing else.
    // SPEC 70 added a sixth key with a formatter of its own, below.
    case 'claim_created_requester':
      myapi_mail_format_claim_created_user($message, $params);
      break;

    // Serves the two ways a claim reaches a neighbour — born public, or turned
    // public later — because from their side both facts are the same one.
    case 'claim_published_neighbour':
      myapi_mail_format_claim_published_neighbour($message, $params);
      break;

    case 'claim_transaction_requester':
    case 'claim_transaction_neighbour':
      myapi_mail_format_claim_transaction_user($message, $params, $key);
      break;

    // Only fires for a claim created from the app: an operator who files one
    // from the back office already knows it exists.
    case 'claim_created_admin':
      myapi_mail_format_claim_created_admin($message, $params);
      break;

    // SPEC 70. Only fires for PUT /api/v1/claims/%/close: the requester closed
    // their own claim from the app, which is the one status change the back
    // office does not make itself.
    case 'claim_closed_admin':
      myapi_mail_format_claim_closed_admin($message, $params);
      break;

    // SPEC 80. Only fires for POST /api/v1/payments: a payment registered from
    // the back office needs no email, the operator is already there.
    case 'payment_created_admin':
      myapi_mail_format_payment_admin($message, $params);
      break;

    // SPEC 109. Both fire for POST /api/v1/service-requests only: a request
    // typed into the back office notifies nobody, the operator is already
    // there. The provider key goes out once per account of each notified
    // provider; the admin key, once per active user of the 'backend' role.
    case 'service_request_provider':
      myapi_mail_format_service_request_provider($message, $params);
      break;

    case 'service_request_admin':
      myapi_mail_format_service_request_admin($message, $params);
      break;

    // SPEC 110. Fires for POST /api/v1/service-requests/{id}/offers only: an
    // offer created from the back office notifies nobody, same criterion as
    // the two cases above. Once per offer, to the resident who requested it.
    case 'service_request_offer_resident':
      myapi_mail_format_service_request_offer_resident($message, $params);
      break;

    // SPEC 111. Fires for PUT /api/v1/service-offers/{id}/withdraw only: a
    // withdrawal made from the back office notifies nobody, same criterion
    // as the three cases above. Once per withdrawal, to the resident who
    // requested the service.
    case 'service_request_offer_withdrawn_resident':
      myapi_mail_format_service_request_offer_withdrawn_resident($message, $params);
      break;

    // SPEC 112. Fire for PUT /api/v1/service-offers/{id}/accept only: an
    // award made from the back office notifies nobody, same criterion as the
    // four cases above. Once per award, to the winning provider, to each
    // losing provider, and to the 'backend' role.
    case 'service_request_offer_accepted_provider':
      myapi_mail_format_service_offer_accepted_provider($message, $params);
      break;

    case 'service_request_offer_rejected_provider':
      myapi_mail_format_service_offer_rejected_provider($message, $params);
      break;

    case 'service_request_awarded_admin':
      myapi_mail_format_service_request_awarded_admin($message, $params);
      break;

    // SPEC 113. Fire for PUT /api/v1/service-requests/{id}/cancel only: a
    // cancellation made from the back office notifies nobody, same criterion
    // as the five cases above. Once per cancellation, to each provider whose
    // offer was 'sent' or 'selected', and to the 'backend' role.
    case 'service_request_cancelled_provider':
      myapi_mail_format_service_request_cancelled_provider($message, $params);
      break;

    case 'service_request_cancelled_admin':
      myapi_mail_format_service_request_cancelled_admin($message, $params);
      break;

    // SPEC 114. Fire for PUT /api/v1/service-requests/{id}/close only: a
    // close made from the back office notifies nobody, same criterion as the
    // six cases above. The provider key goes out only when the close carried
    // a rating; the admin key, always, in either form of closing.
    case 'service_request_rated_provider':
      myapi_mail_format_service_request_rated_provider($message, $params);
      break;

    case 'service_request_closed_admin':
      myapi_mail_format_service_request_closed_admin($message, $params);
      break;
  }
}

/**
 * Implements hook_node_presave().
 *
 * Glue only. Independent branches, same shape as myapi_node_insert() below —
 * this function used to be a single 'pagos' branch with an early return, and
 * grew a second one in SPEC 60 without changing the first:
 * - 'pagos': delegates the payment verification workflow to
 *   includes/myapi.payment_workflow.inc. Its own return keeps the branch from
 *   recursing when the workflow re-saves the 'vivienda' and 'condominio' nodes.
 * - 'claim_transaction': delegates to myapi_claim_transaction_set_title()
 *   (includes/myapi.claim_transaction_admin.inc, SPEC 60), which composes the
 *   node title out of the claim, status, status date and comment. Presave and
 *   not insert/update: field_attach_presave() has already normalised the field
 *   values by now, and the row is not written yet, so no second save is needed.
 *   Covers every creation and edition path of a transaction at once — the
 *   module's own creation page, the automatic initial transaction, and both
 *   native node forms.
 * - 'service_transaction': delegates to myapi_service_transaction_set_title()
 *   (includes/myapi.service_transaction.inc, SPEC 92), the exact same job the
 *   branch above does for the other bundle, and for the same reasons. Written
 *   BEFORE the creator branch of myapi_node_insert() below, so no automatic
 *   transaction can ever be born titleless — not even in an intermediate
 *   commit. It reads the request, its status, the status date and the comment;
 *   it writes nothing but $node->title.
 * - 'service_rating' (SPEC 108): delegates to
 *   myapi_service_rating_set_title() (includes/myapi.service_rating.inc), the
 *   same job the two branches above do for the transaction bundles, and for
 *   the same two reasons. 'service_rating' was the last bundle of the services
 *   series with no title generator. It covers the close endpoint,
 *   node/add/service_rating and node/%nid/edit at once, so no rating can be
 *   born titleless. It reads the rated provider, the stars and node.created,
 *   loads the provider to resolve its name, and writes nothing but
 *   $node->title.
 */
function myapi_node_presave($node) {
  if ($node->type === 'pagos') {
    module_load_include('inc', 'myapi', 'includes/myapi.payment_workflow');
    if (myapi_payment_is_verification_transition($node)) {
      myapi_payment_apply_verification($node);
    }
    return;
  }
  if ($node->type === 'claim_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_set_title($node);
  }
  if ($node->type === 'service_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_transaction');
    myapi_service_transaction_set_title($node);
  }
  if ($node->type === 'service_rating') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_rating');
    myapi_service_rating_set_title($node);
  }
}

/**
 * Implements hook_node_insert().
 *
 * Glue only. Independent branches:
 * - 'pagos' created directly with field_estado_pago = "Completado": delegates
 *   to myapi_payment_notify_approved() in includes/myapi.payment_workflow.inc
 *   (the verification-transition case is already covered by
 *   myapi_node_presave() above; this branch only covers direct creation,
 *   where $node->nid did not exist yet in presave).
 * - 'reclamo': delegates to myapi_claim_transaction_create_initial() in
 *   includes/myapi.claim_transaction_admin.inc (SPEC 57), which creates the
 *   claim's automatic initial transaction. Runs for every 'reclamo' creation
 *   path, not only the admin form — see that function's docblock. Then, and
 *   only then, to myapi_claim_notify_created() (SPEC 68,
 *   includes/myapi.claim_notification.inc): after and not before, so the claim
 *   already has its initial transaction by the time it is announced, and a
 *   failure of the notifier can never keep that transaction from being created.
 *   The second argument is the transient origin flag, which is what tells the
 *   two creation paths apart — see myapi_claim_is_creation_from_api().
 * - 'service_request' (SPEC 92): delegates to
 *   myapi_service_transaction_create_initial()
 *   (includes/myapi.service_transaction.inc), which creates the request's
 *   automatic initial transaction — one 'service_transaction' copying the
 *   status the request was born with. The equivalent of the 'reclamo' branch
 *   above, and here for the same reason: the hook covers node/add/
 *   service_request, POST /api/v1/service-requests and any future path with a
 *   single implementation, which is why resources/service_request.resource.inc
 *   carries no line about transactions. No notifier follows it — the
 *   marketplace has none yet.
 * - 'service_transaction' (SPEC 94): delegates to
 *   myapi_service_transaction_sync_request_status()
 *   (includes/myapi.service_transaction_admin.inc), which rewrites the parent
 *   request's field_request_status when it differs from the transaction's own.
 *   The equivalent of the 'claim_transaction' branch below, added by SPEC 94
 *   after SPEC 92 had deliberately left it out — see that function's docblock
 *   for why the decision was reverted.
 *   It cannot cascade: the automatic initial transaction of the branch above
 *   is born with the request's OWN status, so the sync returns before saving
 *   anything, and creating a request still writes exactly two nodes. The
 *   re-save it does perform on a real status change is an UPDATE of a
 *   'service_request', which myapi_node_update() has no branch for. Whoever
 *   adds one must keep that property, or the cascade becomes infinite.
 * - 'service_rating' (SPEC 108): delegates to
 *   myapi_service_rating_sync_provider() (includes/myapi.service_rating.inc),
 *   which recalculates field_rating_avg and field_rating_count on the rated
 *   'provider' node. Hung off the hook and not off the close endpoint for the
 *   reason SPEC 92 and SPEC 94 already recorded: one implementation covers the
 *   app and node/add/service_rating at once, and hanging it off the endpoint
 *   would leave every rating an operator writes by hand uncounted — the very
 *   hole SPEC 108 exists to close. The provider nid is resolved here and passed
 *   in, the same shape the 'pagos' branch above reads a field to decide with.
 *   It cannot cascade: what the sync saves is a 'provider' node, and no branch
 *   of any node hook reacts to that bundle. Whoever adds one has to keep that
 *   property.
 * - 'claim_transaction': delegates to
 *   myapi_claim_transaction_sync_claim_status() (SPEC 57, same include),
 *   which syncs the parent claim's field_status when it differs. Covers
 *   node/add/claim_transaction (the native form, for 'administrator'/
 *   'backend') as well as myapi_claim_transaction_create_form() (SPEC 57's
 *   own creation page) — both end in node_save(), which is what fires this
 *   hook. Never finds a difference for
 *   the automatic initial transaction above, since it is born with the
 *   claim's own current status — no insert-triggers-update cascade.
 *   Then, again after the data and never before, to
 *   myapi_claim_notify_transaction() (SPEC 68) — but only when
 *   myapi_claim_transaction_is_notifiable() says so, which is what keeps the
 *   automatic initial transaction silent.
 * - Published 'boletin' node: delegates the notification fan-out + push
 *   enqueue to includes/myapi.notification.inc. A bulletin saved as a draft
 *   (status 0) does not notify anyone; editing or publishing it later does
 *   not fire either (only insert of a published node).
 */
function myapi_node_insert($node) {
  if ($node->type === 'pagos') {
    module_load_include('inc', 'myapi', 'includes/myapi.payment_workflow');
    if (myapi_payment_field_value($node, 'field_estado_pago') === MYAPI_PAYMENT_STATUS_COMPLETED) {
      myapi_payment_notify_approved($node);
    }
    return;
  }
  if ($node->type === 'reclamo') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_create_initial($node);
    module_load_include('inc', 'myapi', 'includes/myapi.claim_notification');
    myapi_claim_notify_created($node, myapi_claim_is_creation_from_api($node));
    return;
  }
  if ($node->type === 'service_request') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_transaction');
    myapi_service_transaction_create_initial($node);
    return;
  }
  if ($node->type === 'service_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_transaction_admin');
    myapi_service_transaction_sync_request_status($node);
    return;
  }
  if ($node->type === 'service_rating') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_rating');
    module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
    myapi_service_rating_sync_provider(myapi_building_admin_field_target_id($node, 'field_rating_provider'));
    return;
  }
  if ($node->type === 'claim_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_sync_claim_status($node);
    module_load_include('inc', 'myapi', 'includes/myapi.claim_notification');
    if (myapi_claim_transaction_is_notifiable($node)) {
      myapi_claim_notify_transaction($node);
    }
    return;
  }
  if ($node->type !== 'boletin' || $node->status != 1) {
    return;
  }
  module_load_include('inc', 'myapi', 'includes/myapi.notification');
  myapi_notification_create_from_boletin($node);
}

/**
 * Implements hook_node_update().
 *
 * Glue only. Two independent branches:
 * - 'pagos': delegates to myapi_payment_is_rule_completion() /
 *   myapi_payment_notify_approved() in includes/myapi.payment_workflow.inc.
 *   Covers the "Nuevo" -> "Completado" transition produced by the legacy Rule
 *   'rules_actualizar_saldo_pago' when it auto-saves a 'pagos' node created
 *   directly in "Nuevo" (the Rule already did the balance work; this hook only
 *   notifies). Also delegates to myapi_payment_is_cancellation_transition() /
 *   myapi_payment_notify_cancelled() for a back-office "* -> Anulado" update
 *   (the opt-out save from PUT /api/v1/payments/%/cancel never matches it).
 * - 'recibo' / 'alicuota_extra': delegates to myapi_fee_is_sent_transition() /
 *   myapi_fee_notify_issued() in includes/myapi.fee_notification.inc, notifying
 *   the unit occupants when the fee transitions to "Enviado" on edit.
 * - 'reservation': delegates to myapi_reservation_is_cancellation_transition() /
 *   myapi_reservation_notify_cancelled() in
 *   includes/myapi.reservation_notification.inc, notifying the resident when an
 *   operator cancels their reservation from the back office. The opt-out save
 *   from PUT /api/v1/reservations/%/cancel never matches it, so a resident
 *   cancelling from the app notifies nobody.
 * - 'claim_transaction': delegates to
 *   myapi_claim_transaction_sync_claim_status() (SPEC 57,
 *   includes/myapi.claim_transaction_admin.inc) — same function
 *   myapi_node_insert()'s 'claim_transaction' branch calls, so editing an
 *   existing transaction's field_status (node/%nid/edit, the native form)
 *   syncs the claim exactly like creating one does. It deliberately does NOT
 *   notify: SPEC 68 covers the creation of a transaction and not its edition.
 * - 'service_transaction' (SPEC 94): delegates to
 *   myapi_service_transaction_sync_request_status()
 *   (includes/myapi.service_transaction_admin.inc) — the same function
 *   myapi_node_insert()'s 'service_transaction' branch calls, so editing an
 *   existing transaction's field_request_status from the native
 *   node/%nid/edit syncs the request exactly like creating one does. There is
 *   no notifier to skip here: the marketplace has none yet.
 * - 'service_rating' (SPEC 108): delegates to
 *   myapi_service_rating_sync_provider() (includes/myapi.service_rating.inc) —
 *   the same function myapi_node_insert()'s 'service_rating' branch calls, so
 *   an operator who edits the stars of an existing rating from the native
 *   node/%nid/edit resynchronises the provider's two counters exactly like
 *   creating one does. No $exclude_nid here: the rating being edited is a row
 *   that stays, and it must go on counting.
 * - 'reclamo' (SPEC 68): delegates to myapi_claim_is_publication_transition() /
 *   myapi_claim_notify_published() in includes/myapi.claim_notification.inc,
 *   notifying the neighbours of the condominium — requester excluded — the one
 *   time a claim goes from private to public. Covers the two paths that produce
 *   that transition, POST /api/v1/claims/{id} and node/%nid/edit. Every other
 *   edition of a claim notifies nobody: the inverse transition, a new subject,
 *   a new description or a new file change nothing about who can see it.
 *   The type is compared against the literal, like the four branches above,
 *   and not against MYAPI_BUILDING_ADMIN_CLAIM_TYPE: that constant lives in an
 *   include this function has not loaded yet at that point.
 */
function myapi_node_update($node) {
  if ($node->type === 'pagos') {
    module_load_include('inc', 'myapi', 'includes/myapi.payment_workflow');
    if (myapi_payment_is_rule_completion($node)) {
      myapi_payment_notify_approved($node);
    }
    elseif (myapi_payment_is_cancellation_transition($node)) {
      myapi_payment_notify_cancelled($node);
    }
    return;
  }
  if ($node->type === 'recibo' || $node->type === 'alicuota_extra') {
    module_load_include('inc', 'myapi', 'includes/myapi.fee_notification');
    if (myapi_fee_is_sent_transition($node)) {
      myapi_fee_notify_issued($node);
    }
    return;
  }
  if ($node->type === 'reservation') {
    module_load_include('inc', 'myapi', 'includes/myapi.reservation_notification');
    if (myapi_reservation_is_cancellation_transition($node)) {
      myapi_reservation_notify_cancelled($node);
    }
    return;
  }
  if ($node->type === 'claim_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_sync_claim_status($node);
    return;
  }
  if ($node->type === 'service_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_transaction_admin');
    myapi_service_transaction_sync_request_status($node);
    return;
  }
  if ($node->type === 'service_rating') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_rating');
    module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
    myapi_service_rating_sync_provider(myapi_building_admin_field_target_id($node, 'field_rating_provider'));
    return;
  }
  if ($node->type === 'reclamo') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_notification');
    if (myapi_claim_is_publication_transition($node)) {
      myapi_claim_notify_published($node);
    }
    return;
  }
}

/**
 * Implements hook_node_delete().
 *
 * Glue only, and NEW IN SPEC 108 — this module had never implemented the hook.
 * One branch:
 * - 'service_rating': delegates to myapi_service_rating_sync_provider()
 *   (includes/myapi.service_rating.inc), the same function the 'service_rating'
 *   branches of myapi_node_insert() and myapi_node_update() call, so moderating
 *   a rating leaves the provider's two counters right.
 *
 * WHY DELETING IS NOT OPTIONAL HERE. SPEC 77 decided that moderating a rating
 * means DELETING the node and not unpublishing it, which is why neither
 * SPEC 84's two queries nor SPEC 108's aggregate carries an n.status filter.
 * With no branch here, every act of moderation would leave the reputation
 * stale — a count that still includes a rating nobody can read.
 *
 * THE SECOND ARGUMENT IS THE POINT. hook_node_delete() runs in Drupal 7 BEFORE
 * field_attach_delete() and before the {node} row goes away, so at this instant
 * the dying rating is still in every table the aggregate reads: recalculating
 * without excluding it would return exactly the numbers that stood before the
 * deletion. Drupal 7 offers no later hook to lean on, hence $node->nid travels
 * as $exclude_nid. The insert and update branches pass nothing, because there
 * the row stays and must go on counting.
 *
 * The type is compared against the literal, like every branch of the three
 * hooks above: this hook fires for EVERY bundle of the site, and the cost for
 * a node that is not a 'service_rating' is one string comparison.
 */
function myapi_node_delete($node) {
  if ($node->type === 'service_rating') {
    module_load_include('inc', 'myapi', 'includes/myapi.service_rating');
    module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
    myapi_service_rating_sync_provider(
      myapi_building_admin_field_target_id($node, 'field_rating_provider'),
      $node->nid
    );
    return;
  }
}

/**
 * Implements hook_node_access().
 *
 * The per-node half of TWO independent scope filters: SPEC 49's condominium
 * filter for the 'administrador edificio' role, and SPEC 78's belonging/
 * category filter for the 'proveedor' role. The other half of each is
 * myapi_query_node_access_alter(), which narrows the listings; this one
 * closes the direct URL.
 *
 * Each role's own decision function already returns only 'deny' or 'ignore',
 * never 'allow' — see myapi_building_admin_access_decision() and
 * myapi_provider_role_access_decision(). This hook consults BOTH and denies
 * if EITHER does: the conservative reading SPEC 78 calls for when an account
 * holds both roles at once — it gets exactly what either role alone would
 * deny it.
 *
 * It NEVER returns NODE_ACCESS_ALLOW, for the same reason neither role's own
 * decision does: allowing here would short-circuit every other check Drupal
 * makes — unpublished nodes, other modules' hooks — turning a scope filter
 * into a permission escalation. IGNORE means "I have nothing to say", which
 * is exactly the case for every node neither role denies.
 *
 * Two shapes of call are stepped around on the first lines:
 * - $op 'create' arrives with $node as a TYPE STRING, not an object. Creation
 *   is out of this hook's reach by design; the bulletin case (building-admin)
 *   is covered in myapi_node_validate(), and neither role is granted a
 *   'create' permission on the five marketplace bundles (SPEC 78), so the
 *   provider role has nothing to reach here in the first place.
 * - A user with 'bypass node access' (administrator) never reaches this hook
 *   at all: node_access() returns before invoking it. That is why an account
 *   holding any of these roles alongside 'administrator' keeps seeing
 *   everything.
 *
 * @param object|string $node
 *   The node being checked, or the type string on 'create'.
 * @param string $op
 *   'view', 'update', 'delete' or 'create'.
 * @param object $account
 *   The account the check is made for.
 *
 * @return int
 *   NODE_ACCESS_DENY or NODE_ACCESS_IGNORE.
 */
function myapi_node_access($node, $op, $account) {
  if (!is_object($node) || ($op !== 'view' && $op !== 'update' && $op !== 'delete')) {
    return NODE_ACCESS_IGNORE;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');
  module_load_include('inc', 'myapi', 'includes/myapi.provider_role');

  if (myapi_building_admin_is($account)) {
    $decision = myapi_building_admin_access_decision(
      myapi_building_admin_node_condominium($node),
      myapi_building_admin_condominium_ids($account)
    );

    if ($decision === 'deny') {
      return NODE_ACCESS_DENY;
    }
  }

  if (myapi_provider_role_is($account) && myapi_provider_role_node_decision($node, $account) === 'deny') {
    return NODE_ACCESS_DENY;
  }

  return NODE_ACCESS_IGNORE;
}

/**
 * Implements hook_query_TAG_alter() for the 'node_access' tag.
 *
 * The listing half of both scope filters; myapi_node_access() is the
 * per-node half of each. Glue only: everything either alter decides lives in
 * includes/myapi.building_admin.inc and includes/myapi.provider_role.inc,
 * next to the catalogues each reads.
 *
 * Each alter is a COMPLETE allowlist of its own domain of node types — a
 * building admin sees only its 7 recognized types in any node_access-tagged
 * listing, a provider only its 5 — so simply running both, unqualified, on
 * the same query would AND two disjoint allowlists together and empty every
 * such listing for an account holding both roles (SPEC 78's own
 * "Decisiones" investigation). Each call below is given the OTHER alter's
 * own domain as $exempt_types, which turns "complete allowlist" into "veto
 * within my domain, no-op for the other role's domain" — the two then
 * compose correctly under AND: an account with only one role gets exactly
 * that role's filter (the other call is a no-op for it, per its own guard
 * 1), and an account with both gets the union of what each would show alone,
 * each still narrowed by its own rule. A type NEITHER role recognizes stays
 * excluded from a building-admin or provider account's listings exactly as
 * a solo alter would have left it.
 *
 * Scope worth stating out loud, because it is wider than /admin/content: this
 * runs on EVERY query tagged 'node_access', which includes the
 * entityreference autocompletes of the node forms. That is deliberate for the
 * building-admin half — it is what keeps the condominium selectors offering
 * the assigned condominiums and only those — and is written down in
 * docs/building-admin-role.md. The provider role is granted no permission
 * that opens such a selector (SPEC 78), so this half has almost no surface to
 * exercise today; it is implemented anyway; see
 * myapi_provider_role_alter_node_query()'s own docblock.
 *
 * No query of this module carries that tag (checked across resources/ and
 * includes/), so the api/v1/... endpoints are untouched.
 */
function myapi_query_node_access_alter(QueryAlterableInterface $query) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
  module_load_include('inc', 'myapi', 'includes/myapi.provider_role');
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');

  myapi_building_admin_alter_node_query($query, myapi_services_node_types());
  myapi_provider_role_alter_node_query($query, myapi_building_admin_visible_types());
}

/**
 * Implements hook_query_TAG_alter() for the 'user_access' tag.
 *
 * The listing half of the SPEC 51 people filter, mirror of the node one above;
 * myapi_building_admin_user_view_access() is the direct-URL half. Glue only:
 * the two guards and the single condition live in
 * includes/myapi.building_admin_user.inc.
 *
 * Which queries carry this tag, and why both matter:
 * - the generic entityreference handler when target_type is 'user', which is
 *   what narrows the field_requester autocomplete of the reservation form to
 *   the residents of the assigned condominiums;
 * - the 'users' base table of Views, which declares it as an access query tag,
 *   so any back-office listing of people is scoped too — unless somebody ticks
 *   "Disable SQL rewriting" on the view, which is written down as a known risk.
 *
 * No query of this module carries that tag (checked across resources/ and
 * includes/), so the api/v1/... endpoints are untouched.
 */
function myapi_query_user_access_alter(QueryAlterableInterface $query) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin_user');
  myapi_building_admin_alter_user_query($query);
}

/**
 * Implements hook_file_download().
 *
 * The back office's half of SPEC 65: since the claim images and attachments
 * moved to private://, nothing serves them without an explicit decision, and
 * this is where the operator's decision is made. The app's half is
 * GET /api/v1/claims/%/files/% in resources/claim.resource.inc, which asks a
 * different question (a Bearer token and the visibility rule of SPEC 64) of
 * the same shared include.
 *
 * Since SPEC 89 this module owns THREE families of private files, so the hook
 * asks THREE owners in a chain: claims first, then providers — the
 * field_gallery of a 'provider', decided in includes/myapi.provider_files.inc —
 * and last the field_images and field_attachment of a 'service_request',
 * decided in includes/myapi.service_request_files.inc. Each one is asked only
 * when the previous did not recognise the URI.
 *
 * The order is most frequent first, and it is what keeps the hook cheap: it
 * fires for EVERY private file of the site, and an URI none of the three owns —
 * a payment receipt, an image-style derivative — costs one query per owner
 * before falling through to Drupal.
 *
 * The cut is `$headers !== NULL` and NOT a loose `if (!$headers)`, and that is
 * the whole delicacy of the chain: NULL means "not mine", but -1 means "mine,
 * and denied" — a decision already taken on a claim file. Falling through with
 * a -1 would hand that file to the next owner, who would answer NULL for it,
 * and a denial would quietly turn into somebody else's permission. A loose
 * comparison happens to work today because -1 is truthy, and stops working the
 * day anyone changes that value.
 *
 * Glue only, like the two hooks above: the three return values Drupal expects
 * — headers, -1, NULL — are decided in the three includes, next to the
 * ownership resolution the endpoints also call.
 *
 * NULL for anything this module does not recognise is deliberate: -1 is a hard
 * deny that cuts other modules off, so answering NULL keeps this module
 * opining about its own files only, and every other private file of the site —
 * payment receipts in private://comprobantes_pago included — behaves exactly as
 * it did before.
 *
 * @param string $uri
 *   The URI of the file being requested.
 *
 * @return array|int|NULL
 *   Headers when granted, -1 when denied, NULL when the file is not ours.
 */
function myapi_file_download($uri) {
  global $user;

  module_load_include('inc', 'myapi', 'includes/myapi.claims_files');

  $headers = myapi_claims_file_download_headers($uri, $user);

  // NULL means "not a claim file". Anything else — headers or -1 — is already
  // a decision taken about a claim file, and asking the second owner would turn
  // it into a permission granted through the back door.
  if ($headers !== NULL) {
    return $headers;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.provider_files');

  $headers = myapi_provider_file_download_headers($uri, $user);

  // Same cut, same reason: a -1 on a gallery file is a denial already taken,
  // not an invitation to ask the third owner.
  if ($headers !== NULL) {
    return $headers;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.service_request_files');

  return myapi_service_request_file_download_headers($uri, $user);
}

/**
 * Implements hook_field_access().
 *
 * Restricts field_condominio_admin — the user field that decides which
 * condominiums a building admin reaches — to the roles that may hand it out
 * (SPEC 49). Everybody else neither sees it on a profile nor gets it on the
 * user form.
 *
 * This is not cosmetic. Editing one's OWN account needs no permission in
 * Drupal, so without this hook a building admin could open /user/N/edit and
 * assign themselves every condominium on the site — the whole filter is only
 * as strong as who can write this field.
 *
 * Glue only, and it leaves every other field of every other entity alone: the
 * two guards on the first lines return TRUE ("no objection") before the
 * include is even loaded for anything that is not this exact field on a user.
 *
 * @param string $op
 *   'view' or 'edit'. Both are denied — a value that cannot be changed is
 *   still an assignment nobody outside those roles has business reading.
 *
 * @return bool
 *   FALSE denies the field; TRUE leaves the decision to Drupal.
 */
function myapi_field_access($op, $field, $entity_type, $entity, $account) {
  if ($entity_type !== 'user' || empty($field['field_name'])) {
    return TRUE;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  if ($field['field_name'] !== MYAPI_BUILDING_ADMIN_CONDO_FIELD) {
    return TRUE;
  }

  return myapi_building_admin_assignment_field_access($account);
}

/**
 * Implements hook_form_FORM_ID_alter() for the 'boletin' node form.
 *
 * Glue only. Hides the 'General' and 'Personalizado' scopes from a building
 * admin (SPEC 49), so the form offers only what the role may actually publish
 * instead of accepting a choice and rejecting it on submit.
 *
 * This does NOT replace myapi_building_admin_validate_bulletin(): shaping a
 * form is not enforcing a rule, and a hand-crafted POST never sees this
 * function. Both layers stay.
 *
 * Every other user reaches the untouched form — the role check is the first
 * line of the delegate.
 */
function myapi_form_boletin_node_form_alter(&$form, &$form_state, $form_id) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
  myapi_building_admin_restrict_bulletin_form($form, $form_state);
}

