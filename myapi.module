    'file'             => 'resources/area.resource.inc',
  ];

  $items['api/v1/banks'] = [
    'page callback'    => 'myapi_bank_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/bank.resource.inc',
  ];

  $items['api/v1/payment-methods'] = [
    'page callback'    => 'myapi_payment_method_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment_method.resource.inc',
  ];

  $items['api/v1/notifications'] = [
    'page callback'    => 'myapi_notification_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/notification.resource.inc',
  ];

  // The exact 'read-all' path must be registered alongside the '%' wildcard;
  // Drupal's router prefers the literal path, so both can coexist.
  $items['api/v1/notifications/read-all'] = [
    'page callback'    => 'myapi_notification_read_all_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/notification.resource.inc',
  ];

  $items['api/v1/notifications/%'] = [
    'page callback'    => 'myapi_notification_read_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/notification.resource.inc',
  ];

  $items['api/v1/bulletins'] = [
    'page callback'    => 'myapi_bulletin_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/bulletin.resource.inc',
  ];

  // Claims, read-only (SPEC 64). Both routes share one dispatcher: the item
  // path passes the nid as its only page argument and the collection passes
  // nothing, which is what myapi_claim_dispatch() routes on. Same shape as
  // api/v1/payments and api/v1/payments/%.
  $items['api/v1/claims'] = [
    'page callback'    => 'myapi_claim_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  $items['api/v1/claims/%'] = [
    'page callback'    => 'myapi_claim_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  // Authenticated download of a claim file (SPEC 65). Its own dispatcher and
  // not a third case of myapi_claim_dispatch(): see myapi_claim_file_dispatch().
  // The two wildcards are the CLAIM's nid and the fid — arguments 3 and 5 —
  // and the nid is always the claim's, also for the files of a transaction.
  //
  // 'access callback' TRUE like every other api/v1 route: the token is
  // resolved inside the callback so the response is this module's JSON
  // envelope and not Drupal's 403 page.
  $items['api/v1/claims/%/files/%'] = [
    'page callback'    => 'myapi_claim_file_dispatch',
    'page arguments'   => [3, 5],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/claim.resource.inc',
  ];

  // Back-office reservation calendar (SPEC 47). The only route of this module
  // that is not an api/v1 endpoint: it renders HTML for an operator, not the
  // JSON envelope for the app, which is why its callback lives in includes/
  // and not in resources/. MENU_NORMAL_ITEM so it shows up under Contenido in
  // the administration menu; a local task would need a parent route that does
  // not exist today.
  $items['admin/content/reservation-calendar'] = [
    'title'            => 'Calendario de reservas',
    'page callback'    => 'myapi_reservation_calendar_page',
    'access callback'  => 'myapi_calendar_access',
    'type'             => MENU_NORMAL_ITEM,
    'file'             => 'includes/myapi.reservation_calendar.inc',
  ];

  // Back-office claims listing (SPEC 56). Same non-api/v1 pattern as
  // admin/content/reservation-calendar just above: HTML for an operator, not
  // the JSON envelope, so its callback lives in includes/ and not resources/.
  // MENU_NORMAL_ITEM so it shows up under Contenido in the administration
  // menu, next to the calendar.
  $items['admin/content/claims'] = [
    'title'            => 'Reclamos',
    'page callback'    => 'myapi_claims_list_page',
    'access callback'  => 'myapi_claims_admin_access',
    'type'             => MENU_NORMAL_ITEM,
    'file'             => 'includes/myapi.claims_admin.inc',
  ];

  // Claim transaction creation page (SPEC 57). Same non-api/v1 pattern as
  // admin/content/claims just above: HTML for an operator, not the JSON
  // envelope. MENU_CALLBACK (not a menu-visible item) since it is only ever
  // reached from the 'Crear transacción' link of node/%nid/edit of a
  // 'reclamo', never navigated to directly.
  $items['node/%node/claim-transaction/add'] = [
    'title'            => 'Crear transacción',
    'page callback'    => 'myapi_claim_transaction_add_page_callback',
    'page arguments'   => [1],
    'access callback'  => 'myapi_claim_transaction_add_access',
    'access arguments' => [1],
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/myapi.claim_transaction_admin.inc',
  ];

  return $items;
}

/**
 * Implements hook_menu_alter().
 *
 * The direct-URL half of the people filter of SPEC 51: /user/N of a resident of
 * another condominium answers 403 to a building admin. The listing half is
 * myapi_query_user_access_alter().
 *
 * It swaps the access callback of the two profile routes and gives BOTH the
 * 'access arguments' of 'user/%user' — array(1), the loaded account — so the
 * replacement receives the same argument core's user_view_access() did. That
 * replacement calls the original FIRST and only narrows afterwards: it can take
 * access away, never hand it out.
 *
 * Writing the arguments explicitly is not decoration, it is the fix to a
 * crash. 'user/%user/view' is a MENU_DEFAULT_LOCAL_TASK: core declares neither
 * an access callback nor access arguments for it and _menu_router_build()
 * copies both from the parent — but only for an item that has NO access
 * callback yet. This hook runs BEFORE that build, so setting just the callback
 * cancelled the inheritance and left the item with no arguments at all;
 * _menu_check_access() then called the callback with zero arguments and every
 * page rendering the "Mi cuenta" link died with an ArgumentCountError. Setting
 * both keys makes the item self-sufficient and independent of that inheritance.
 *
 * The arguments are copied from 'user/%user' rather than written as array(1),
 * so that if core ever changes them the two stay in step.
 *
 * 'user/%user/edit' is deliberately NOT touched. Without 'administer users',
 * user_edit_access() already refuses somebody else's account, and the operator
 * keeps their own.
 *
 * This hook only runs on a menu rebuild; its result is cached in the
 * menu_router table. That is why 'drush cc all' is not optional when deploying
 * SPEC 51 — see docs/building-admin-role.md.
 *
 * @param array $items
 *   The whole menu router, by reference.
 */
function myapi_menu_alter(&$items) {
  if (!isset($items['user/%user'])) {
    return;
  }

  $arguments = isset($items['user/%user']['access arguments'])
    ? $items['user/%user']['access arguments']
    : [1];

  foreach (['user/%user', 'user/%user/view'] as $path) {
    if (isset($items[$path])) {
      $items[$path]['access callback']  = 'myapi_building_admin_user_view_access';
      $items[$path]['access arguments'] = $arguments;
    }
  }
}

/**
 * Implements hook_permission().
 *
 * Declares the calendar capability so it is visible at
 * admin/people/permissions under "My API", where an administrator looks for
 * it.
 *
 * Careful: myapi_calendar_access() does NOT check this permission. Granting it
 * to a role does not open the calendar to that role — access is by role name
 * only. See the docblock of myapi_calendar_access() and
 * docs/reservation-calendar.md for why.
 */
function myapi_permission() {
  return [
    'view reservation calendar' => [
      'title'       => t('Ver el calendario de reservas'),
      'description' => t('Capacidad declarada para que sea visible aquí. El acceso a admin/content/reservation-calendar se decide por rol (administrator, backend), no por este permiso.'),
    ],
  ];
}

/**
 * The roles allowed into the back-office reservation calendar (SPEC 47).
 *
 * Single source of truth for that list: myapi_calendar_access() is its only
 * caller, and adding a fourth role means editing this one line. Names, never
 * rids: a rid is assigned per environment, so the 4 of production may well be
 * a different role on the client's site or in local.
 *
 * 'administrador edificio' joined in SPEC 49, and it is the only one of the
 * three that does not see the whole site: the calendar page narrows its
 * condominium select and its reservation query to the condominiums assigned to
 * the user. Getting in is one thing, what is shown once in is another.
 *
 * @return array  Role names.
 */
function myapi_calendar_admin_roles() {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  return ['administrator', 'backend', MYAPI_BUILDING_ADMIN_ROLE];
}

/**
 * Access callback of admin/content/reservation-calendar (SPEC 47).
 *
 * By ROLE only. The 'view reservation calendar' permission is declared in
 * myapi_permission() so the capability is discoverable, but it is deliberately
 * NOT consulted here: with an "either the permission or the role" rule,
 * granting the permission to "authenticated user" by mistake would open every
 * resident's reservations — names and emails included — to the whole site.
 * That this is counter-intuitive is accepted, and it is written down in the
 * hook_permission() description, in docs/reservation-calendar.md and in an
 * acceptance criterion of the spec.
 *
 * Returning FALSE makes Drupal answer 403, not a redirect to the login form
 * nor a blank page.
 *
 * uid 1 is let in explicitly: Drupal's superuser bypass lives inside
 * user_access(), which this callback never calls, so without this guard the
 * site owner could be locked out of their own calendar.
 *
 * $user->roles is rid => name in Drupal 7, so array_intersect() compares names
 * and no rid ever enters the logic.
 *
 * @return bool  TRUE when the current user may see the calendar.
 */
function myapi_calendar_access() {
  global $user;

  if ((int) $user->uid === 1) {
    return TRUE;
  }

  return (bool) array_intersect($user->roles, myapi_calendar_admin_roles());
}

/**
 * The roles allowed into the back-office claims listing (SPEC 56).
 *
 * Single source of truth for that list, same criterion as
 * myapi_calendar_admin_roles(): myapi_claims_admin_access() is its only
 * caller, and names are compared, never rids.
 *
 * 'administrador edificio' is here for the same reason it is in the
 * calendar's list: it is exactly the role that can already create and edit
 * claims (SPEC 49/55) but had nowhere to see them grouped together, nor
 * access to their transactions. Getting into the page is one thing, what is
 * shown once in is another — see myapi_claims_admin_access().
 *
 * @return array  Role names.
 */
function myapi_claims_admin_roles() {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  return ['administrator', 'backend', MYAPI_BUILDING_ADMIN_ROLE];
}

/**
 * Access callback of admin/content/claims (SPEC 56).
 *
 * By ROLE only, same criterion as myapi_calendar_access(). An 'administrador
 * edificio' with no condominium assigned still gets in: this callback only
 * asks "does the role apply", never "does this user have anything to see" —
 * that second question belongs to the query
 * (->addTag('node_access') on myapi_claims_list_rows()), which is what
 * decides an empty listing instead of a 403. Conflating the two would deny
 * access to an operator whose assignment is simply pending, which reads as a
 * broken account rather than an empty one.
 *
 * Returning FALSE makes Drupal answer 403, not a redirect nor a blank page.
 *
 * uid 1 is let in explicitly, same guard as myapi_calendar_access() and for
 * the same reason: the superuser bypass lives inside user_access(), which
 * this callback never calls.
 *
 * @return bool  TRUE when the current user may see the claims listing.
 */
function myapi_claims_admin_access() {
  global $user;

  if ((int) $user->uid === 1) {
    return TRUE;
  }

  return (bool) array_intersect($user->roles, myapi_claims_admin_roles());
}

/**
 * Access callback of node/%node/claim-transaction/add (SPEC 57).
 *
 * Unlike myapi_claims_admin_access() above, this is a per-NODE check, not a
 * per-role one: it defers entirely to node_access(), which already handles
 * the 'bypass node access' superuser shortcut and, for 'administrador
 * edificio', the condominium scoping of SPEC 49/56 via
 * myapi_node_access() (hook_node_access() in this same file). Nothing here
 * duplicates that logic.
 *
 * FALSE for any node that is not a 'reclamo': the route is
 * node/%node/claim-transaction/add for any node id, and this closes it for
 * every other content type.
 *
 * @param object $node
 *   The node loaded from the %node wildcard.
 *
 * @return bool  TRUE when the current user may open the creation page for
 *   this claim.
 */
function myapi_claim_transaction_add_access($node) {
  if (!is_object($node) || $node->type !== 'reclamo') {
    return FALSE;
  }

  return node_access('update', $node) && node_access('create', 'claim_transaction');
}

/**
 * Implements hook_mail().
 *
 * Glue only: loads the mail include and delegates the formatting. The
 * reservation keys are reached from the deferred mail queue during cron (see
 * includes/myapi.mail_queue.inc), the password reset one from the request that
 * asks for it.
 */
function myapi_mail($key, &$message, $params) {
  module_load_include('inc', 'myapi', 'includes/myapi.mail');

  switch ($key) {
    case 'password_reset':
      myapi_mail_format_password_reset($message, $params);
      break;

    // Both resident keys share a formatter: they differ only in the subject,
    // the context sentence and the closing line.
    case 'reservation_created_user':
    case 'reservation_cancelled_user':
      myapi_mail_format_reservation_user($message, $params, $key);
      break;

    // Both 'backend' keys share a formatter too: they differ only in the
    // subject, the heading and the two extra lines of the cancellation.
    case 'reservation_created_admin':
    case 'reservation_cancelled_admin':
      myapi_mail_format_reservation_admin($message, $params, $key);
      break;
  }
}

/**
 * Implements hook_node_presave().
 *
 * Glue only. Independent branches, same shape as myapi_node_insert() below —
 * this function used to be a single 'pagos' branch with an early return, and
 * grew a second one in SPEC 60 without changing the first:
 * - 'pagos': delegates the payment verification workflow to
 *   includes/myapi.payment_workflow.inc. Its own return keeps the branch from
 *   recursing when the workflow re-saves the 'vivienda' and 'condominio' nodes.
 * - 'claim_transaction': delegates to myapi_claim_transaction_set_title()
 *   (includes/myapi.claim_transaction_admin.inc, SPEC 60), which composes the
 *   node title out of the claim, status, status date and comment. Presave and
 *   not insert/update: field_attach_presave() has already normalised the field
 *   values by now, and the row is not written yet, so no second save is needed.
 *   Covers every creation and edition path of a transaction at once — the
 *   module's own creation page, the automatic initial transaction, and both
 *   native node forms.
 */
function myapi_node_presave($node) {
  if ($node->type === 'pagos') {
    module_load_include('inc', 'myapi', 'includes/myapi.payment_workflow');
    if (myapi_payment_is_verification_transition($node)) {
      myapi_payment_apply_verification($node);
    }
    return;
  }
  if ($node->type === 'claim_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_set_title($node);
  }
}

/**
 * Implements hook_node_insert().
 *
 * Glue only. Independent branches:
 * - 'pagos' created directly with field_estado_pago = "Completado": delegates
 *   to myapi_payment_notify_approved() in includes/myapi.payment_workflow.inc
 *   (the verification-transition case is already covered by
 *   myapi_node_presave() above; this branch only covers direct creation,
 *   where $node->nid did not exist yet in presave).
 * - 'reclamo': delegates to myapi_claim_transaction_create_initial() in
 *   includes/myapi.claim_transaction_admin.inc (SPEC 57), which creates the
 *   claim's automatic initial transaction. Runs for every 'reclamo' creation
 *   path, not only the admin form — see that function's docblock.
 * - 'claim_transaction': delegates to
 *   myapi_claim_transaction_sync_claim_status() (SPEC 57, same include),
 *   which syncs the parent claim's field_status when it differs. Covers
 *   node/add/claim_transaction (the native form, for 'administrator'/
 *   'backend') as well as myapi_claim_transaction_create_form() (SPEC 57's
 *   own creation page) — both end in node_save(), which is what fires this
 *   hook. Never finds a difference for
 *   the automatic initial transaction above, since it is born with the
 *   claim's own current status — no insert-triggers-update cascade.
 * - Published 'boletin' node: delegates the notification fan-out + push
 *   enqueue to includes/myapi.notification.inc. A bulletin saved as a draft
 *   (status 0) does not notify anyone; editing or publishing it later does
 *   not fire either (only insert of a published node).
 */
function myapi_node_insert($node) {
  if ($node->type === 'pagos') {
    module_load_include('inc', 'myapi', 'includes/myapi.payment_workflow');
    if (myapi_payment_field_value($node, 'field_estado_pago') === MYAPI_PAYMENT_STATUS_COMPLETED) {
      myapi_payment_notify_approved($node);
    }
    return;
  }
  if ($node->type === 'reclamo') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_create_initial($node);
    return;
  }
  if ($node->type === 'claim_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_sync_claim_status($node);
    return;
  }
  if ($node->type !== 'boletin' || $node->status != 1) {
    return;
  }
  module_load_include('inc', 'myapi', 'includes/myapi.notification');
  myapi_notification_create_from_boletin($node);
}

/**
 * Implements hook_node_update().
 *
 * Glue only. Two independent branches:
 * - 'pagos': delegates to myapi_payment_is_rule_completion() /
 *   myapi_payment_notify_approved() in includes/myapi.payment_workflow.inc.
 *   Covers the "Nuevo" -> "Completado" transition produced by the legacy Rule
 *   'rules_actualizar_saldo_pago' when it auto-saves a 'pagos' node created
 *   directly in "Nuevo" (the Rule already did the balance work; this hook only
 *   notifies). Also delegates to myapi_payment_is_cancellation_transition() /
 *   myapi_payment_notify_cancelled() for a back-office "* -> Anulado" update
 *   (the opt-out save from PUT /api/v1/payments/%/cancel never matches it).
 * - 'recibo' / 'alicuota_extra': delegates to myapi_fee_is_sent_transition() /
 *   myapi_fee_notify_issued() in includes/myapi.fee_notification.inc, notifying
 *   the unit occupants when the fee transitions to "Enviado" on edit.
 * - 'reservation': delegates to myapi_reservation_is_cancellation_transition() /
 *   myapi_reservation_notify_cancelled() in
 *   includes/myapi.reservation_notification.inc, notifying the resident when an
 *   operator cancels their reservation from the back office. The opt-out save
 *   from PUT /api/v1/reservations/%/cancel never matches it, so a resident
 *   cancelling from the app notifies nobody.
 * - 'claim_transaction': delegates to
 *   myapi_claim_transaction_sync_claim_status() (SPEC 57,
 *   includes/myapi.claim_transaction_admin.inc) — same function
 *   myapi_node_insert()'s 'claim_transaction' branch calls, so editing an
 *   existing transaction's field_status (node/%nid/edit, the native form)
 *   syncs the claim exactly like creating one does.
 */
function myapi_node_update($node) {
  if ($node->type === 'pagos') {
    module_load_include('inc', 'myapi', 'includes/myapi.payment_workflow');
    if (myapi_payment_is_rule_completion($node)) {
      myapi_payment_notify_approved($node);
    }
    elseif (myapi_payment_is_cancellation_transition($node)) {
      myapi_payment_notify_cancelled($node);
    }
    return;
  }
  if ($node->type === 'recibo' || $node->type === 'alicuota_extra') {
    module_load_include('inc', 'myapi', 'includes/myapi.fee_notification');
    if (myapi_fee_is_sent_transition($node)) {
      myapi_fee_notify_issued($node);
    }
    return;
  }
  if ($node->type === 'reservation') {
    module_load_include('inc', 'myapi', 'includes/myapi.reservation_notification');
    if (myapi_reservation_is_cancellation_transition($node)) {
      myapi_reservation_notify_cancelled($node);
    }
    return;
  }
  if ($node->type === 'claim_transaction') {
    module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
    myapi_claim_transaction_sync_claim_status($node);
    return;
  }
}

/**
 * Implements hook_node_access().
 *
 * The per-node half of the condominium filter of SPEC 49: a user holding the
 * 'administrador edificio' role only reaches nodes of their assigned
 * condominiums. The other half is myapi_query_node_access_alter(), which
 * narrows the listings; this one closes the direct URL.
 *
 * Returns NODE_ACCESS_DENY only when ALL of these hold, and NODE_ACCESS_IGNORE
 * otherwise:
 * - the account holds the role (nobody else's access changes, the API
 *   included);
 * - the node's type is in myapi_building_admin_condominium_map();
 * - its condominium could be resolved;
 * - and that condominium is not among the assigned ones — where "no
 *   condominium assigned at all" denies everything, by design.
 *
 * It NEVER returns NODE_ACCESS_ALLOW. Allowing here would short-circuit every
 * other check Drupal makes — unpublished nodes, other modules' hooks — turning
 * a condominium filter into a permission escalation. IGNORE means "I have
 * nothing to say", which is exactly the case for every node this role may see.
 *
 * Two shapes of call are stepped around on the first lines:
 * - $op 'create' arrives with $node as a TYPE STRING, not an object. Creation
 *   is out of this hook's reach by design; the bulletin case is covered in
 *   myapi_node_validate() and the area/reservation one is an accepted risk
 *   written down in the spec.
 * - A user with 'bypass node access' (administrator) never reaches this hook
 *   at all: node_access() returns before invoking it. That is why an account
 *   holding both roles keeps seeing everything.
 *
 * @param object|string $node
 *   The node being checked, or the type string on 'create'.
 * @param string $op
 *   'view', 'update', 'delete' or 'create'.
 * @param object $account
 *   The account the check is made for.
 *
 * @return int
 *   NODE_ACCESS_DENY or NODE_ACCESS_IGNORE.
 */
function myapi_node_access($node, $op, $account) {
  if (!is_object($node) || ($op !== 'view' && $op !== 'update' && $op !== 'delete')) {
    return NODE_ACCESS_IGNORE;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  if (!myapi_building_admin_is($account)) {
    return NODE_ACCESS_IGNORE;
  }

  $decision = myapi_building_admin_access_decision(
    myapi_building_admin_node_condominium($node),
    myapi_building_admin_condominium_ids($account)
  );

  return $decision === 'deny' ? NODE_ACCESS_DENY : NODE_ACCESS_IGNORE;
}

/**
 * Implements hook_query_TAG_alter() for the 'node_access' tag.
 *
 * The listing half of the SPEC 49 condominium filter; myapi_node_access() is
 * the per-node half. Glue only: everything it decides lives in
 * includes/myapi.building_admin.inc, next to the catalogues it reads.
 *
 * Scope worth stating out loud, because it is wider than /admin/content: this
 * runs on EVERY query tagged 'node_access', which includes the
 * entityreference autocompletes of the node forms. That is deliberate — it is
 * what keeps the condominium selectors offering the assigned condominiums and
 * only those — and it is written down in docs/building-admin-role.md so it is
 * not diagnosed later as a bug.
 *
 * No query of this module carries that tag (checked across resources/ and
 * includes/), so the api/v1/... endpoints are untouched.
 */
function myapi_query_node_access_alter(QueryAlterableInterface $query) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
  myapi_building_admin_alter_node_query($query);
}

/**
 * Implements hook_query_TAG_alter() for the 'user_access' tag.
 *
 * The listing half of the SPEC 51 people filter, mirror of the node one above;
 * myapi_building_admin_user_view_access() is the direct-URL half. Glue only:
 * the two guards and the single condition live in
 * includes/myapi.building_admin_user.inc.
 *
 * Which queries carry this tag, and why both matter:
 * - the generic entityreference handler when target_type is 'user', which is
 *   what narrows the field_requester autocomplete of the reservation form to
 *   the residents of the assigned condominiums;
 * - the 'users' base table of Views, which declares it as an access query tag,
 *   so any back-office listing of people is scoped too — unless somebody ticks
 *   "Disable SQL rewriting" on the view, which is written down as a known risk.
 *
 * No query of this module carries that tag (checked across resources/ and
 * includes/), so the api/v1/... endpoints are untouched.
 */
function myapi_query_user_access_alter(QueryAlterableInterface $query) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin_user');
  myapi_building_admin_alter_user_query($query);
}

/**
 * Implements hook_file_download().
 *
 * The back office's half of SPEC 65: since the claim images and attachments
 * moved to private://, nothing serves them without an explicit decision, and
 * this is where the operator's decision is made. The app's half is
 * GET /api/v1/claims/%/files/% in resources/claim.resource.inc, which asks a
 * different question (a Bearer token and the visibility rule of SPEC 64) of
 * the same shared include.
 *
 * Glue only, like the two hooks above: the three return values Drupal expects
 * — headers, -1, NULL — are decided in includes/myapi.claims_files.inc, next
 * to the ownership resolution the endpoint also calls.
 *
 * NULL for anything this module does not recognise is deliberate: -1 is a hard
 * deny that cuts other modules off, so answering NULL keeps this module
 * opining about its own files only, and every other private file of the site
 * behaves exactly as it did before.
 *
 * @param string $uri
 *   The URI of the file being requested.
 *
 * @return array|int|NULL
 *   Headers when granted, -1 when denied, NULL when the file is not ours.
 */
function myapi_file_download($uri) {
  global $user;

  module_load_include('inc', 'myapi', 'includes/myapi.claims_files');

  return myapi_claims_file_download_headers($uri, $user);
}

/**
 * Implements hook_field_access().
 *
 * Restricts field_condominio_admin — the user field that decides which
 * condominiums a building admin reaches — to the roles that may hand it out
 * (SPEC 49). Everybody else neither sees it on a profile nor gets it on the
 * user form.
 *
 * This is not cosmetic. Editing one's OWN account needs no permission in
 * Drupal, so without this hook a building admin could open /user/N/edit and
 * assign themselves every condominium on the site — the whole filter is only
 * as strong as who can write this field.
 *
 * Glue only, and it leaves every other field of every other entity alone: the
 * two guards on the first lines return TRUE ("no objection") before the
 * include is even loaded for anything that is not this exact field on a user.
 *
 * @param string $op
 *   'view' or 'edit'. Both are denied — a value that cannot be changed is
 *   still an assignment nobody outside those roles has business reading.
 *
 * @return bool
 *   FALSE denies the field; TRUE leaves the decision to Drupal.
 */
function myapi_field_access($op, $field, $entity_type, $entity, $account) {
  if ($entity_type !== 'user' || empty($field['field_name'])) {
    return TRUE;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  if ($field['field_name'] !== MYAPI_BUILDING_ADMIN_CONDO_FIELD) {
    return TRUE;
  }

  return myapi_building_admin_assignment_field_access($account);
}

/**
 * Implements hook_form_FORM_ID_alter() for the 'boletin' node form.
 *
 * Glue only. Hides the 'General' and 'Personalizado' scopes from a building
 * admin (SPEC 49), so the form offers only what the role may actually publish
 * instead of accepting a choice and rejecting it on submit.
 *
 * This does NOT replace myapi_building_admin_validate_bulletin(): shaping a
 * form is not enforcing a rule, and a hand-crafted POST never sees this
 * function. Both layers stay.
 *
 * Every other user reaches the untouched form — the role check is the first
 * line of the delegate.
 */
function myapi_form_boletin_node_form_alter(&$form, &$form_state, $form_id) {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
  myapi_building_admin_restrict_bulletin_form($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for the 'reclamo' node form (SPEC 57).
 *
 * Glue only, same criterion as myapi_form_boletin_node_form_alter() just
 * above: the include is loaded and the actual work — disabling field_status
 * in edit mode and appending the transactions timeline fieldset — is
 * delegated entirely to includes/myapi.claim_transaction_admin.inc.
 */
function myapi_form_reclamo_node_form_alter(&$form, &$form_state, $form_id) {
  module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
  myapi_claim_transaction_reclamo_form_alter($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for the 'claim_transaction' node form
 * (SPEC 59).
 *
 * Glue only, same criterion as the two above: the include is loaded and the
 * actual work — locking field_claim in edit mode and redirecting back to the
 * claim after saving — is delegated entirely to
 * includes/myapi.claim_transaction_admin.inc.
 */
function myapi_form_claim_transaction_node_form_alter(&$form, &$form_state, $form_id) {
  module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
  myapi_claim_transaction_transaction_form_alter($form, $form_state);
}

/**
 * Implements hook_node_validate().
 *
 * Glue only, dispatching by node type. Every type not named below falls
 * through untouched, and its include is never loaded:
 * - 'area' — HH:MM format of field_open_time / field_close_time (SPEC 46),
 *   in includes/myapi.area_admin.inc. Unchanged behaviour.
 * - 'boletin' — a building admin may only publish 'Condominio' bulletins of
 *   their assigned condominiums (SPEC 49), in
 *   includes/myapi.building_admin.inc. Every other user passes through.
 * - 'reservation' — two validations, in this order:
 *   1. HH:MM format of field_start_time / field_end_time (SPEC 52), in
 *      includes/myapi.reservation_admin.inc. Applies to EVERY user.
 *   2. a building admin may only book for a person they can see and on a unit
 *      of their condominiums (SPEC 51), in
 *      includes/myapi.building_admin_user.inc. Every other user passes through.
 *   Format goes first because it is the one that applies to everybody:
 *   form_set_error() accumulates, so a building admin who submits a malformed
 *   time AND a unit outside their condominiums sees both messages at once.
 *
 * This hook is reached from node_form_validate() only, so it guards the admin
 * node form (node/add/... and node/%/edit) and nothing else: a programmatic
 * node_save() — a migration, drush, or the node the reservation endpoints save
 * — does not go through form validation and is deliberately out of scope.
 */
function myapi_node_validate($node, $form, &$form_state) {
  switch ($node->type) {
    case 'area':
      module_load_include('inc', 'myapi', 'includes/myapi.area_admin');
      myapi_area_validate_times($node, $form, $form_state);
      return;

    case 'boletin':
      module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
      myapi_building_admin_validate_bulletin($node, $form, $form_state);
      return;

    case 'reservation':
      module_load_include('inc', 'myapi', 'includes/myapi.reservation_admin');
      myapi_reservation_validate_times($node, $form, $form_state);

      module_load_include('inc', 'myapi', 'includes/myapi.building_admin_user');
      myapi_building_admin_validate_reservation($node, $form, $form_state);
      return;
  }
}

/**
 * Implements hook_cron_queue_info().
 *
 * Registers the workers that drain the OneSignal push queue and the deferred
 * mail queue. This hook is invoked by drupal_cron_run() right before it
 * processes the queues in the same request, so loading the includes here
 * guarantees the worker functions are defined when the queues are drained.
 *
 * Retry policy differs per queue: a failing push item throws and is retried on
 * the next cron (standard Queue API behaviour), while the mail worker re-enqueues
 * with a bounded attempt counter and drops afterwards (see
 * includes/myapi.mail_queue.inc).
 */
function myapi_cron_queue_info() {
  // Load the includes so the worker callbacks are defined when drupal_cron_run()
  // drains the queues later in this same request. The queue names come from the
  // constants defined at the top of this file, so they never depend on the loads
  // above succeeding.
  module_load_include('inc', 'myapi', 'includes/myapi.onesignal');
  module_load_include('inc', 'myapi', 'includes/myapi.mail_queue');

  $queues = [];
  $queues[MYAPI_ONESIGNAL_QUEUE] = [
    'worker callback' => 'myapi_onesignal_queue_worker',
    'time'            => 60,
  ];
  $queues[MYAPI_MAIL_QUEUE] = [
    'worker callback' => 'myapi_mail_queue_worker',
    'time'            => 60,
  ];
  return $queues;
}
