  $items['api/v1/areas/%'] = [
    'page callback'    => 'myapi_area_details_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/area.resource.inc',
  ];

  $items['api/v1/areas/%/availability'] = [
    'page callback'    => 'myapi_area_availability_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
