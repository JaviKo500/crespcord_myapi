    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/payments'] = [
    'page callback'    => 'myapi_payment_create_dispatch',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
