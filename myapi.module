  $items['api/v1/units/%/extra-fees'] = [
    'page callback'    => 'myapi_extra_fee_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/extra_fee.resource.inc',
  ];

  $items['api/v1/units/%/payments'] = [
    'page callback'    => 'myapi_payment_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/payment.resource.inc',
  ];

  $items['api/v1/units/%/reservations'] = [
    'page callback'    => 'myapi_reservation_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/reservations'] = [
    'page callback'    => 'myapi_reservation_create_dispatch',
    'page arguments'   => [],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/reservations/%/cancel'] = [
    'page callback'    => 'myapi_reservation_cancel_dispatch',
    'page arguments'   => [3],
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
    'file'             => 'resources/reservation.resource.inc',
  ];

  $items['api/v1/reservations/%/details'] = [
