# Local development environment. Copy to .env (gitignored) and adjust.
# Nothing here is a production credential: these values only exist on this
# machine. See docs/desarrollo-local.md.

COMPOSE_PROJECT_NAME=crespcord

# Address and port the site is published on. Keep 127.0.0.1 unless a physical
# device on the LAN has to reach it; then use 0.0.0.0.
WEB_BIND=127.0.0.1
WEB_PORT=8080
MAILPIT_PORT=8025
DB_PORT=33066

# URL Drush uses to build links (mails sent from the queue, cron). Web
# requests take the host from the request itself, so the same site answers on
# localhost, 10.0.2.2 (Android emulator) and the LAN address.
LOCAL_BASE_URL=http://localhost:8080

# Database of the db container.
DB_NAME=crespcord
DB_USER=crespcord
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-local-root

# Password every imported account gets after sanitizing (local only).
LOCAL_USER_PASSWORD=Local.1234

# X-Api-Key accepted by the bot endpoints in local.
LOCAL_BOT_API_KEY=local-bot-api-key

# 1 = dump dr_field_revision_* without rows (saves ~6.7 GB; old node revisions
# show empty fields). 0 = bring them too.
DUMP_SKIP_FIELD_REVISIONS=1
