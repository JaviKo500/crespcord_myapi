/**
 * Creates the 'administrador edificio' role, its field and its permissions
 * (idempotent, SPEC 49).
 *
 * Single source of truth for that role's installation: called both from
 * hook_install() (fresh sites) and from myapi_update_7012() (already installed
 * sites). Re-running it never duplicates the role, the field, the instance nor
 * a role_permission row.
 *
 * Deliberately CONSERVATIVE: it creates what is missing and never revokes nor
 * deletes. An administrator may have adjusted permissions by hand in
 * production, and a `drush updb` must not undo that. The accepted trade-off is
 * the other way round: re-running the update DOES grant again anything that
 * was revoked by hand.
 *
 * Three parts, in this order:
 * (a) the role, looked up by name because the rid is per environment;
 * (b) the user field, with the same _ensure_field()/_ensure_instance() pair
 *     the reservations model uses;
 * (c) the permissions, crossed against the ones that actually exist on the
 *     site so nothing dead is written into role_permission.
 */
function _myapi_building_admin_install() {
  // Functions of a files[] .inc are not autoloaded by the D7 registry, and an
  // .install runs early enough that the registry may not be warm anyway, so
  // the include is explicit.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  // (a) The role. user_role_save() would happily create a second role with the
  // same name, so the lookup is what makes this idempotent. The rid it gets is
  // never read: every check in the module compares role NAMES.
  $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  if (!$role) {
    $role = new stdClass();
    $role->name = MYAPI_BUILDING_ADMIN_ROLE;
    user_role_save($role);
    // user_role_save() writes the new rid back onto the object, but a reload
    // is cheaper to reason about than trusting that side effect.
    $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  }

  if (!$role) {
    // Nothing else can be done without a role to grant to. Loud rather than
    // silent: the permissions below would otherwise fail one by one.
    watchdog(
      'myapi',
      'SPEC 49: the role "@role" could not be created; its field and permissions were skipped.',
      ['@role' => MYAPI_BUILDING_ADMIN_ROLE],
      WATCHDOG_ERROR
    );
    return;
  }

  // (b) The user field: entityreference to 'condominio' nodes, unlimited
  // cardinality, one instance on the single bundle of the user entity. The
  // Field API creates field_data_field_condominio_admin and its revision table
  // with entity_type = 'user'.
  //
  // 'target_type', the handler and the target_bundles that restrict the
  // autocomplete to condominiums are ALL field-level settings in D7
  // entityreference, so all three come from the shared catalogue. Writing them
  // on the instance — which is what this did until SPEC 53 — leaves the handler
  // with no bundle condition and the tags autocomplete of /user/N/edit offers
  // every node of the site.
  $reference_settings = _myapi_entityreference_field_settings();

  _myapi_reservations_ensure_field(MYAPI_BUILDING_ADMIN_CONDO_FIELD, [
    'field_name'  => MYAPI_BUILDING_ADMIN_CONDO_FIELD,
    'type'        => 'entityreference',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings'    => $reference_settings[MYAPI_BUILDING_ADMIN_CONDO_FIELD],
  ]);
  _myapi_reservations_ensure_instance(MYAPI_BUILDING_ADMIN_CONDO_FIELD, 'user', [
    'field_name'  => MYAPI_BUILDING_ADMIN_CONDO_FIELD,
    'entity_type' => 'user',
    'bundle'      => 'user',
    'label'       => 'Condominios administrados',
    'required'    => 0,
    'description' => 'Condominios que este usuario puede administrar. Solo aplica al rol "administrador edificio"; sin ningún condominio, no verá contenido alguno.',
    'widget'      => ['type' => 'entityreference_autocomplete_tags'],
  ], 'user');

  // (c) The permissions. module_invoke_all('permission') returns
  // permission name => definition, so its KEYS are the permissions that exist
  // on this site right now. Crossing against them drops 'create reclamo
  // content' while the claims bundle does not exist and 'access toolbar' when
  // the toolbar module is disabled — instead of writing rows in
  // role_permission that no screen can ever show or revoke.
  //
  // user_role_grant_permissions() is itself idempotent: it merges, so granting
  // the same permission twice leaves one row.
  $available = array_keys(module_invoke_all('permission'));
  $granted = myapi_building_admin_filter_available_permissions(
    myapi_building_admin_permissions(),
    $available
  );

  if ($granted) {
    user_role_grant_permissions($role->rid, $granted);
  }
}

/**
 * Creates the claims content types, fields and instances (idempotent, SPEC 55).
 *
 * Single source of truth for the claims schema, called both from
 * hook_install() (fresh sites) and from myapi_update_7017() (already installed
 * sites). Re-running it never duplicates anything nor throws, because every
 * creation goes through the same idempotent _ensure_* sub-helpers the
 * reservations model uses (SPEC 32) — no sub-helper is added by this function.
 *
 * Order: (a) the two node types; (b) every field at the storage level
 * (field_images and field_attachment created once, shared by both bundles;
 * field_status created once, shared by both bundles); (c) the per-bundle
 * instances, including the new instances of field_condominium and
 * field_requester on 'reclamo' (fields themselves already exist since SPEC 32
 * and are not recreated here).
 *
 * entityreference note: field_claim's 'target_type', 'handler' and
 * 'handler_settings.target_bundles' come from
 * _myapi_entityreference_field_settings(), same as every other entityreference
 * field in this module — never written on the instance.
 *
 * field_status note: ONE field shared by both bundles, because their
 * allowed_values are identical (unlike field_area_status /
 * field_reservation_status in SPEC 32, which differed). Only the instance
 * default_value differs: 'received' on 'reclamo', none on 'claim_transaction'
 * — Field API allows that without any special handling.
 */
function _myapi_claims_install() {
  // MYAPI_BUILDING_ADMIN_CLAIM_TYPE lives in the role's include. Explicit,
  // like every other use of it in this file: an .install runs early enough
  // that the D7 registry may not have the files[] entries warm.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $claim_type = MYAPI_BUILDING_ADMIN_CLAIM_TYPE;
  $transaction_type = 'claim_transaction';

  // (a) Content types.
  _myapi_reservations_ensure_node_type(
    $claim_type,
    'Reclamo',
    'Reclamo o requerimiento presentado por un residente.',
    'Asunto'
  );
  _myapi_reservations_ensure_node_type(
    $transaction_type,
    'Transacción de reclamo',
    'Entrada de la línea de tiempo de un reclamo: cambio de estado con comentario opcional del administrador.',
    'Título'
  );

  // (b) Fields (storage level).
  //
  // field_claim's whole 'settings' comes from the catalogue: that is where the
  // referenceable bundle ('reclamo') is decided, and the selection handler
  // reads it from the field, not from the instance.
  $reference_settings = _myapi_entityreference_field_settings();

  _myapi_reservations_ensure_field('field_images', [
    'field_name'  => 'field_images',
    'type'        => 'image',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
  ]);
  _myapi_reservations_ensure_field('field_attachment', [
    'field_name'  => 'field_attachment',
    'type'        => 'file',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_description', [
    'field_name'  => 'field_description',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_status', [
    'field_name'  => 'field_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'received'    => 'Recibido',
        'in_progress' => 'En proceso',
        'resolved'    => 'Resuelto',
        'closed'      => 'Cerrado',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_claim_type', [
    'field_name'  => 'field_claim_type',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'requirement' => 'Requerimiento',
        'claim'       => 'Reclamo',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_reception_date', [
    'field_name'  => 'field_reception_date',
    'type'        => 'datetime',
    'cardinality' => 1,
    'settings'    => [
      // Day + hour + minute since SPEC 63, same granularity field_status_date
      // got in SPEC 58: a claim records the instant it was received, not that
      // day at midnight.
      'granularity' => [
        'year'   => 'year',
        'month'  => 'month',
        'day'    => 'day',
        'hour'   => 'hour',
        'minute' => 'minute',
        'second' => 0,
      ],
      'tz_handling' => 'none',
      'timezone_db' => '',
      'todate'      => '',
    ],
  ]);
  _myapi_reservations_ensure_field('field_visibility', [
    'field_name'  => 'field_visibility',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'private' => 'Privado',
        'public'  => 'Público',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_status_date', [
    'field_name'  => 'field_status_date',
    'type'        => 'datetime',
    'cardinality' => 1,
    'settings'    => [
      'granularity' => [
        'year'   => 'year',
        'month'  => 'month',
        'day'    => 'day',
        'hour'   => 'hour',
        'minute' => 'minute',
        'second' => 0,
      ],
      'tz_handling' => 'none',
      'timezone_db' => '',
      'todate'      => '',
    ],
  ]);
  _myapi_reservations_ensure_field('field_comment', [
    'field_name'  => 'field_comment',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_claim', [
    'field_name'  => 'field_claim',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_claim'],
  ]);

  // (c) Instances of the 'reclamo' bundle.
  _myapi_reservations_ensure_instance('field_condominium', $claim_type, [
    'field_name'  => 'field_condominium',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Condominio',
    'required'    => 1,
    // No 'settings' here on purpose: the referenceable bundle is a field-level
    // setting and lives in _myapi_entityreference_field_settings().
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_requester', $claim_type, [
    'field_name'  => 'field_requester',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Solicitante',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_description', $claim_type, [
    'field_name'    => 'field_description',
    'entity_type'   => 'node',
    'bundle'        => $claim_type,
    'label'         => 'Descripción',
    'required'      => 1,
    'settings'      => ['text_processing' => 1],
    // 'plain_text' is pinned on purpose, unlike field_area_notes (SPEC 32),
    // whose 'format' key was removed by myapi_update_7013() because pinning
    // 'full_html' disabled the textarea for anyone without that format. Plain
    // text is available to every user, so no such problem exists here.
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_status', $claim_type, [
    'field_name'    => 'field_status',
    'entity_type'   => 'node',
    'bundle'        => $claim_type,
    'label'         => 'Estado',
    'required'      => 1,
    'default_value' => [['value' => 'received']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_claim_type', $claim_type, [
    'field_name'  => 'field_claim_type',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Tipo',
    'required'    => 1,
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_reception_date', $claim_type, [
    'field_name'  => 'field_reception_date',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Fecha de recepción',
    'required'    => 1,
    'widget'      => [
      'type'     => 'date_select',
      'settings' => [
        'input_format'   => 'Y-m-d H:i',
        'year_range'     => '-1:+3',
        'increment'      => 1,
        'label_position' => 'above',
        'text_parts'     => [],
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_visibility', $claim_type, [
    'field_name'    => 'field_visibility',
    'entity_type'   => 'node',
    'bundle'        => $claim_type,
    'label'         => 'Visibilidad',
    'required'      => 1,
    'default_value' => [['value' => 'private']],
    'widget'        => ['type' => 'options_select'],
  ]);

  // (c) Instances of the 'claim_transaction' bundle.
  _myapi_reservations_ensure_instance('field_status', $transaction_type, [
    'field_name'  => 'field_status',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Estado',
    'required'    => 1,
    // No 'default_value' here on purpose, unlike the 'reclamo' instance above:
    // a transaction always records a deliberately chosen new status.
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_status_date', $transaction_type, [
    'field_name'  => 'field_status_date',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Fecha del estado',
    'required'    => 1,
    'widget'      => [
      'type'     => 'date_select',
      'settings' => [
        'input_format'   => 'Y-m-d H:i',
        'year_range'     => '-1:+3',
        'increment'      => 1,
        'label_position' => 'above',
        'text_parts'     => [],
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_comment', $transaction_type, [
    'field_name'    => 'field_comment',
    'entity_type'   => 'node',
    'bundle'        => $transaction_type,
    'label'         => 'Comentario',
    'required'      => 0,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_claim', $transaction_type, [
    'field_name'  => 'field_claim',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Reclamo',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);

  // (c) Instances of field_images and field_attachment, identical on both
  // bundles (same rule, same limits — see the docblock above).
  $images_settings = [
    'file_extensions'    => 'png jpg jpeg',
    'max_filesize'       => '3 MB',
    // Alt text is offered but not required — distinct from field_image on
    // 'area' (SPEC 32), which disables it entirely (alt_field = 0).
    'alt_field'          => 1,
    'alt_field_required' => 0,
  ];
  $attachment_settings = [
    'file_extensions' => 'pdf doc docx xls xlsx',
    'max_filesize'    => '3 MB',
  ];

  foreach ([$claim_type, $transaction_type] as $bundle) {
    _myapi_reservations_ensure_instance('field_images', $bundle, [
      'field_name'  => 'field_images',
      'entity_type' => 'node',
      'bundle'      => $bundle,
      'label'       => 'Imágenes',
      'required'    => 0,
      'settings'    => $images_settings,
      'widget'      => ['type' => 'image_image'],
    ]);
    _myapi_reservations_ensure_instance('field_attachment', $bundle, [
      'field_name'  => 'field_attachment',
      'entity_type' => 'node',
      'bundle'      => $bundle,
      'label'       => 'Adjunto',
      'required'    => 0,
      'settings'    => $attachment_settings,
      'widget'      => ['type' => 'file_generic'],
    ]);
  }
}

/**
 * Creates the my_api_tokens table on sites where the module is already enabled.
 */
function myapi_update_7001() {
  if (!db_table_exists('my_api_tokens')) {
    $schema = drupal_get_schema_unprocessed('myapi', 'my_api_tokens');
    db_create_table('my_api_tokens', $schema);
  }
}

/**
 * Creates the myapi_password_reset_tokens table on sites where the module is
 * already enabled.
 */
function myapi_update_7002() {
  if (!db_table_exists('myapi_password_reset_tokens')) {
    $schema = drupal_get_schema_unprocessed('myapi', 'myapi_password_reset_tokens');
    db_create_table('myapi_password_reset_tokens', $schema);
  }
}

/**
 * Registers the HTML mail system for the password reset email on sites where
 * the module is already enabled.
 */
function myapi_update_7003() {
  myapi_mail_system_register();
}

/**
 * Creates the myapi_notifications table on sites where the module is already
 * enabled.
 */
function myapi_update_7004() {
  if (!db_table_exists('myapi_notifications')) {
    $schema = drupal_get_schema_unprocessed('myapi', 'myapi_notifications');
    db_create_table('myapi_notifications', $schema);
  }
}

/**
 * Adds condominium_id and unit_id to myapi_notifications on sites where the
 * table already exists.
 */
function myapi_update_7005() {
  if (!db_field_exists('myapi_notifications', 'condominium_id')) {
    db_add_field('myapi_notifications', 'condominium_id', [
      'description' => 'Logical FK to the condominium node (nid). NULL for notifications with no single condominium context (e.g. boletin fan-out).',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => FALSE,
    ]);
  }
  if (!db_field_exists('myapi_notifications', 'unit_id')) {
    db_add_field('myapi_notifications', 'unit_id', [
      'description' => 'Logical FK to the unit (vivienda) node (nid). NULL for notifications with no single unit context (e.g. boletin fan-out).',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => FALSE,
    ]);
  }
}

/**
 * Creates the reservations content types (area, reservation) and their fields
 * on sites where the module is already installed.
 *
 * Runs the same idempotent _myapi_reservations_install() used by hook_install(),
 * so existing production sites get the reservations schema via `drush updb`
 * without a disable/enable cycle and without touching any existing data or
 * tables (my_api_tokens, myapi_password_reset_tokens, myapi_notifications).
 */
function myapi_update_7006() {
  _myapi_reservations_install();
}

/**
 * Adds the field_area_category classifier to the 'area' bundle on sites where
 * the module is already installed.
 *
 * Reuses the same idempotent sub-helpers as _myapi_reservations_install(), so it
 * creates the list_text field and its 'area' instance without duplicating them
 * or throwing a FieldException where they already exist. It only touches the
 * 'area' bundle — reservation and condominio are left untouched — and adds no
 * REST endpoint or business logic, just the field and its instance.
 */
function myapi_update_7007() {
  _myapi_reservations_ensure_field('field_area_category', [
    'field_name'  => 'field_area_category',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'pool'         => 'Piscina',
        'gym'          => 'Gimnasio',
        'party_hall'   => 'Salón de eventos',
        'bbq'          => 'Zona de parrillas (BBQ)',
        'playground'   => 'Área infantil',
        'sports_court' => 'Cancha deportiva',
        'coworking'    => 'Coworking / Sala de trabajo',
        'sauna'        => 'Sauna / Spa',
        'rooftop'      => 'Terraza / Rooftop',
        'other'        => 'Otra',
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_area_category', 'area', [
    'field_name'    => 'field_area_category',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Categoría del área',
    'required'      => 1,
    'description'   => 'Categoría de catálogo del área; la app la usa como clave estable para elegir el icono.',
    'default_value' => [['value' => 'other']],
    'widget'        => ['type' => 'options_select'],
  ]);
}

/**
 * Adds the field_area_notes free-text field to the 'area' bundle on sites where
 * the module is already installed.
 *
 * Reuses the same idempotent sub-helpers as _myapi_reservations_install(), so it
 * creates the text_long field and its 'area' instance without duplicating them
 * or throwing a FieldException where they already exist. It only touches the
 * 'area' bundle — reservation and condominio are left untouched — and adds no
 * REST endpoint or business logic, just the field and its instance.
 */
function myapi_update_7008() {
  _myapi_reservations_ensure_field('field_area_notes', [
    'field_name'  => 'field_area_notes',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_instance('field_area_notes', 'area', [
    'field_name'    => 'field_area_notes',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Instrucciones o notas',
    'required'      => 0,
    'description'   => 'Instrucciones, normas o detalles del área que la app muestra al residente antes de reservar. Admite HTML.',
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'full_html']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
}

/**
 * Adds the field_concurrent_reservations capacity field to the 'area'
 * bundle on sites where the module is already installed.
 *
 * Reuses the same idempotent sub-helpers as _myapi_reservations_install(), so it
 * creates the number_integer field and its 'area' instance without duplicating
 * them or throwing a FieldException where they already exist. It only touches
 * the 'area' bundle — reservation and condominio are left untouched — and adds
 * no REST endpoint or business logic, just the field and its instance.
 *
 * Leaving the field empty on an existing area is safe: the API normalises a
 * missing, NULL or below-1 value to a capacity of 1, which is exactly the
 * single-reservation overlap behaviour those areas already had.
 *
 * The field name carries no 'max_' prefix because Drupal 7 rejects field names
 * longer than 32 characters; the JSON key the API exposes is still
 * 'max_concurrent_reservations'.
 */
function myapi_update_7009() {
  _myapi_reservations_ensure_field('field_concurrent_reservations', [
    'field_name'  => 'field_concurrent_reservations',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_instance('field_concurrent_reservations', 'area', [
    'field_name'    => 'field_concurrent_reservations',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Reservas simultáneas permitidas',
    'required'      => 0,
    'description'   => 'Número de reservas que pueden coincidir en el mismo horario. Vacío o menor que 1 se interpreta como 1.',
    'default_value' => [['value' => 1]],
    'widget'        => ['type' => 'number'],
  ]);
}

/**
 * SPEC 48: maps the three reservation mail keys to MyapiHtmlMailSystem.
 *
 * myapi_mail_system_register() runs on install, so a fresh site already gets
 * the mapping; this update applies it where the module is already installed.
 * Without it, the new keys would fall back to DefaultMailSystem and the HTML
 * body would arrive converted to plain text.
 */
function myapi_update_7010() {
  myapi_mail_system_register();
}

/**
 * SPEC 50: adds the field_cancel_reason field and registers the fourth mail key.
 *
 * Runs the same idempotent _myapi_reservations_install() used by hook_install(),
 * so on a site that already has every other reservations field only the new
 * field and its 'reservation' instance are created; nothing else is touched and
 * re-running the update is a no-op.
 *
 * myapi_mail_system_register() maps 'myapi_reservation_cancelled_admin' to
 * MyapiHtmlMailSystem. Without it the new admin email would fall back to
 * DefaultMailSystem and arrive converted to plain text.
 */
function myapi_update_7011() {
  _myapi_reservations_install();
  myapi_mail_system_register();
}

/**
 * SPEC 49: creates the 'administrador edificio' role, its user field and its
 * permissions.
 *
 * Runs the same idempotent _myapi_building_admin_install() used by
 * hook_install(), so re-running it creates no second role, no second field and
 * no duplicate row in role_permission.
 *
 * The number is 7012 and NOT 7011: SPEC 50 already took 7011 and it is run in
 * production, and system_update_7000() only executes numbers above the stored
 * schema_version — reusing it would leave this update unrun on every existing
 * site.
 *
 * Nothing is assigned to anyone here: the role is created empty on purpose,
 * and giving it to a person is a manual task at /user/N/edit, together with
 * their condominiums.
 */
function myapi_update_7012() {
  _myapi_building_admin_install();
}

/**
 * SPEC 49: lets the building-admin role write formatted text.
 *
 * Two halves of the same bug. A role with no 'use text format ...' permission
 * only reaches Drupal's fallback format, so every formatted field it may edit
 * renders DISABLED — which is how this surfaced: field_area_notes came up
 * blocked on node/add/area and fine on node/%/edit, because an existing node
 * carries its own stored format while a new one takes the instance default.
 *
 * (a) Re-runs the idempotent installer, which now grants
 *     'use text format filtered_html'. Nothing else changes: the helper only
 *     adds what is missing and never revokes.
 * (b) Drops the hard-coded 'full_html' from the field_area_notes default value,
 *     so each user starts on the best format they are actually allowed to
 *     write with. Guarded so re-running it is a no-op, and so a site whose
 *     instance was adjusted by hand is not overwritten wholesale — only the
 *     'format' key of the default value is touched.
 *
 * Existing area nodes keep the format they were saved with; this only affects
 * the starting point of a NEW one.
 */
function myapi_update_7013() {
  _myapi_building_admin_install();

  $instance = field_info_instance('node', 'field_area_notes', 'area');
  if ($instance && isset($instance['default_value'][0]['format'])) {
    unset($instance['default_value'][0]['format']);
    field_update_instance($instance);
  }
}

/**
 * Revokes 'view the administration theme' from the building-admin role.
 *
 * With that permission the role saw node forms, /admin/content and the
 * reservation calendar rendered in Seven, while every other operator of this
 * site — 'backend' included — sees them in the site theme. Two consequences,
 * and the second is the one that decided it: the layout was different for no
 * reason, and Seven does not carry the role's own sidebar menu, because blocks
 * are placed per theme. Dropping the permission puts the role on the same
 * screens as 'backend'.
 *
 * **This update REVOKES, which nothing else in this module does.** The
 * installer only ever adds, on purpose, so that a permission adjusted by hand
 * in production survives a deployment. Taking the permission out of
 * myapi_building_admin_permissions() alone would therefore have left every
 * existing site exactly as it was and required a manual
 * `drush role-remove-perm` per environment — which is precisely the manual step
 * this update exists to remove. The trade-off is stated plainly: if somebody
 * re-grants the permission by hand, running updates again takes it away.
 *
 * Idempotent: user_role_revoke_permissions() deletes rows, so a second run
 * removes nothing that is not there. A site without the role does nothing.
 *
 * The number is 7015 and NOT 7014: SPEC 51 takes 7014, and reusing a number
 * would leave one of the two unrun on every site that already ran the other.
 */
function myapi_update_7015() {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  if (!$role) {
    return;
  }

  user_role_revoke_permissions($role->rid, ['view the administration theme']);
}

/**
 * Moves the entityreference selection settings onto the fields (SPEC 53).
 *
 * The bug this repairs: every autocomplete of this module offered every node of
 * the site. Typing in field_condominium of the area form came back with
 * viviendas, boletines and recibos, and the same happened in field_unit,
 * field_area and field_condominio_admin. The cause was placement, not logic —
 * 'handler' and 'handler_settings.target_bundles' were written on the INSTANCE,
 * while the entityreference selection handler reads them off the FIELD, so it
 * ran with no bundle condition at all. See
 * _myapi_entityreference_field_settings().
 *
 * Why an update hook is needed on top of fixing the installer:
 * _myapi_reservations_ensure_field() only creates what is missing and never
 * touches a field that exists, on purpose, so no `drush updb` would ever have
 * reached the fields of an installed site. This is the one place that writes
 * over them, and it uses field_update_field(), which changes the field
 * definition only — not one row of data moves.
 *
 * Conservative, like the rest of this installer: it FILLS IN what is missing
 * and never replaces a target_bundles somebody set by hand
 * (_myapi_entityreference_repair_settings() decides that, and is unit-tested).
 * A field this module never created is left alone; a field whose target_type
 * disagrees with the catalogue is REPORTED and skipped, because changing that
 * one would orphan every target_id already stored in it.
 *
 * The dead 'handler_settings' left on the old instances is not cleaned up:
 * entityreference never reads instance settings, so it costs nothing, and a
 * field_update_instance() per bundle would be a write with no effect to show
 * for it.
 *
 * Idempotent: a second run finds every setting already in place and writes
 * nothing.
 *
 * @return string
 *   A summary line, shown by drush and by update.php.
 */
function myapi_update_7016() {
  $repaired = [];
  $skipped = [];
  $missing = [];

  foreach (_myapi_entityreference_field_settings() as $field_name => $wanted) {
    // field_read_field() and NOT field_info_field(): the first returns the
    // definition as it is STORED, which is what may be written back with
    // field_update_field(). The second returns the cached, processed one — it
    // carries a 'bundles' key that does not belong in the field row, and during
    // a `drush updb` that cache is not guaranteed to be warm.
    $field = field_read_field($field_name);

    if (!$field) {
      // Nothing to repair — _myapi_reservations_install() creates it right,
      // and a site may legitimately not have it (no claims bundle, a field
      // deleted by hand).
      $missing[] = $field_name;
      continue;
    }

    $current = isset($field['settings']) && is_array($field['settings']) ? $field['settings'] : [];

    if (!empty($current['target_type']) && $current['target_type'] !== $wanted['target_type']) {
      $skipped[] = $field_name;
      watchdog(
        'myapi',
        'SPEC 53: field @field targets @actual, not @expected; its selection settings were left untouched.',
        [
          '@field'    => $field_name,
          '@actual'   => $current['target_type'],
          '@expected' => $wanted['target_type'],
        ],
        WATCHDOG_WARNING
      );
      continue;
    }

    $settings = _myapi_entityreference_repair_settings($current, $wanted);
    if ($settings === NULL) {
      continue;
    }

    $field['settings'] = $settings;
    field_update_field($field);
    $repaired[] = $field_name;
  }

  // The autocompletes read the field definition through the field info cache,
  // which field_update_field() clears on each write. Cleared once more here so
  // a run that repaired nothing still leaves a warm, correct cache.
  field_info_cache_clear();

  if ($repaired) {
    watchdog(
      'myapi',
      'SPEC 53: entityreference selection settings repaired on @fields.',
      ['@fields' => implode(', ', $repaired)],
      WATCHDOG_NOTICE
    );
  }

  $summary = $repaired
    ? t('Selection settings repaired on: @fields.', ['@fields' => implode(', ', $repaired)])
    : t('Every entityreference field already carried its selection settings; nothing to repair.');

  if ($missing) {
    $summary .= ' ' . t('Not present on this site: @fields.', ['@fields' => implode(', ', $missing)]);
  }
  if ($skipped) {
    $summary .= ' ' . t('Skipped for a target_type mismatch (see the log): @fields.', ['@fields' => implode(', ', $skipped)]);
  }

  return $summary;
}

/**
 * Creates the claims content types (reclamo, claim_transaction) and their
 * fields on sites where the module is already installed.
 *
 * Runs the same idempotent _myapi_claims_install() used by hook_install(), so
 * existing production sites get the claims schema via `drush updb` without a
 * disable/enable cycle and without touching any existing table or bundle
 * (my_api_tokens, myapi_notifications, 'area'/'reservation', etc.).
 *
 * The number is 7017 and NOT 7014, the next number the two comments above
 * myapi_requirements() and myapi_update_7015() point at: SPEC 51 reserved 7014
 * for a permission repair whose function was never written, a gap that
 * predates this spec and that this spec does not fill. 7015 and 7016 are
 * already taken, so 7017 is the first number actually free.
 */
function myapi_update_7017() {
  _myapi_claims_install();
}

/**
 * SPEC 56: grants the building-admin role its two new claim_transaction
 * permissions.
 *
 * Runs the same idempotent _myapi_building_admin_install() used by
 * hook_install(). By the time this runs, 'claim_transaction' already exists
 * on the site (SPEC 55's myapi_update_7017() created the bundle), and
 * myapi_building_admin_editable_types() already lists it once
 * node_type_load('claim_transaction') resolves — the code changes of SPEC 56
 * did that, not this update. So this is a single call: no schema, no field,
 * just the two permissions ('create claim_transaction content', 'edit any
 * claim_transaction content') the newly-editable type is now entitled to.
 *
 * Re-running it grants nothing twice: the installer only adds what is
 * missing from role_permission and never revokes.
 */
function myapi_update_7018() {
  _myapi_building_admin_install();
}

/**
 * SPEC 58: widens 'field_status_date' from day-only to day + hour + minute.
 *
 * The field is a Date module 'datetime' field, which already stores a full
 * DATETIME internally — day-only was a configuration constraint on the field
 * settings and on the widget, never on the schema. So this update rewrites
 * configuration only and touches no row of field_data_field_status_date:
 * existing transactions keep the exact value they were saved with (a '00:00'
 * time), which the timeline now displays as such.
 *
 * field_update_field() changes the field-wide 'granularity' setting (today
 * only 'claim_transaction' uses this field). field_update_instance() widens
 * the native 'date_select' widget of that same instance, so that the native
 * node/add/claim_transaction and node/%nid/edit forms offer hour and minute
 * selectors too. The 'reclamo' instance of field_reception_date is a
 * different field and is deliberately left alone.
 *
 * Re-running it is safe: both calls just write the same settings again.
 */
function myapi_update_7019() {
  $field = field_info_field('field_status_date');
  if (!$field) {
    return;
  }
  $field['settings']['granularity'] = array(
    'year'   => 'year',
    'month'  => 'month',
    'day'    => 'day',
    'hour'   => 'hour',
    'minute' => 'minute',
    'second' => 0,
  );
  field_update_field($field);

  $instance = field_info_instance('node', 'field_status_date', 'claim_transaction');
  if ($instance) {
    $instance['widget']['settings']['input_format'] = 'Y-m-d H:i';
    field_update_instance($instance);
  }
}

/**
 * SPEC 60: fills in the title of the 'claim_transaction' nodes saved without
 * one.
 *
 * Until SPEC 60, neither myapi_claim_transaction_create_form_submit() nor
 * myapi_claim_transaction_create_initial() (SPEC 57) wrote $node->title, and
 * node.title is NOT NULL DEFAULT '' — so those transactions were stored with an
 * empty title and show up as a blank link in /admin/content. From now on
 * hook_node_presave() titles every save; this rewrites the ones already on
 * disk, with the same myapi_claim_transaction_title() the presave uses.
 *
 * Only rows with title = '' are touched. The ones created through
 * node/add/claim_transaction carry a title an operator typed by hand before
 * this spec existed, and overwriting it would destroy information he put there
 * deliberately; they converge to the automatic format on their first save.
 *
 * db_update() and NOT node_load() + node_save(), deliberately: node_save()
 * fires hook_node_update(), whose 'claim_transaction' branch (SPEC 57) syncs
 * the PARENT CLAIM's field_status with the saved transaction's. Re-saving old
 * transactions in arbitrary order would leave every claim carrying the status
 * of whichever of its transactions was processed last — silent data corruption
 * in exchange for a title. Writing the column directly touches no field and
 * fires no hook.
 *
 * Both node.title and node_revision.title are written: in D7 node_load() reads
 * the title off the active revision, while listings and most queries read
 * node.title, so updating only one of the two leaves the site showing the value
 * in some places and the empty string in others. The bundle has no revisions
 * enabled (variable node_options_claim_transaction is ['status'], see
 * _myapi_reservations_ensure_node_type()), so n.vid is the only revision there
 * is.
 *
 * Re-running it is a no-op: after the first pass no row matches title = ''.
 *
 * @return string
 *   Message drush updb prints, with how many rows were filled in.
 */
function myapi_update_7020() {
  module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
  module_load_include('inc', 'myapi', 'includes/myapi.claims_admin');

  $query = db_select('node', 'n')
    ->fields('n', array('nid', 'vid'))
    ->condition('n.type', 'claim_transaction')
    ->condition('n.title', '');

  // Same LEFT JOIN criterion as myapi_claim_transaction_timeline_rows(): a
  // transaction missing one of these values still gets a title, built out of
  // whatever it does have.
  $query->leftJoin('field_data_field_claim', 'fcl', "fcl.entity_id = n.nid AND fcl.entity_type = 'node' AND fcl.deleted = 0");
  $query->addField('fcl', 'field_claim_target_id', 'claim_nid');

  $query->leftJoin('field_data_field_status', 'fs', "fs.entity_id = n.nid AND fs.entity_type = 'node' AND fs.deleted = 0");
  $query->addField('fs', 'field_status_value', 'status');

  $query->leftJoin('field_data_field_status_date', 'fsd', "fsd.entity_id = n.nid AND fsd.entity_type = 'node' AND fsd.deleted = 0");
  $query->addField('fsd', 'field_status_date_value', 'status_date');

  $query->leftJoin('field_data_field_comment', 'fcm', "fcm.entity_id = n.nid AND fcm.entity_type = 'node' AND fcm.deleted = 0");
  $query->addField('fcm', 'field_comment_value', 'comment');

  $options = myapi_claims_status_options();
  $updated = 0;

  foreach ($query->execute() as $row) {
    $title = myapi_claim_transaction_title(
      $row->claim_nid,
      ($row->status !== NULL && isset($options[$row->status])) ? $options[$row->status] : $row->status,
      $row->status_date,
      $row->comment
    );

    db_update('node')
      ->fields(array('title' => $title))
      ->condition('nid', $row->nid)
      ->execute();

    db_update('node_revision')
      ->fields(array('title' => $title))
      ->condition('vid', $row->vid)
      ->execute();

    $updated++;
  }

  if ($updated) {
    // The rows were written behind Drupal's back, so anything already loaded in
    // this request still carries the empty title.
    entity_get_controller('node')->resetCache();
  }

  return t('Se generó el título de @count transacciones de reclamo que estaban guardadas sin título.', array('@count' => $updated));
}

/**
 * SPEC 62: drops 'duplicated' from the field_status catalogue.
 *
 * field_status is a single list_text field shared by 'reclamo' and
 * 'claim_transaction' (SPEC 55), so removing the value from its field-level
 * allowed_values takes it out of both bundles at once — the claim's status
 * select, the transaction's, the listing filter and the timeline.
 *
 * The rows are rewritten BEFORE field_update_field(), and that order is not
 * cosmetic: core's options module implements hook_field_update_forbid() and
 * throws FieldUpdateForbiddenException when an allowed value that still has
 * data is removed, which would abort the update halfway. In practice this
 * migration finds nothing — the status was never used on the site this spec was
 * written for — but a `drush updb` that fails on a value somebody selected once
 * by hand is exactly the failure mode worth spending five lines on. 'closed' is
 * the destination because a duplicate claim is, in the end, a closed one.
 *
 * Both field_data_ and field_revision_ are written: Field API reads the data
 * table, but a bundle with revisions enabled would otherwise keep the dead
 * value in its history and re-forbid the change on a later run. Neither claims
 * bundle has revisions today (node_options_* is ['status']), so in practice the
 * second write mirrors the first.
 *
 * A side effect stated out loud: a 'claim_transaction' migrated this way keeps
 * the title it was saved with (SPEC 60 stores the status LABEL inside
 * node.title), so it may still read «Duplicado» until it is saved again. Titles
 * are not rewritten here — the same reasoning as myapi_update_7020(), where
 * re-saving transactions in bulk would make each one re-sync its parent claim's
 * status.
 *
 * Re-running it is a no-op: no row matches 'duplicated' any more and
 * field_update_field() just writes the same four values again.
 *
 * @return string
 *   A summary line, shown by drush and by update.php.
 */
function myapi_update_7021() {
  $migrated = 0;

  foreach (array('field_data_field_status', 'field_revision_field_status') as $table) {
    if (!db_table_exists($table)) {
      continue;
    }
    $count = db_update($table)
      ->fields(array('field_status_value' => 'closed'))
      ->condition('field_status_value', 'duplicated')
      ->execute();

    if ($table === 'field_data_field_status') {
      $migrated = $count;
    }
  }

  if ($migrated) {
    watchdog(
      'myapi',
      'SPEC 62: @count nodos que estaban en estado «Duplicado» pasaron a «Cerrado» antes de quitar el valor del catálogo.',
      array('@count' => $migrated),
      WATCHDOG_NOTICE
    );
    // The rows were written behind Drupal's back.
    entity_get_controller('node')->resetCache();
  }

  $field = field_read_field('field_status');
  if ($field) {
    $field['settings']['allowed_values'] = array(
      'received'    => 'Recibido',
      'in_progress' => 'En proceso',
      'resolved'    => 'Resuelto',
      'closed'      => 'Cerrado',
    );
    field_update_field($field);
    field_info_cache_clear();
  }

  return $migrated
    ? t('Estado «Duplicado» retirado del catálogo; @count nodos que lo tenían pasaron a «Cerrado».', array('@count' => $migrated))
    : t('Estado «Duplicado» retirado del catálogo. Ningún nodo lo tenía.');
}

/**
 * SPEC 63: widens 'field_reception_date' from day-only to day + hour + minute.
 *
 * Same shape, same reasoning and same idempotency as myapi_update_7019(), which
 * did this to field_status_date (SPEC 58) — the Date module 'datetime' field
 * already stores a full DATETIME, so day-only was a configuration constraint on
 * the field settings and on the widget, never on the schema. Configuration
 * only: not one row of field_data_field_reception_date is touched, and claims
 * saved before this update keep their stored '00:00', which the listing now
 * shows as such.
 *
 * field_update_field() changes the field-wide 'granularity' (today only
 * 'reclamo' uses this field); field_update_instance() widens the native
 * 'date_select' widget of that instance, so node/add/reclamo and
 * node/%nid/edit offer hour and minute selectors and prefill them with the
 * current time.
 *
 * Re-running it just writes the same settings again.
 */
function myapi_update_7022() {
  $field = field_info_field('field_reception_date');
  if (!$field) {
    return;
  }
  $field['settings']['granularity'] = array(
    'year'   => 'year',
    'month'  => 'month',
    'day'    => 'day',
    'hour'   => 'hour',
    'minute' => 'minute',
    'second' => 0,
  );
  field_update_field($field);

  $instance = field_info_instance('node', 'field_reception_date', 'reclamo');
  if ($instance) {
    $instance['widget']['settings']['input_format'] = 'Y-m-d H:i';
    field_update_instance($instance);
  }
}
