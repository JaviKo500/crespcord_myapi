      'alt_field'       => 0,
      'title_field'     => 0,
    ],
    'widget'      => ['type' => 'image_image'],
  ]);
  _myapi_reservations_ensure_instance('field_open_time', 'area', [
    'field_name'  => 'field_open_time',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Hora de apertura',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_close_time', 'area', [
    'field_name'  => 'field_close_time',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Hora de cierre',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_slot_minutes', 'area', [
    'field_name'    => 'field_slot_minutes',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Tamaño del bloque (min)',
    'required'      => 1,
    'description'   => 'Tamaño del bloque de reserva en minutos.',
    'default_value' => [['value' => 60]],
    'widget'        => ['type' => 'number'],
  ]);
  _myapi_reservations_ensure_instance('field_max_minutes', 'area', [
    'field_name'    => 'field_max_minutes',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Duración máxima (min)',
    'required'      => 1,
    'description'   => 'Duración máxima de una reserva en minutos.',
    'default_value' => [['value' => 120]],
    'widget'        => ['type' => 'number'],
  ]);
  _myapi_reservations_ensure_instance('field_area_status', 'area', [
    'field_name'    => 'field_area_status',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Estado del área',
    'required'      => 1,
    'default_value' => [['value' => 'active']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_who_can_reserve', 'area', [
    'field_name'    => 'field_who_can_reserve',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Quién puede reservar',
    'required'      => 1,
    'default_value' => [['value' => 'both']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_cancel_deadline_minutes', 'area', [
    'field_name'    => 'field_cancel_deadline_minutes',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Antelación mínima para cancelar (min)',
    'required'      => 1,
    'description'   => 'Minutos mínimos antes del inicio para poder cancelar.',
    'default_value' => [['value' => 120]],
    'widget'        => ['type' => 'number'],
  ]);
  _myapi_reservations_ensure_instance('field_area_category', 'area', [
    'field_name'    => 'field_area_category',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Categoría del área',
    'required'      => 1,
    'description'   => 'Categoría de catálogo del área; la app la usa como clave estable para elegir el icono.',
    'default_value' => [['value' => 'other']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_area_notes', 'area', [
    'field_name'    => 'field_area_notes',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Instrucciones o notas',
    'required'      => 0,
    'description'   => 'Instrucciones, normas o detalles del área que la app muestra al residente antes de reservar. Admite HTML.',
    'settings'      => ['text_processing' => 1],
    // No 'format' key on purpose. Pinning it to 'full_html' — as this instance
    // did until SPEC 49 — hands that exact format to every user on
    // node/add/area, and Drupal renders the whole textarea DISABLED for anyone
    // without 'use text format full_html'. That is how the building-admin role
    // found it: the field was blocked on create and fine on edit, because an
    // existing node carries its own stored format.
    //
    // With the key absent, filter_process_format() falls back to
    // filter_default_format(), i.e. the best format each user is actually
    // allowed to write with. Sites created before this change are migrated by
    // myapi_update_7013(); myapi_update_7008(), which first created this
    // instance, is left untouched — it already ran in production and rewriting
    // an executed update would only make the two disagree.
    'default_value' => [['value' => '']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_concurrent_reservations', 'area', [
    'field_name'    => 'field_concurrent_reservations',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Reservas simultáneas permitidas',
    'required'      => 0,
    'description'   => 'Número de reservas que pueden coincidir en el mismo horario. Vacío o menor que 1 se interpreta como 1.',
    'default_value' => [['value' => 1]],
    'widget'        => ['type' => 'number'],
  ]);

  // (c) Instances of the 'reservation' bundle.
  _myapi_reservations_ensure_instance('field_condominium', 'reservation', [
    'field_name'  => 'field_condominium',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Condominio',
    'required'    => 1,
    // Same field as the 'area' instance above, and the selection settings are
    // shared with it because they are field-level. See the catalogue.
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_unit', 'reservation', [
    'field_name'  => 'field_unit',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Vivienda',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_requester', 'reservation', [
    'field_name'  => 'field_requester',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Solicitante',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_area', 'reservation', [
    'field_name'  => 'field_area',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Área',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_date', 'reservation', [
    'field_name'  => 'field_date',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Fecha',
    'required'    => 1,
    'widget'      => [
      'type'     => 'date_select',
      'settings' => [
        'input_format'   => 'Y-m-d',
        'year_range'     => '-1:+3',
        'increment'      => 1,
        'label_position' => 'above',
        'text_parts'     => [],
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_start_time', 'reservation', [
    'field_name'  => 'field_start_time',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Hora de inicio',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_end_time', 'reservation', [
    'field_name'  => 'field_end_time',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Hora de fin',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_reservation_status', 'reservation', [
    'field_name'    => 'field_reservation_status',
    'entity_type'   => 'node',
    'bundle'        => 'reservation',
    'label'         => 'Estado de la reserva',
    'required'      => 1,
    'default_value' => [['value' => 'confirmed']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_cancelled_by', 'reservation', [
    'field_name'  => 'field_cancelled_by',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Cancelada por',
    'required'    => 0,
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_cancel_reason', 'reservation', [
    'field_name'  => 'field_cancel_reason',
    'entity_type' => 'node',
    'bundle'      => 'reservation',
    'label'       => 'Motivo de cancelación',
    'required'    => 0,
    'description' => 'Opcional. Se muestra al residente cuando la reserva se cancela.',
    'widget'      => ['type' => 'text_textfield'],
  ]);
}

/**
 * Creates the 'administrador edificio' role, its field and its permissions
 * (idempotent, SPEC 49).
 *
 * Single source of truth for that role's installation: called both from
 * hook_install() (fresh sites) and from myapi_update_7012() (already installed
 * sites). Re-running it never duplicates the role, the field, the instance nor
 * a role_permission row.
 *
 * Deliberately CONSERVATIVE: it creates what is missing and never revokes nor
 * deletes. An administrator may have adjusted permissions by hand in
 * production, and a `drush updb` must not undo that. The accepted trade-off is
 * the other way round: re-running the update DOES grant again anything that
 * was revoked by hand.
 *
 * Three parts, in this order:
 * (a) the role, looked up by name because the rid is per environment;
 * (b) the user field, with the same _ensure_field()/_ensure_instance() pair
 *     the reservations model uses;
 * (c) the permissions, crossed against the ones that actually exist on the
 *     site so nothing dead is written into role_permission.
 */
function _myapi_building_admin_install() {
  // Functions of a files[] .inc are not autoloaded by the D7 registry, and an
  // .install runs early enough that the registry may not be warm anyway, so
  // the include is explicit.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  // (a) The role. user_role_save() would happily create a second role with the
  // same name, so the lookup is what makes this idempotent. The rid it gets is
  // never read: every check in the module compares role NAMES.
  $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  if (!$role) {
    $role = new stdClass();
    $role->name = MYAPI_BUILDING_ADMIN_ROLE;
    user_role_save($role);
    // user_role_save() writes the new rid back onto the object, but a reload
    // is cheaper to reason about than trusting that side effect.
    $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  }

  if (!$role) {
    // Nothing else can be done without a role to grant to. Loud rather than
    // silent: the permissions below would otherwise fail one by one.
    watchdog(
      'myapi',
      'SPEC 49: the role "@role" could not be created; its field and permissions were skipped.',
      ['@role' => MYAPI_BUILDING_ADMIN_ROLE],
      WATCHDOG_ERROR
    );
    return;
  }

  // (b) The user field: entityreference to 'condominio' nodes, unlimited
  // cardinality, one instance on the single bundle of the user entity. The
  // Field API creates field_data_field_condominio_admin and its revision table
  // with entity_type = 'user'.
  //
  // 'target_type', the handler and the target_bundles that restrict the
  // autocomplete to condominiums are ALL field-level settings in D7
  // entityreference, so all three come from the shared catalogue. Writing them
  // on the instance — which is what this did until SPEC 53 — leaves the handler
  // with no bundle condition and the tags autocomplete of /user/N/edit offers
  // every node of the site.
  $reference_settings = _myapi_entityreference_field_settings();

  _myapi_reservations_ensure_field(MYAPI_BUILDING_ADMIN_CONDO_FIELD, [
    'field_name'  => MYAPI_BUILDING_ADMIN_CONDO_FIELD,
    'type'        => 'entityreference',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings'    => $reference_settings[MYAPI_BUILDING_ADMIN_CONDO_FIELD],
  ]);
  _myapi_reservations_ensure_instance(MYAPI_BUILDING_ADMIN_CONDO_FIELD, 'user', [
    'field_name'  => MYAPI_BUILDING_ADMIN_CONDO_FIELD,
    'entity_type' => 'user',
    'bundle'      => 'user',
    'label'       => 'Condominios administrados',
    'required'    => 0,
    'description' => 'Condominios que este usuario puede administrar. Solo aplica al rol "administrador edificio"; sin ningún condominio, no verá contenido alguno.',
    'widget'      => ['type' => 'entityreference_autocomplete_tags'],
  ], 'user');

  // (c) The permissions. module_invoke_all('permission') returns
  // permission name => definition, so its KEYS are the permissions that exist
  // on this site right now. Crossing against them drops 'create reclamo
  // content' while the claims bundle does not exist and 'access toolbar' when
  // the toolbar module is disabled — instead of writing rows in
  // role_permission that no screen can ever show or revoke.
  //
  // user_role_grant_permissions() is itself idempotent: it merges, so granting
  // the same permission twice leaves one row.
  $available = array_keys(module_invoke_all('permission'));
  $granted = myapi_building_admin_filter_available_permissions(
    myapi_building_admin_permissions(),
    $available
  );

  if ($granted) {
    user_role_grant_permissions($role->rid, $granted);
  }
}

/**
 * Creates the 'proveedor' role and its permissions (idempotent, SPEC 78).
 *
 * Single source of truth for that role's installation: called both from
 * hook_install() (fresh sites) and from myapi_update_7026() (already installed
 * sites). Re-running it never duplicates the role nor a role_permission row.
 *
 * No field is created here, unlike _myapi_building_admin_install(): the role
 * is scoped by belonging (field_provider_users, already created by SPEC 77 on
 * the 'provider' bundle) and by category, neither of which needs a new field
 * on the user entity.
 *
 * Two parts, in this order:
 * (a) the role, looked up by name because the rid is per environment;
 * (b) the permissions, crossed against the ones that actually exist on the
 *     site. myapi_provider_role_permissions() is empty by design (see its
 *     docblock), so the real effect today is "create the role and grant
 *     nothing" — written in full anyway, so this is the one place something
 *     gets added the day that decision changes.
 *
 * Deliberately CONSERVATIVE, same criterion as the role next to it: creates
 * what is missing and never revokes nor deletes.
 */
function _myapi_provider_role_install() {
  // Functions of a files[] .inc are not autoloaded by the D7 registry, and an
  // .install runs early enough that the registry may not be warm anyway, so
  // the include is explicit.
  module_load_include('inc', 'myapi', 'includes/myapi.provider_role');
  // myapi_building_admin_filter_available_permissions() is reused from here
  // rather than duplicated (SPEC 78's own "Decisiones" table), so its file
  // has to be loaded explicitly too — call order in myapi_install() puts this
  // installer BEFORE _myapi_building_admin_install(), so nothing else is
  // guaranteed to have loaded it yet.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  // (a) The role. user_role_save() would happily create a second role with the
  // same name, so the lookup is what makes this idempotent. The rid it gets is
  // never read: every check in the module compares role NAMES.
  $role = user_role_load_by_name(MYAPI_PROVIDER_ROLE);
  if (!$role) {
    $role = new stdClass();
    $role->name = MYAPI_PROVIDER_ROLE;
    user_role_save($role);
    // user_role_save() writes the new rid back onto the object, but a reload
    // is cheaper to reason about than trusting that side effect.
    $role = user_role_load_by_name(MYAPI_PROVIDER_ROLE);
  }

  if (!$role) {
    // Nothing else can be done without a role to grant to. Loud rather than
    // silent: the permissions below would otherwise fail one by one.
    watchdog(
      'myapi',
      'SPEC 78: the role "@role" could not be created; its permissions were skipped.',
      ['@role' => MYAPI_PROVIDER_ROLE],
      WATCHDOG_ERROR
    );
    return;
  }

  // (b) The permissions. module_invoke_all('permission') returns
  // permission name => definition, so its KEYS are the permissions that exist
  // on this site right now. With an empty catalogue this crosses an empty list
  // against it and grants nothing — the function still runs so the day the
  // catalogue grows, nothing else has to change here.
  $available = array_keys(module_invoke_all('permission'));
  $granted = myapi_building_admin_filter_available_permissions(
    myapi_provider_role_permissions(),
    $available
  );

  if ($granted) {
    user_role_grant_permissions($role->rid, $granted);
  }
}

/**
 * Creates the claims content types, fields and instances (idempotent, SPEC 55).
 *
 * Single source of truth for the claims schema, called both from
 * hook_install() (fresh sites) and from myapi_update_7017() (already installed
 * sites). Re-running it never duplicates anything nor throws, because every
 * creation goes through the same idempotent _ensure_* sub-helpers the
 * reservations model uses (SPEC 32) — no sub-helper is added by this function.
 *
 * Order: (a) the two node types; (b) every field at the storage level
 * (field_images and field_attachment created once, shared by both bundles;
 * field_status created once, shared by both bundles); (c) the per-bundle
 * instances, including the new instances of field_condominium and
 * field_requester on 'reclamo' (fields themselves already exist since SPEC 32
 * and are not recreated here).
 *
 * entityreference note: field_claim's 'target_type', 'handler' and
 * 'handler_settings.target_bundles' come from
 * _myapi_entityreference_field_settings(), same as every other entityreference
 * field in this module — never written on the instance.
 *
 * field_status note: ONE field shared by both bundles, because their
 * allowed_values are identical (unlike field_area_status /
 * field_reservation_status in SPEC 32, which differed). Only the instance
 * default_value differs: 'received' on 'reclamo', none on 'claim_transaction'
 * — Field API allows that without any special handling.
 */
function _myapi_claims_install() {
  // MYAPI_BUILDING_ADMIN_CLAIM_TYPE lives in the role's include. Explicit,
  // like every other use of it in this file: an .install runs early enough
  // that the D7 registry may not have the files[] entries warm.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $claim_type = MYAPI_BUILDING_ADMIN_CLAIM_TYPE;
  $transaction_type = 'claim_transaction';

  // (a) Content types.
  _myapi_reservations_ensure_node_type(
    $claim_type,
    'Reclamo',
    'Reclamo o requerimiento presentado por un residente.',
    'Asunto'
  );
  _myapi_reservations_ensure_node_type(
    $transaction_type,
    'Transacción de reclamo',
    'Entrada de la línea de tiempo de un reclamo: cambio de estado con comentario opcional del administrador.',
    'Título'
  );

  // (b) Fields (storage level).
  //
  // field_claim's whole 'settings' comes from the catalogue: that is where the
  // referenceable bundle ('reclamo') is decided, and the selection handler
  // reads it from the field, not from the instance.
  $reference_settings = _myapi_entityreference_field_settings();

  // The two file fields are born PRIVATE (SPEC 65). Drupal's default for a
  // file or image field is 'public', which is what SPEC 55 created them with
  // and what myapi_update_7023() migrates away from; a fresh site never runs
  // that update, so without these two lines it would be installed with the
  // very hole the update exists to close. The uri_scheme belongs to the field
  // (storage), not to the instance, which is why it is set here and not below.
  //
  // _myapi_reservations_ensure_field() only creates a field that is missing,
  // so on an already-installed site these two lines are a no-op and the change
  // is applied by the update instead.
  _myapi_reservations_ensure_field('field_images', [
    'field_name'  => 'field_images',
    'type'        => 'image',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings'    => ['uri_scheme' => 'private'],
  ]);
  _myapi_reservations_ensure_field('field_attachment', [
    'field_name'  => 'field_attachment',
    'type'        => 'file',
    'cardinality' => 1,
    'settings'    => ['uri_scheme' => 'private'],
  ]);
  _myapi_reservations_ensure_field('field_description', [
    'field_name'  => 'field_description',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_status', [
    'field_name'  => 'field_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'received'    => 'Recibido',
        'in_progress' => 'En proceso',
        'resolved'    => 'Resuelto',
        'closed'      => 'Cerrado',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_claim_type', [
    'field_name'  => 'field_claim_type',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'requirement' => 'Requerimiento',
        'claim'       => 'Reclamo',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_reception_date', [
    'field_name'  => 'field_reception_date',
    'type'        => 'datetime',
    'cardinality' => 1,
    'settings'    => [
      // Day + hour + minute since SPEC 63, same granularity field_status_date
      // got in SPEC 58: a claim records the instant it was received, not that
      // day at midnight.
      'granularity' => [
        'year'   => 'year',
        'month'  => 'month',
        'day'    => 'day',
        'hour'   => 'hour',
        'minute' => 'minute',
        'second' => 0,
      ],
      'tz_handling' => 'none',
      'timezone_db' => '',
      'todate'      => '',
    ],
  ]);
  _myapi_reservations_ensure_field('field_visibility', [
    'field_name'  => 'field_visibility',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'private' => 'Privado',
        'public'  => 'Público',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_status_date', [
    'field_name'  => 'field_status_date',
    'type'        => 'datetime',
    'cardinality' => 1,
    'settings'    => [
      'granularity' => [
        'year'   => 'year',
        'month'  => 'month',
        'day'    => 'day',
        'hour'   => 'hour',
        'minute' => 'minute',
        'second' => 0,
      ],
      'tz_handling' => 'none',
      'timezone_db' => '',
      'todate'      => '',
    ],
  ]);
  _myapi_reservations_ensure_field('field_comment', [
    'field_name'  => 'field_comment',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_claim', [
    'field_name'  => 'field_claim',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_claim'],
  ]);

  // (c) Instances of the 'reclamo' bundle.
  _myapi_reservations_ensure_instance('field_condominium', $claim_type, [
    'field_name'  => 'field_condominium',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Condominio',
    'required'    => 1,
    // No 'settings' here on purpose: the referenceable bundle is a field-level
    // setting and lives in _myapi_entityreference_field_settings().
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_requester', $claim_type, [
    'field_name'  => 'field_requester',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Solicitante',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_description', $claim_type, [
    'field_name'    => 'field_description',
    'entity_type'   => 'node',
    'bundle'        => $claim_type,
    'label'         => 'Descripción',
    'required'      => 1,
    'settings'      => ['text_processing' => 1],
    // 'plain_text' is pinned on purpose, unlike field_area_notes (SPEC 32),
    // whose 'format' key was removed by myapi_update_7013() because pinning
    // 'full_html' disabled the textarea for anyone without that format. Plain
    // text is available to every user, so no such problem exists here.
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_status', $claim_type, [
    'field_name'    => 'field_status',
    'entity_type'   => 'node',
    'bundle'        => $claim_type,
    'label'         => 'Estado',
    'required'      => 1,
    'default_value' => [['value' => 'received']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_claim_type', $claim_type, [
    'field_name'  => 'field_claim_type',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Tipo',
    'required'    => 1,
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_reception_date', $claim_type, [
    'field_name'  => 'field_reception_date',
    'entity_type' => 'node',
    'bundle'      => $claim_type,
    'label'       => 'Fecha de recepción',
    'required'    => 1,
    'widget'      => [
      'type'     => 'date_select',
      'settings' => [
        'input_format'   => 'Y-m-d H:i',
        'year_range'     => '-1:+3',
        'increment'      => 1,
        'label_position' => 'above',
        'text_parts'     => [],
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_visibility', $claim_type, [
    'field_name'    => 'field_visibility',
    'entity_type'   => 'node',
    'bundle'        => $claim_type,
    'label'         => 'Visibilidad',
    'required'      => 1,
    'default_value' => [['value' => 'private']],
    'widget'        => ['type' => 'options_select'],
  ]);

  // (c) Instances of the 'claim_transaction' bundle.
  _myapi_reservations_ensure_instance('field_status', $transaction_type, [
    'field_name'  => 'field_status',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Estado',
    'required'    => 1,
    // No 'default_value' here on purpose, unlike the 'reclamo' instance above:
    // a transaction always records a deliberately chosen new status.
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_status_date', $transaction_type, [
    'field_name'  => 'field_status_date',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Fecha del estado',
    'required'    => 1,
    'widget'      => [
      'type'     => 'date_select',
      'settings' => [
        'input_format'   => 'Y-m-d H:i',
        'year_range'     => '-1:+3',
        'increment'      => 1,
        'label_position' => 'above',
        'text_parts'     => [],
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_comment', $transaction_type, [
    'field_name'    => 'field_comment',
    'entity_type'   => 'node',
    'bundle'        => $transaction_type,
    'label'         => 'Comentario',
    'required'      => 0,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_claim', $transaction_type, [
    'field_name'  => 'field_claim',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Reclamo',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);

  // (c) Instances of field_images and field_attachment, identical on both
  // bundles (same rule, same limits — see the docblock above).
  $images_settings = [
    'file_extensions'    => 'png jpg jpeg',
    'max_filesize'       => '3 MB',
    // Alt text is offered but not required — distinct from field_image on
    // 'area' (SPEC 32), which disables it entirely (alt_field = 0).
    'alt_field'          => 1,
    'alt_field_required' => 0,
  ];
  $attachment_settings = [
    'file_extensions' => 'pdf doc docx xls xlsx',
    'max_filesize'    => '3 MB',
  ];

  foreach ([$claim_type, $transaction_type] as $bundle) {
    _myapi_reservations_ensure_instance('field_images', $bundle, [
      'field_name'  => 'field_images',
      'entity_type' => 'node',
      'bundle'      => $bundle,
      'label'       => 'Imágenes',
      'required'    => 0,
      'settings'    => $images_settings,
      'widget'      => ['type' => 'image_image'],
    ]);
    _myapi_reservations_ensure_instance('field_attachment', $bundle, [
      'field_name'  => 'field_attachment',
      'entity_type' => 'node',
      'bundle'      => $bundle,
      'label'       => 'Adjunto',
      'required'    => 0,
      'settings'    => $attachment_settings,
      'widget'      => ['type' => 'file_generic'],
    ]);
  }
}

/**
 * Ensures a taxonomy vocabulary exists (idempotent).
 *
 * The counterpart of _myapi_reservations_ensure_node_type() for vocabularies,
 * and the first one this module needs: the banks vocabulary (SPEC 76) is READ
 * by an endpoint but created by hand on the site, while service_category
 * (SPEC 77) is part of this module's schema and has fields of its own.
 *
 * taxonomy_vocabulary_machine_name_load() answers FALSE for a machine name
 * that is not there, which is the whole check. A vocabulary that already
 * exists is left exactly as it is — its name, description and hierarchy may
 * have been adjusted on the site, and this is not the place to overrule that.
 *
 * @param string $machine_name
 *   Machine name of the vocabulary (e.g. 'service_category').
 * @param string $name
 *   Human name shown in the admin UI.
 * @param string $description
 *   Admin description.
 */
function _myapi_services_ensure_vocabulary($machine_name, $name, $description) {
  if (taxonomy_vocabulary_machine_name_load($machine_name)) {
    return;
  }

  $vocabulary = (object) [
    'name'         => $name,
    'machine_name' => $machine_name,
    'description'  => $description,
    // Flat: the marketplace has categories, not sub-categories.
    'hierarchy'    => 0,
    'module'       => 'taxonomy',
    'weight'       => 0,
  ];

  taxonomy_vocabulary_save($vocabulary);
}

/**
 * Creates the services marketplace schema (idempotent) — SPEC 77.
 *
 * Called from hook_install() on fresh sites and from myapi_update_7025() where
 * the module is already installed, exactly like _myapi_reservations_install()
 * and _myapi_claims_install(). Re-running it never duplicates anything nor
 * throws, because every creation goes through the idempotent _ensure_*
 * sub-helpers — no new sub-helper here except the vocabulary one, which had no
 * equivalent.
 *
 * Order matters and is not cosmetic:
 *   (a) the vocabulary and its two fields — the category reference fields of
 *       the bundles below name it in their allowed_values;
 *   (b) the five node types, in the order of myapi_services_node_types(). An
 *       entityreference field names a target bundle, and a bundle that does
 *       not exist yet leaves the autocomplete resolving nothing;
 *   (c) every field at storage level, the shared ones included;
 *   (d) the per-bundle instances.
 *
 * Five fields are REUSED rather than created, each with a new instance and no
 * change to the field itself: field_requester and field_condominium (SPEC 32),
 * field_description, field_images and field_attachment (SPEC 55/65 — the last
 * two are private:// at field level, so the photos of a request are born
 * private for the same reason a claim's are), plus field_status_date and
 * field_comment on the timeline bundle.
 *
 * entityreference note, same as the two installers above: 'target_type',
 * 'handler' and 'handler_settings' are FIELD-level settings, so they come from
 * _myapi_entityreference_field_settings() and never appear on an instance.
 *
 * What this does NOT do, deliberately (see the spec's out-of-scope list): no
 * api/v1 route, no permission granted to any role, no entry in
 * myapi_building_admin_condominium_map(), no auto-generated titles, no
 * form_alter hiding the denormalised fields, and no validation of the status
 * graph — myapi_services_request_transitions() exists but nothing reads it
 * yet.
 */
function _myapi_services_install() {
  // The bundle names and the status catalogues. Explicit load, like every
  // other include used from this file: an .install runs early enough that the
  // D7 registry may not have the files[] entries warm.
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');

  $provider_type    = MYAPI_SERVICES_PROVIDER_TYPE;
  $request_type     = MYAPI_SERVICES_REQUEST_TYPE;
  $offer_type       = MYAPI_SERVICES_OFFER_TYPE;
  $rating_type      = MYAPI_SERVICES_RATING_TYPE;
  $transaction_type = MYAPI_SERVICES_TRANSACTION_TYPE;

  // (a) The category vocabulary and its own fields.
  _myapi_services_ensure_vocabulary(
    MYAPI_SERVICES_CATEGORY_VOCABULARY,
    'Categoría de servicio',
    'Categorías del marketplace de proveedores: limpieza, mantenimiento, arreglos, compras, servicios generales.'
  );

  // The provider tag vocabulary (SPEC 81). No fields and no instances of its
  // own, unlike the category one above: a tag is painted and nothing else, so
  // there is no stable code for the app to hang logic on. It is born empty —
  // the terms appear as the operator types them into the provider form, which
  // the taxonomy_autocomplete widget of field_tags creates natively.
  _myapi_services_ensure_vocabulary(
    MYAPI_SERVICES_TAG_VOCABULARY,
    'Etiqueta de proveedor',
    'Etiquetas libres de proveedores: urgencias, 24h, soldadura, garantía... Se crean solas al escribirlas en la ficha del proveedor.'
  );

  _myapi_reservations_ensure_field('field_category_code', [
    'field_name'  => 'field_category_code',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 32],
  ]);
  // The category icon is the one image of this feature that is PUBLIC, and the
  // exception is deliberate: it is a catalogue asset shown in the app's
  // category grid, identical for every user and revealing nothing about
  // anybody. The photos of a request (field_images) stay private:// because
  // they may show the inside of a home.
  _myapi_reservations_ensure_field('field_category_icon', [
    'field_name'  => 'field_category_icon',
    'type'        => 'image',
    'cardinality' => 1,
    'settings'    => ['uri_scheme' => 'public'],
  ]);

  _myapi_reservations_ensure_instance('field_category_code', MYAPI_SERVICES_CATEGORY_VOCABULARY, [
    'field_name'  => 'field_category_code',
    'entity_type' => 'taxonomy_term',
    'bundle'      => MYAPI_SERVICES_CATEGORY_VOCABULARY,
    'label'       => 'Código',
    'required'    => 1,
    'description' => 'Identificador estable que viaja en la API (mayúsculas, sin espacios: CLEANING, MAINTENANCE...). El tid cambia si se reimporta el vocabulario; este código no.',
    'widget'      => ['type' => 'text_textfield'],
  ], 'taxonomy_term');
  _myapi_reservations_ensure_instance('field_category_icon', MYAPI_SERVICES_CATEGORY_VOCABULARY, [
    'field_name'  => 'field_category_icon',
    'entity_type' => 'taxonomy_term',
    'bundle'      => MYAPI_SERVICES_CATEGORY_VOCABULARY,
    'label'       => 'Ícono',
    'required'    => 0,
    'settings'    => [
      'file_extensions'    => 'png jpg jpeg',
      'max_filesize'       => '1 MB',
      'alt_field'          => 1,
      'alt_field_required' => 0,
    ],
    'widget'      => ['type' => 'image_image'],
  ], 'taxonomy_term');

  // (b) The five node types.
  _myapi_reservations_ensure_node_type(
    $provider_type,
    'Proveedor',
    'Empresa o persona que ofrece servicios en el marketplace.',
    'Nombre comercial'
  );
  _myapi_reservations_ensure_node_type(
    $request_type,
    'Solicitud de servicio',
    'Pedido de servicio creado por un residente y difundido a los proveedores de la categoría.',
    'Título'
  );
  _myapi_reservations_ensure_node_type(
    $offer_type,
    'Oferta',
    'Propuesta de un proveedor sobre una solicitud de servicio.',
    'Título'
  );
  _myapi_reservations_ensure_node_type(
    $rating_type,
    'Calificación de servicio',
    'Valoración del residente sobre el proveedor adjudicado, al cerrar la solicitud.',
    'Título'
  );
  _myapi_reservations_ensure_node_type(
    $transaction_type,
    'Transacción de solicitud',
    'Entrada de la línea de tiempo de una solicitud: cambio de estado con comentario opcional.',
    'Título'
  );

  // (c) Fields (storage level).
  $reference_settings = _myapi_entityreference_field_settings();

  // The taxonomy reference settings of both category fields. Two fields and
  // not one shared: 'the categories a provider works in' is unlimited and 'the
  // category of a request' is exactly one, and cardinality is a field
  // property — a single shared field could not be both.
  $category_settings = [
    'allowed_values' => [
      [
        'vocabulary' => MYAPI_SERVICES_CATEGORY_VOCABULARY,
        'parent'     => 0,
      ],
    ],
  ];

  // The taxonomy reference settings of field_tags (SPEC 81). Written right here
  // and not next to its field so the two allowed_values can be read side by
  // side: they differ in exactly one word — the vocabulary — and confusing them
  // would point the free tags at the closed category catalogue.
  $tag_settings = [
    'allowed_values' => [
      [
        'vocabulary' => MYAPI_SERVICES_TAG_VOCABULARY,
        'parent'     => 0,
      ],
    ],
  ];

  // Every date field of this feature is 'datestamp' (a Unix timestamp), by
  // explicit decision: the app sends and receives instants and converts to
  // local time itself. It diverges from the 'datetime' of SPEC 55/32, and the
  // one date field this feature does NOT create — field_status_date, reused on
  // the timeline bundle — stays 'datetime' precisely because it already
  // exists and is shared with claim_transaction.
  //
  // Granularity is down to the minute everywhere, licence expiry included.
  // Day-only granularity would store 00:00 of the expiry day, so a licence
  // "expiring on the 31st" would in fact die as the 30th ended — an off-by-one
  // day nobody would suspect until a provider was locked out.
  $timestamp_settings = [
    'granularity' => [
      'year'   => 'year',
      'month'  => 'month',
      'day'    => 'day',
      'hour'   => 'hour',
      'minute' => 'minute',
      'second' => 0,
    ],
    'tz_handling' => 'none',
    'timezone_db' => '',
    'todate'      => '',
  ];
  $date_widget = [
    'type'     => 'date_select',
    'settings' => [
      'input_format'   => 'Y-m-d H:i',
      'year_range'     => '-1:+5',
      'increment'      => 1,
      'label_position' => 'above',
      'text_parts'     => [],
    ],
  ];

  // Own fields of 'provider'.
  _myapi_reservations_ensure_field('field_provider_users', [
    'field_name'  => 'field_provider_users',
    'type'        => 'entityreference',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings'    => $reference_settings['field_provider_users'],
  ]);
  _myapi_reservations_ensure_field('field_phone', [
    'field_name'  => 'field_phone',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 20],
  ]);
  _myapi_reservations_ensure_field('field_address', [
    'field_name'  => 'field_address',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_services_desc', [
    'field_name'  => 'field_services_desc',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_license_expiry', [
    'field_name'  => 'field_license_expiry',
    'type'        => 'datestamp',
    'cardinality' => 1,
    'settings'    => $timestamp_settings,
  ]);
  _myapi_reservations_ensure_field('field_categories', [
    'field_name'  => 'field_categories',
    'type'        => 'taxonomy_term_reference',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings'    => $category_settings,
  ]);
  // The two denormalised rating counters. They exist so the category listing
  // does not run an AVG() per provider row; nothing writes them in SPEC 77 —
  // the hooks that recalculate them belong to the rating flow spec, and until
  // then they are simply empty.
  _myapi_reservations_ensure_field('field_rating_avg', [
    'field_name'  => 'field_rating_avg',
    'type'        => 'number_decimal',
    'cardinality' => 1,
    // 3,2 holds 0.00 to 9.99, which covers a 1-5 average exactly.
    'settings'    => ['precision' => 3, 'scale' => 2],
  ]);
  _myapi_reservations_ensure_field('field_rating_count', [
    'field_name'  => 'field_rating_count',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  // The three fields of SPEC 81. All optional at instance level, which is what
  // keeps the providers already loaded on the site valid.
  //
  // 10,2 is the size of field_offer_amount, the other monetary field of this
  // feature: up to 99999999.99. It deliberately does NOT copy the 3,2 of
  // field_rating_avg, which is dimensioned for a 1-5 average. Decimal and not
  // float because this is money: 0.1 + 0.2 is not 0.3 in binary floating point.
  _myapi_reservations_ensure_field('field_hourly_rate', [
    'field_name'  => 'field_hourly_rate',
    'type'        => 'number_decimal',
    'cardinality' => 1,
    'settings'    => ['precision' => 10, 'scale' => 2],
  ]);
  // Free tags over the provider_tag vocabulary. Unlimited by decision: a cap in
  // the field becomes a hook_update_N the day someone needs one more, so if a
  // maximum is ever needed it goes where the experience is decided — the form
  // or the endpoint — and not in the storage.
  _myapi_reservations_ensure_field('field_tags', [
    'field_name'  => 'field_tags',
    'type'        => 'taxonomy_term_reference',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings'    => $tag_settings,
  ]);
  // One line for the marketplace listing. 255 and 'text' (not 'text_long') is
  // the restriction that makes the field do its job: field_services_desc is
  // already the long one, and two long fields would leave nobody knowing which
  // goes on the card. No text_processing: there is no markup to filter on a
  // single line, same as field_phone and field_category_code.
  _myapi_reservations_ensure_field('field_short_description', [
    'field_name'  => 'field_short_description',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 255],
  ]);
  // The gallery of SPEC 82, which replaces the public field_photo deleted by
  // myapi_update_7029(). It is born PRIVATE: every image goes through PHP and
  // through an access decision, which is the explicit choice of this feature
  // and a deliberate divergence from the public assets of SPEC 77/79.
  //
  // uri_scheme belongs to the FIELD (storage), not to the instance, so it is
  // decided here and once: changing it later needs field_update_field() AND
  // moving every file with file_move(), which is exactly the work
  // myapi_update_7023() had to do for the claim fields in SPEC 65. Born
  // private, there is nothing to migrate.
  //
  // Cardinality 10 also belongs to the field: raising or lowering the cap is a
  // hook_update_N, and lowering it with providers over the cap silently
  // discards the extra deltas.
  _myapi_reservations_ensure_field('field_gallery', [
    'field_name'  => 'field_gallery',
    'type'        => 'image',
    'cardinality' => 10,
    'settings'    => ['uri_scheme' => 'private'],
  ]);
  // The logo of SPEC 85. It is born PUBLIC, right next to a private gallery on
  // the same bundle, and that is deliberate: the criterion SPEC 82 wrote down is
  // "site catalogue and commercial identity -> public; content uploaded for one
  // record or one case -> private". A logo is the shop window of the provider,
  // the same kind of asset as field_category_icon (SPEC 79), which is already
  // public in this feature. It also goes on every card of the listing: with
  // twenty providers per page, a private logo would be twenty authenticated
  // requests and twenty Drupal bootstraps just to paint the list.
  //
  // uri_scheme belongs to the FIELD (storage), not to the instance, exactly like
  // field_gallery above: deciding it here and once is what avoids a
  // field_update_field() plus a file_move() per file later on — the work
  // myapi_update_7023() had to do in SPEC 65.
  //
  // Cardinality 1: one file or none, never a list. Uploading a new one replaces
  // the previous one in the form.
  _myapi_reservations_ensure_field('field_logo', [
    'field_name'  => 'field_logo',
    'type'        => 'image',
    'cardinality' => 1,
    'settings'    => ['uri_scheme' => 'public'],
  ]);

  // Own fields of 'service_request'.
  _myapi_reservations_ensure_field('field_category', [
    'field_name'  => 'field_category',
    'type'        => 'taxonomy_term_reference',
    'cardinality' => 1,
    'settings'    => $category_settings,
  ]);
  _myapi_reservations_ensure_field('field_desired_start', [
    'field_name'  => 'field_desired_start',
    'type'        => 'datestamp',
    'cardinality' => 1,
    'settings'    => $timestamp_settings,
  ]);
  _myapi_reservations_ensure_field('field_request_status', [
    'field_name'  => 'field_request_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    // From the catalogue, not restated here: the same list configures this
    // field and will decide the transitions, so the two cannot drift.
    'settings'    => ['allowed_values' => myapi_services_request_statuses()],
  ]);
  _myapi_reservations_ensure_field('field_assigned_offer', [
    'field_name'  => 'field_assigned_offer',
