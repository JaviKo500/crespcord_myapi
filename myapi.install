<?php

/**
 * @file
 * Install and uninstall hooks for the myapi module.
 */

/**
 * Whether uninstalling the module also destroys the reservations content types,
 * their fields and ALL their data (areas and reservations).
 *
 * Kept FALSE on purpose: areas and reservations hold real client data, so an
 * accidental `drush pm-uninstall myapi` must never wipe them. Flip this to TRUE
 * only for a deliberate, one-off teardown where losing that data is intended.
 */
define('MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL', FALSE);

/**
 * Whether uninstalling the module also destroys the claims content types,
 * their fields and ALL their data (reclamos and their transactions).
 *
 * Kept FALSE on purpose: reclamos and claim transactions hold real client
 * data, so an accidental `drush pm-uninstall myapi` must never wipe them. Flip
 * this to TRUE only for a deliberate, one-off teardown where losing that data
 * is intended. Independent from MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL:
 * flipping one must not drag the other feature's data down with it.
 */
define('MYAPI_CLAIMS_DESTRUCTIVE_UNINSTALL', FALSE);

