/**
 * Implements hook_install().
 */
function myapi_install() {
  myapi_mail_system_register();
  _myapi_reservations_install();
  _myapi_claims_install();
  // SPEC 77. After claims: it reuses field_description, field_images and
  // field_attachment, which _myapi_claims_install() creates — and creates them
  // private:// at field level, which is what the request's photos inherit.
  // Before the role installer, for the same ordering reason as the two above,
  // even though SPEC 77 grants this role nothing yet.
  _myapi_services_install();
  // SPEC 78. After services: its (currently empty) permission catalogue would
  // otherwise be crossed against a module_invoke_all('permission') that does
  // not yet know the five marketplace bundles, the same reasoning that keeps
  // this before the building-admin role below.
  _myapi_provider_role_install();
  // After the reservations and claims installs: 'area', 'reservation' and
  // 'reclamo' must exist before their 'create'/'edit any' permissions can be
  // found in module_invoke_all('permission') and granted to the
  // building-admin role.
  _myapi_building_admin_install();
}

/**
 * Implements hook_requirements().
 *
 * One check, at 'runtime' only: the building-admin role exists but has lost
 * 'access user profiles' (SPEC 51). Without that permission the role keeps its
 * menu and its content, but every profile page answers 403 and the
 * field_requester autocomplete of the reservation form comes back empty — a
 * failure with no symptom pointing at its cause, whose first diagnosis would be
 * "the SPEC 51 filter is broken".
 *
 * It reports and does NOT repair. Re-granting the permission on every status
 * report would overrule an administrator who removed it on purpose, which is
 * the same conservative line _myapi_building_admin_install() has held since
 * SPEC 49. myapi_update_7014() is where the permission is granted.
 *
 * A site without the role says nothing at all: the role is created by this
 * module's installer, but a site may legitimately have deleted it.
 *
 * This is the one place in the module where a rid appears, and it is READ from
 * the role that was loaded by name — never written by hand. The rule of SPEC 49
 * stands.
 *
 * @param string $phase
 *   'install', 'update' or 'runtime'.
 *
 * @return array
 *   Requirements keyed by machine name; empty when there is nothing to say.
 */
function myapi_requirements($phase) {
  $requirements = [];

  if ($phase !== 'runtime') {
    return $requirements;
  }

  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  if (!$role) {
    return $requirements;
  }

  // rid => permission name => TRUE, for the granted ones only.
  $permissions = user_role_permissions([$role->rid => $role->name]);
  if (!empty($permissions[$role->rid][MYAPI_BUILDING_ADMIN_USER_PERMISSION])) {
    return $requirements;
  }

  $requirements['myapi_building_admin_user_permission'] = [
    'title'       => t('My API: personas del rol "@role"', ['@role' => MYAPI_BUILDING_ADMIN_ROLE]),
    'value'       => t('Falta el permiso "@permission"', ['@permission' => MYAPI_BUILDING_ADMIN_USER_PERMISSION]),
    'severity'    => REQUIREMENT_WARNING,
    'description' => t('El rol "@role" no tiene concedido el permiso "@permission", así que no puede ver ningún perfil de usuario y el autocompletado de "Solicitante" del formulario de reserva le sale vacío. El filtro por condominio sigue en su sitio: ese permiso solo decide si el rol lee personas, y las dos mitades del filtro deciden cuáles. Para reponerlo: <code>drush role-add-perm "@role" "@permission"</code>, o desde !link.', [
      '@role'       => MYAPI_BUILDING_ADMIN_ROLE,
      '@permission' => MYAPI_BUILDING_ADMIN_USER_PERMISSION,
      // l() returns already-sanitised markup, which is what !link expects.
      '!link'       => l(t('la página de permisos'), 'admin/people/permissions'),
    ]),
  ];

  return $requirements;
}

/**
 * Implements hook_uninstall().
 */
function myapi_uninstall() {
  myapi_mail_system_unregister();

  // Conservative by default: uninstalling does NOT remove the reservations
  // content types, fields or data — they hold real client records. The
  // destructive path only runs when MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL is
  // flipped to TRUE manually (see the constant at the top of this file).
  if (MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL) {
    _myapi_reservations_uninstall_destructive();
  }

  // Same conservative default for the claims content types (SPEC 55), gated by
  // its own independent constant.
  if (MYAPI_CLAIMS_DESTRUCTIVE_UNINSTALL) {
    _myapi_claims_uninstall_destructive();
  }

  // Same conservative default for the services marketplace (SPEC 77), gated by
  // its own independent constant.
  if (MYAPI_SERVICES_DESTRUCTIVE_UNINSTALL) {
    _myapi_services_uninstall_destructive();
  }
}

/**
 * Destroys the reservations schema and all its data (opt-in, never automatic).
 *
 * Only ever called from myapi_uninstall() when
 * MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL is TRUE. Deleting a field also
 * deletes its instances and stored values, so this wipes every area and
 * reservation node's field data; the node types are then removed.
 */
function _myapi_reservations_uninstall_destructive() {
  $fields = [
    'field_condominium',
    'field_image',
    'field_open_time',
    'field_close_time',
    'field_slot_minutes',
    'field_max_minutes',
    'field_area_status',
    'field_who_can_reserve',
    'field_cancel_deadline_minutes',
    'field_area_category',
    'field_area_notes',
    'field_concurrent_reservations',
    'field_unit',
    'field_requester',
    'field_area',
    'field_date',
    'field_start_time',
    'field_end_time',
    'field_reservation_status',
    'field_cancelled_by',
    'field_cancel_reason',
  ];
  foreach ($fields as $field_name) {
    if (field_info_field($field_name)) {
      field_delete_field($field_name);
    }
  }

  foreach (['area', 'reservation'] as $type) {
    if (node_type_load($type)) {
      node_type_delete($type);
    }
  }

  // Purge the deleted field data now instead of waiting for cron.
  field_purge_batch(1000);
}

/**
 * Destroys the claims schema and all its data (opt-in, never automatic).
 *
 * Only ever called from myapi_uninstall() when
 * MYAPI_CLAIMS_DESTRUCTIVE_UNINSTALL is TRUE. Deleting a field also deletes its
 * instances and stored values, so this wipes every reclamo and
 * claim_transaction node's field data; the node types are then removed.
 *
 * field_condominium and field_requester are deliberately NOT in this list:
 * they were created by SPEC 32 and are still used by 'area'/'reservation'
 * regardless of this flag, so deleting them here would wipe reservations data
 * on a site that only opted into the claims teardown. node_type_delete()
 * already removes their 'reclamo' instances via field_attach_delete_bundle()
 * without touching the field itself.
 */
function _myapi_claims_uninstall_destructive() {
  // MYAPI_BUILDING_ADMIN_CLAIM_TYPE lives in the role's include; explicit load
  // for the same reason as everywhere else in this file — an .install runs
  // early enough that the D7 registry may not have files[] warm.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $fields = [
    'field_images',
    'field_attachment',
    'field_description',
    'field_status',
    'field_claim_type',
    'field_reception_date',
    'field_visibility',
    'field_status_date',
    'field_comment',
    'field_claim',
  ];
  foreach ($fields as $field_name) {
    if (field_info_field($field_name)) {
      field_delete_field($field_name);
    }
  }

  foreach ([MYAPI_BUILDING_ADMIN_CLAIM_TYPE, 'claim_transaction'] as $type) {
    if (node_type_load($type)) {
      node_type_delete($type);
    }
  }

  // Purge the deleted field data now instead of waiting for cron.
  field_purge_batch(1000);
}

/**
 * Mail keys of this module that must keep their HTML body.
 *
 * Drupal's mail_system variable is keyed by "{module}_{key}", so these are the
 * exact keys that get mapped to MyapiHtmlMailSystem.
 */
function myapi_html_mail_keys() {
  return [
    'myapi_password_reset',
    'myapi_reservation_created_user',
    'myapi_reservation_cancelled_user',
    'myapi_reservation_created_admin',
    'myapi_reservation_cancelled_admin',
    // SPEC 68. The single catalogue both myapi_mail_system_register() and
    // ..._unregister() walk, so adding a key here is all it takes — there is no
    // second list to keep in sync. The 'myapi_' prefix is the module name
    // drupal_mail() prepends to the key, not part of the key itself.
    'myapi_claim_created_requester',
    'myapi_claim_published_neighbour',
    'myapi_claim_transaction_requester',
    'myapi_claim_transaction_neighbour',
    'myapi_claim_created_admin',
    // SPEC 70's key, which that spec added to myapi_mail() and to the
    // formatters but never to this list: without the mapping its HTML body was
    // reaching the back office converted to plain text. Fixed in passing by
    // SPEC 80, whose update hook re-registers the whole catalogue anyway.
    'myapi_claim_closed_admin',
    // SPEC 80. The detail of a payment registered from the app, sent to the
    // 'backend' role.
    'myapi_payment_created_admin',
  ];
}

/**
 * Maps this module's HTML mail keys to MyapiHtmlMailSystem.
 *
 * Only these keys use the HTML-preserving mail system (see
 * includes/myapi.mailsystem.inc), leaving every other mail on this site (core,
 * other modules) on the default plain-text system.
 */
function myapi_mail_system_register() {
  $mail_system = variable_get('mail_system', ['default-system' => 'DefaultMailSystem']);
  foreach (myapi_html_mail_keys() as $key) {
    $mail_system[$key] = 'MyapiHtmlMailSystem';
  }
  variable_set('mail_system', $mail_system);
}

/**
 * Removes this module's mail system mappings.
 */
function myapi_mail_system_unregister() {
  $mail_system = variable_get('mail_system', []);
  foreach (myapi_html_mail_keys() as $key) {
    unset($mail_system[$key]);
  }
  variable_set('mail_system', $mail_system);
}

/**
 * Ensures a node content type exists (idempotent).
 *
 * If the bundle already exists it returns without touching anything. Otherwise
 * it creates a node_content type, saves it, and sets the publishing and comment
 * behaviour agreed in the spec: published by default (no promote, no sticky) and
 * comments hidden. No body field is added: the reservations model defines no
 * field that maps to the native body.
 *
 * @param string $type
 *   Machine name of the content type (e.g. 'area').
 * @param string $name
 *   Human name of the content type (e.g. 'Área').
 * @param string $description
 *   Admin description of the content type.
 * @param string $title_label
 *   Label of the native title field.
 */
function _myapi_reservations_ensure_node_type($type, $name, $description, $title_label) {
  if (node_type_load($type)) {
    return;
  }

  $node_type = node_type_set_defaults([
    'type'        => $type,
    'name'        => $name,
    'base'        => 'node_content',
    'description' => $description,
    'has_title'   => 1,
    'title_label' => $title_label,
    'custom'      => 1,
    'modified'    => 1,
    'locked'      => 0,
  ]);

  node_type_save($node_type);

  // Published by default; not promoted to front page, not sticky.
  variable_set('node_options_' . $type, ['status']);
  // Comments hidden on this content type.
  variable_set('comment_' . $type, COMMENT_NODE_HIDDEN);
}

/**
 * Ensures a field exists at the field (storage) level (idempotent).
 *
 * A field is created once regardless of how many bundles use it, so this checks
 * the live field definition and only calls field_create_field() when missing.
 * Covers every field type used by the reservations model: entityreference
 * (target node/user), text, number_integer, list_text (with allowed_values),
 * image and datetime.
 *
 * @param string $field_name
 *   Machine name of the field (e.g. 'field_condominium').
 * @param array $definition
 *   Field definition array passed verbatim to field_create_field().
 */
function _myapi_reservations_ensure_field($field_name, array $definition) {
  if (!field_info_field($field_name)) {
    field_create_field($definition);
  }
}

/**
 * The entityreference selection settings of every field this module creates.
 *
 * Single source of truth, read by three callers: the two installers, which
 * create the fields with these settings, and myapi_update_7016(), which repairs
 * the fields of sites created before this catalogue existed.
 *
 * **Where these settings live, and why this catalogue exists.** All three keys
 * — 'target_type', 'handler' and 'handler_settings' — are FIELD-level settings
 * in Drupal 7 entityreference, never instance-level. The selection handler
 * reads them from the field and only from the field:
 *
 *   // EntityReference_SelectionHandler_Generic::buildEntityFieldQuery()
 *   if (!empty($this->field['settings']['handler_settings']['target_bundles'])) {
 *     $query->entityCondition('bundle', ..., 'IN');
 *   }
 *
 * The UI is what misleads: entityreference exposes them through
 * hook_field_settings_form(), which Drupal renders inside the *instance* edit
 * screen even though it saves them on the field. This module wrote them into
 * the instance until SPEC 53, so the handler never saw a target_bundles and
 * EVERY autocomplete of the module offered every node of the site — a vivienda
 * or a boletin came up while typing in field_condominium. Keeping the
 * definitions here, in one array, is what stops that from being reintroduced
 * one field at a time; EntityReferenceFieldSettingsTest pins it.
 *
 * A consequence worth stating: because they are field-level, a shared field
 * carries ONE selection setting for all its bundles. field_condominium is
 * attached to both 'area' and 'reservation' and both want 'condominio', so
 * nothing is lost here — but a future field needing different bundles per
 * bundle would need two fields, exactly like field_area_status and
 * field_reservation_status already do for their allowed_values.
 *
 * 'sort' is pinned to 'none' everywhere: entityreference then orders by the
 * entity label, which is the node title (or the username), and that is the
 * order the autocomplete should show.
 *
 * @return array
 *   Field name => the field-level 'settings' array of that field.
 */
function _myapi_entityreference_field_settings() {
  // MYAPI_BUILDING_ADMIN_CONDO_FIELD lives in the role's include. Explicit,
  // like every other use of it in this file: an .install runs early enough that
  // the D7 registry may not have the files[] entries warm.
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');
  // SPEC 77: the marketplace bundle names live in their own catalogue, loaded
  // for the same reason and in the same explicit way.
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');

  $condominium = [
    'target_type'      => 'node',
    'handler'          => 'base',
    'handler_settings' => [
      'target_bundles' => ['condominio' => 'condominio'],
      'sort'           => ['type' => 'none'],
    ],
  ];

  // SPEC 77. Three targets reused by six field entries below; written once
  // here so a bundle rename is one edit and not six.
  $provider = [
    'target_type'      => 'node',
    'handler'          => 'base',
    'handler_settings' => [
      'target_bundles' => [MYAPI_SERVICES_PROVIDER_TYPE => MYAPI_SERVICES_PROVIDER_TYPE],
      'sort'           => ['type' => 'none'],
    ],
  ];
  $service_request = [
    'target_type'      => 'node',
    'handler'          => 'base',
    'handler_settings' => [
      'target_bundles' => [MYAPI_SERVICES_REQUEST_TYPE => MYAPI_SERVICES_REQUEST_TYPE],
      'sort'           => ['type' => 'none'],
    ],
  ];
  $service_offer = [
    'target_type'      => 'node',
    'handler'          => 'base',
    'handler_settings' => [
      'target_bundles' => [MYAPI_SERVICES_OFFER_TYPE => MYAPI_SERVICES_OFFER_TYPE],
      'sort'           => ['type' => 'none'],
    ],
  ];

  return [
    // Shared by the 'area' and 'reservation' bundles.
    'field_condominium' => $condominium,
    // On 'user', SPEC 49. Same target, unlimited cardinality — cardinality is a
    // separate field property and is not part of these settings.
    MYAPI_BUILDING_ADMIN_CONDO_FIELD => $condominium,
    'field_unit'        => [
      'target_type'      => 'node',
      'handler'          => 'base',
      'handler_settings' => [
        'target_bundles' => ['vivienda' => 'vivienda'],
        'sort'           => ['type' => 'none'],
      ],
    ],
    'field_area'        => [
      'target_type'      => 'node',
      'handler'          => 'base',
      'handler_settings' => [
        'target_bundles' => ['area' => 'area'],
        'sort'           => ['type' => 'none'],
      ],
    ],
    // On 'claim_transaction', SPEC 55. MYAPI_BUILDING_ADMIN_CLAIM_TYPE is the
    // reserved machine name of the 'reclamo' bundle (SPEC 49).
    'field_claim'       => [
      'target_type'      => 'node',
      'handler'          => 'base',
      'handler_settings' => [
        'target_bundles' => [MYAPI_BUILDING_ADMIN_CLAIM_TYPE => MYAPI_BUILDING_ADMIN_CLAIM_TYPE],
        'sort'           => ['type' => 'none'],
      ],
    ],
    // The one field targeting 'user': the user entity has a single bundle, so
    // there is no target_bundles to set and its ABSENCE is correct, not an
    // oversight. What narrows this autocomplete to the residents of the
    // assigned condominiums is the SPEC 51 'user_access' query alter, not a
    // bundle condition.
    'field_requester'   => [
      'target_type'      => 'user',
      'handler'          => 'base',
      'handler_settings' => [
        'sort' => ['type' => 'none'],
      ],
    ],
    // The second field targeting 'user' (SPEC 77): the accounts that operate a
    // provider. Same shape as field_requester and for the same reason — the
    // user entity has a single bundle, so the absence of target_bundles is the
    // correct configuration. Unlimited cardinality is a field property and is
    // not part of these settings.
    'field_provider_users' => [
      'target_type'      => 'user',
      'handler'          => 'base',
      'handler_settings' => [
        'sort' => ['type' => 'none'],
      ],
    ],
    // SPEC 77, the six node references of the marketplace. Two of them are
    // SHARED by two bundles each — field_request by 'service_offer' and
    // 'service_transaction', which is why it appears once — and the remaining
    // four are separate fields on purpose even where two of them point at the
    // same bundle: 'the provider that offered' (field_provider) and 'the
    // provider that was awarded' (field_assigned_provider, denormalised on the
    // request) are different facts, and a shared field would put them in one
    // table where no query could tell them apart.
    'field_request'           => $service_request,
    'field_provider'          => $provider,
    'field_assigned_offer'    => $service_offer,
    'field_assigned_provider' => $provider,
    'field_rating_offer'      => $service_offer,
    'field_rating_provider'   => $provider,
  ];
}

/**
 * Completes a field's entityreference settings without overwriting them.
 *
 * The rule is the same conservative one _myapi_building_admin_install() holds
 * for permissions: FILL IN what is missing, never replace what somebody set. So
 * a target_bundles adjusted by hand in production survives a `drush updb`,
 * while a field that has none — the SPEC 53 bug — gets the catalogue's.
 *
 * Pure: no database, no Drupal. Takes the two arrays and returns the third, so
 * tests/unit/EntityReferenceFieldSettingsTest.php exercises the whole decision
 * without a site.
 *
 * @param array $current
 *   The field's live 'settings' array, as field_info_field() returns it.
 * @param array $wanted
 *   The catalogue entry from _myapi_entityreference_field_settings().
 *
 * @return array|null
 *   The settings to write, or NULL when nothing needs writing.
 */
function _myapi_entityreference_repair_settings(array $current, array $wanted) {
  $repaired = $current;

  if (empty($repaired['handler']) && !empty($wanted['handler'])) {
    $repaired['handler'] = $wanted['handler'];
  }

  $handler_settings = isset($repaired['handler_settings']) && is_array($repaired['handler_settings'])
    ? $repaired['handler_settings']
    : [];
  $wanted_handler_settings = isset($wanted['handler_settings']) && is_array($wanted['handler_settings'])
    ? $wanted['handler_settings']
    : [];

  foreach ($wanted_handler_settings as $key => $value) {
    if (empty($handler_settings[$key])) {
      $handler_settings[$key] = $value;
    }
  }

  // Only written when there is something to write: a field targeting an entity
  // type with no bundle restriction must not gain an empty 'handler_settings'
  // key just because this ran.
  if ($handler_settings) {
    $repaired['handler_settings'] = $handler_settings;
  }

  // 'target_type' is deliberately NOT repaired. It is the one setting that was
  // always written at field level, changing it would orphan stored target_ids,
  // and a mismatch there is a bug this update must report rather than paper
  // over — see myapi_update_7016().
  return $repaired == $current ? NULL : $repaired;
}

/**
 * Ensures a field instance exists on a bundle (idempotent).
 *
 * Instances are per bundle, so this checks the live instance definition on the
 * given bundle and only calls field_create_instance() when missing. The
 * instance array carries its own label, required flag, widget, default_value,
 * description and settings.
 *
 * The $entity_type parameter was added by SPEC 49, which needs an instance on
 * the 'user' entity for field_condominio_admin. It goes LAST and defaults to
 * 'node' precisely so the ~30 calls of _myapi_reservations_install() — and the
 * updates 7006 to 7009 already run in production — keep both their signature
 * and their behaviour. The function name stays as it is for the same reason.
 *
 * @param string $field_name
 *   Machine name of the field (e.g. 'field_condominium').
 * @param string $bundle
 *   Machine name of the bundle the instance belongs to (e.g. 'area', or 'user'
 *   for the single bundle of the user entity).
 * @param array $instance
 *   Instance definition array passed verbatim to field_create_instance(). Its
 *   own 'entity_type' key must agree with $entity_type.
 * @param string $entity_type
 *   Entity type the bundle belongs to. Defaults to 'node'.
 */
function _myapi_reservations_ensure_instance($field_name, $bundle, array $instance, $entity_type = 'node') {
  if (!field_info_instance($entity_type, $field_name, $bundle)) {
    field_create_instance($instance);
  }
}

/**
 * Creates the reservations content types, fields and instances (idempotent).
 *
 * Single source of truth for the reservations schema: it is called both from
 * hook_install() (fresh sites) and from myapi_update_7006() (already installed
 * sites). Re-running it never duplicates anything nor throws, because every
 * creation goes through the idempotent _ensure_* sub-helpers.
 *
 * Order: (a) the two node types; (b) every field at the storage level
 * (field_condominium once, shared by both bundles); (c) the per-bundle
 * instances.
 *
 * entityreference note: 'target_type', 'handler' and
 * 'handler_settings.target_bundles' are ALL field-level settings in D7 — the
 * selection handler reads them off the field — so they come from
 * _myapi_entityreference_field_settings() and never appear on an instance. The
 * instances below carry label, required, widget and default value only.
 */
function _myapi_reservations_install() {
  // (a) Content types.
  _myapi_reservations_ensure_node_type(
    'area',
    'Área',
    'Áreas comunes reservables de un condominio.',
    'Nombre del área'
  );
  _myapi_reservations_ensure_node_type(
    'reservation',
    'Reserva',
    'Reserva de un área común hecha por un usuario.',
    'Título'
  );

  // (b) Fields (storage level). field_condominium is created once and shared
  // by both bundles.
  //
  // The entityreference ones take their whole 'settings' from the catalogue:
  // that is where the referenceable bundles are decided, and the handler reads
  // them from the field, not from the instance.
  $reference_settings = _myapi_entityreference_field_settings();

  _myapi_reservations_ensure_field('field_condominium', [
    'field_name'  => 'field_condominium',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_condominium'],
  ]);
  _myapi_reservations_ensure_field('field_image', [
    'field_name'  => 'field_image',
    'type'        => 'image',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_open_time', [
    'field_name'  => 'field_open_time',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 5],
  ]);
  _myapi_reservations_ensure_field('field_close_time', [
    'field_name'  => 'field_close_time',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 5],
  ]);
  _myapi_reservations_ensure_field('field_slot_minutes', [
    'field_name'  => 'field_slot_minutes',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_max_minutes', [
    'field_name'  => 'field_max_minutes',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_area_status', [
    'field_name'  => 'field_area_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'active'      => 'Activo',
        'closed'      => 'Cerrado',
        'maintenance' => 'En Mantenimiento',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_who_can_reserve', [
    'field_name'  => 'field_who_can_reserve',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'both'   => 'Ambos',
        'owner'  => 'Propietario',
        'tenant' => 'Arrendatario',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_cancel_deadline_minutes', [
    'field_name'  => 'field_cancel_deadline_minutes',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_area_category', [
    'field_name'  => 'field_area_category',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'pool'         => 'Piscina',
        'gym'          => 'Gimnasio',
        'party_hall'   => 'Salón de eventos',
        'bbq'          => 'Zona de parrillas (BBQ)',
        'playground'   => 'Área infantil',
        'sports_court' => 'Cancha deportiva',
        'coworking'    => 'Coworking / Sala de trabajo',
        'sauna'        => 'Sauna / Spa',
        'rooftop'      => 'Terraza / Rooftop',
        'other'        => 'Otra',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_area_notes', [
    'field_name'  => 'field_area_notes',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  // Named without a 'max_' prefix on purpose: Drupal 7 rejects field names
  // longer than 32 characters, and 'field_max_concurrent_reservations' is 33.
  // The JSON key stays 'max_concurrent_reservations' (see area.resource.inc).
  _myapi_reservations_ensure_field('field_concurrent_reservations', [
    'field_name'  => 'field_concurrent_reservations',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_unit', [
    'field_name'  => 'field_unit',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_unit'],
  ]);
  _myapi_reservations_ensure_field('field_requester', [
    'field_name'  => 'field_requester',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_requester'],
  ]);
  _myapi_reservations_ensure_field('field_area', [
    'field_name'  => 'field_area',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_area'],
  ]);
  _myapi_reservations_ensure_field('field_date', [
    'field_name'  => 'field_date',
    'type'        => 'datetime',
    'cardinality' => 1,
    'settings'    => [
      'granularity' => [
        'year'   => 'year',
        'month'  => 'month',
        'day'    => 'day',
        'hour'   => 0,
        'minute' => 0,
        'second' => 0,
      ],
      'tz_handling' => 'none',
      'timezone_db' => '',
