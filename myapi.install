  return $schema;
}

/**
 * Implements hook_install().
 */
function myapi_install() {
  myapi_mail_system_register();
  _myapi_reservations_install();
  // After the reservations install: the 'area' and 'reservation' types must
  // exist before their 'create'/'edit any' permissions can be found in
  // module_invoke_all('permission') and granted to the building-admin role.
  _myapi_building_admin_install();
}

/**
 * Implements hook_uninstall().
 */
function myapi_uninstall() {
  myapi_mail_system_unregister();

  // Conservative by default: uninstalling does NOT remove the reservations
  // content types, fields or data — they hold real client records. The
  // destructive path only runs when MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL is
  // flipped to TRUE manually (see the constant at the top of this file).
  if (MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL) {
    _myapi_reservations_uninstall_destructive();
  }
}

/**
 * Destroys the reservations schema and all its data (opt-in, never automatic).
 *
 * Only ever called from myapi_uninstall() when
 * MYAPI_RESERVATIONS_DESTRUCTIVE_UNINSTALL is TRUE. Deleting a field also
 * deletes its instances and stored values, so this wipes every area and
 * reservation node's field data; the node types are then removed.
 */
function _myapi_reservations_uninstall_destructive() {
  $fields = [
    'field_condominium',
    'field_image',
    'field_open_time',
    'field_close_time',
    'field_slot_minutes',
    'field_max_minutes',
    'field_area_status',
    'field_who_can_reserve',
    'field_cancel_deadline_minutes',
    'field_area_category',
    'field_area_notes',
    'field_concurrent_reservations',
    'field_unit',
    'field_requester',
    'field_area',
    'field_date',
    'field_start_time',
    'field_end_time',
    'field_reservation_status',
    'field_cancelled_by',
    'field_cancel_reason',
  ];
  foreach ($fields as $field_name) {
    if (field_info_field($field_name)) {
      field_delete_field($field_name);
    }
  }

  foreach (['area', 'reservation'] as $type) {
    if (node_type_load($type)) {
      node_type_delete($type);
    }
  }

  // Purge the deleted field data now instead of waiting for cron.
  field_purge_batch(1000);
}

/**
 * Mail keys of this module that must keep their HTML body.
 *
 * Drupal's mail_system variable is keyed by "{module}_{key}", so these are the
 * exact keys that get mapped to MyapiHtmlMailSystem.
 */
function myapi_html_mail_keys() {
  return [
    'myapi_password_reset',
    'myapi_reservation_created_user',
    'myapi_reservation_cancelled_user',
    'myapi_reservation_created_admin',
    'myapi_reservation_cancelled_admin',
  ];
}

/**
 * Maps this module's HTML mail keys to MyapiHtmlMailSystem.
 *
 * Only these keys use the HTML-preserving mail system (see
 * includes/myapi.mailsystem.inc), leaving every other mail on this site (core,
 * other modules) on the default plain-text system.
 */
function myapi_mail_system_register() {
  $mail_system = variable_get('mail_system', ['default-system' => 'DefaultMailSystem']);
  foreach (myapi_html_mail_keys() as $key) {
    $mail_system[$key] = 'MyapiHtmlMailSystem';
  }
  variable_set('mail_system', $mail_system);
}

/**
 * Removes this module's mail system mappings.
 */
function myapi_mail_system_unregister() {
  $mail_system = variable_get('mail_system', []);
  foreach (myapi_html_mail_keys() as $key) {
    unset($mail_system[$key]);
  }
  variable_set('mail_system', $mail_system);
}

/**
 * Ensures a node content type exists (idempotent).
 *
 * If the bundle already exists it returns without touching anything. Otherwise
 * it creates a node_content type, saves it, and sets the publishing and comment
 * behaviour agreed in the spec: published by default (no promote, no sticky) and
 * comments hidden. No body field is added: the reservations model defines no
 * field that maps to the native body.
 *
 * @param string $type
 *   Machine name of the content type (e.g. 'area').
 * @param string $name
 *   Human name of the content type (e.g. 'Área').
 * @param string $description
 *   Admin description of the content type.
 * @param string $title_label
 *   Label of the native title field.
 */
function _myapi_reservations_ensure_node_type($type, $name, $description, $title_label) {
  if (node_type_load($type)) {
    return;
  }

  $node_type = node_type_set_defaults([
    'type'        => $type,
    'name'        => $name,
    'base'        => 'node_content',
    'description' => $description,
    'has_title'   => 1,
    'title_label' => $title_label,
    'custom'      => 1,
    'modified'    => 1,
    'locked'      => 0,
  ]);

  node_type_save($node_type);

  // Published by default; not promoted to front page, not sticky.
  variable_set('node_options_' . $type, ['status']);
  // Comments hidden on this content type.
  variable_set('comment_' . $type, COMMENT_NODE_HIDDEN);
}

/**
 * Ensures a field exists at the field (storage) level (idempotent).
 *
 * A field is created once regardless of how many bundles use it, so this checks
 * the live field definition and only calls field_create_field() when missing.
 * Covers every field type used by the reservations model: entityreference
 * (target node/user), text, number_integer, list_text (with allowed_values),
 * image and datetime.
 *
 * @param string $field_name
 *   Machine name of the field (e.g. 'field_condominium').
 * @param array $definition
 *   Field definition array passed verbatim to field_create_field().
 */
function _myapi_reservations_ensure_field($field_name, array $definition) {
  if (!field_info_field($field_name)) {
    field_create_field($definition);
  }
}

/**
 * Ensures a field instance exists on a bundle (idempotent).
 *
 * Instances are per bundle, so this checks the live instance definition on the
 * given bundle and only calls field_create_instance() when missing. The
 * instance array carries its own label, required flag, widget, default_value,
 * description and settings.
 *
 * The $entity_type parameter was added by SPEC 49, which needs an instance on
 * the 'user' entity for field_condominio_admin. It goes LAST and defaults to
 * 'node' precisely so the ~30 calls of _myapi_reservations_install() — and the
 * updates 7006 to 7009 already run in production — keep both their signature
 * and their behaviour. The function name stays as it is for the same reason.
 *
 * @param string $field_name
 *   Machine name of the field (e.g. 'field_condominium').
 * @param string $bundle
 *   Machine name of the bundle the instance belongs to (e.g. 'area', or 'user'
 *   for the single bundle of the user entity).
 * @param array $instance
 *   Instance definition array passed verbatim to field_create_instance(). Its
 *   own 'entity_type' key must agree with $entity_type.
 * @param string $entity_type
 *   Entity type the bundle belongs to. Defaults to 'node'.
 */
function _myapi_reservations_ensure_instance($field_name, $bundle, array $instance, $entity_type = 'node') {
  if (!field_info_instance($entity_type, $field_name, $bundle)) {
    field_create_instance($instance);
  }
}

/**
 * Creates the reservations content types, fields and instances (idempotent).
 *
 * Single source of truth for the reservations schema: it is called both from
 * hook_install() (fresh sites) and from myapi_update_7006() (already installed
 * sites). Re-running it never duplicates anything nor throws, because every
 * creation goes through the idempotent _ensure_* sub-helpers.
 *
 * Order: (a) the two node types; (b) every field at the storage level
 * (field_condominium once, shared by both bundles); (c) the per-bundle
 * instances.
 *
 * entityreference note: only 'target_type' is a field-level setting in D7; the
 * 'handler'/'handler_settings.target_bundles' that restrict the referenceable
 * bundle live on the instance, which is where entityreference reads them.
 */
function _myapi_reservations_install() {
  // (a) Content types.
  _myapi_reservations_ensure_node_type(
    'area',
    'Área',
    'Áreas comunes reservables de un condominio.',
    'Nombre del área'
  );
  _myapi_reservations_ensure_node_type(
    'reservation',
    'Reserva',
    'Reserva de un área común hecha por un usuario.',
    'Título'
  );

  // (b) Fields (storage level). field_condominium is created once and shared
  // by both bundles.
  _myapi_reservations_ensure_field('field_condominium', [
    'field_name'  => 'field_condominium',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => ['target_type' => 'node'],
  ]);
  _myapi_reservations_ensure_field('field_image', [
    'field_name'  => 'field_image',
    'type'        => 'image',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_open_time', [
    'field_name'  => 'field_open_time',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 5],
  ]);
  _myapi_reservations_ensure_field('field_close_time', [
    'field_name'  => 'field_close_time',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 5],
  ]);
  _myapi_reservations_ensure_field('field_slot_minutes', [
    'field_name'  => 'field_slot_minutes',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_max_minutes', [
    'field_name'  => 'field_max_minutes',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_area_status', [
    'field_name'  => 'field_area_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'active'      => 'Activo',
        'closed'      => 'Cerrado',
        'maintenance' => 'En Mantenimiento',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_who_can_reserve', [
    'field_name'  => 'field_who_can_reserve',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'both'   => 'Ambos',
        'owner'  => 'Propietario',
        'tenant' => 'Arrendatario',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_cancel_deadline_minutes', [
    'field_name'  => 'field_cancel_deadline_minutes',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_area_category', [
    'field_name'  => 'field_area_category',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'pool'         => 'Piscina',
        'gym'          => 'Gimnasio',
        'party_hall'   => 'Salón de eventos',
        'bbq'          => 'Zona de parrillas (BBQ)',
        'playground'   => 'Área infantil',
        'sports_court' => 'Cancha deportiva',
        'coworking'    => 'Coworking / Sala de trabajo',
        'sauna'        => 'Sauna / Spa',
        'rooftop'      => 'Terraza / Rooftop',
        'other'        => 'Otra',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_area_notes', [
    'field_name'  => 'field_area_notes',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  // Named without a 'max_' prefix on purpose: Drupal 7 rejects field names
  // longer than 32 characters, and 'field_max_concurrent_reservations' is 33.
  // The JSON key stays 'max_concurrent_reservations' (see area.resource.inc).
  _myapi_reservations_ensure_field('field_concurrent_reservations', [
    'field_name'  => 'field_concurrent_reservations',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_field('field_unit', [
    'field_name'  => 'field_unit',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => ['target_type' => 'node'],
  ]);
  _myapi_reservations_ensure_field('field_requester', [
    'field_name'  => 'field_requester',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => ['target_type' => 'user'],
  ]);
  _myapi_reservations_ensure_field('field_area', [
    'field_name'  => 'field_area',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => ['target_type' => 'node'],
  ]);
  _myapi_reservations_ensure_field('field_date', [
    'field_name'  => 'field_date',
    'type'        => 'datetime',
    'cardinality' => 1,
    'settings'    => [
      'granularity' => [
        'year'   => 'year',
        'month'  => 'month',
        'day'    => 'day',
        'hour'   => 0,
        'minute' => 0,
        'second' => 0,
      ],
      'tz_handling' => 'none',
      'timezone_db' => '',
      'todate'      => '',
    ],
  ]);
  _myapi_reservations_ensure_field('field_start_time', [
    'field_name'  => 'field_start_time',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 5],
  ]);
  _myapi_reservations_ensure_field('field_end_time', [
    'field_name'  => 'field_end_time',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 5],
  ]);
  _myapi_reservations_ensure_field('field_reservation_status', [
    'field_name'  => 'field_reservation_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'confirmed' => 'Confirmada',
        'cancelled' => 'Cancelada',
      ],
    ],
  ]);
  _myapi_reservations_ensure_field('field_cancelled_by', [
    'field_name'  => 'field_cancelled_by',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'user'  => 'Usuario',
        'admin' => 'Admin',
      ],
    ],
  ]);
  // Single-line text on purpose: the reason travels in a push notification, an
  // email and the calendar detail panel, all of which render one short line.
  _myapi_reservations_ensure_field('field_cancel_reason', [
    'field_name'  => 'field_cancel_reason',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 255],
  ]);

  // (c) Instances of the 'area' bundle.
  _myapi_reservations_ensure_instance('field_condominium', 'area', [
    'field_name'  => 'field_condominium',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Condominio',
    'required'    => 1,
    'settings'    => [
      'handler'          => 'base',
      'handler_settings' => [
        'target_bundles' => ['condominio' => 'condominio'],
        'sort'           => ['type' => 'none'],
      ],
    ],
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_image', 'area', [
    'field_name'  => 'field_image',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Imagen',
    'required'    => 0,
    'settings'    => [
      'file_extensions' => 'png jpg jpeg',
      'alt_field'       => 0,
      'title_field'     => 0,
    ],
    'widget'      => ['type' => 'image_image'],
  ]);
  _myapi_reservations_ensure_instance('field_open_time', 'area', [
    'field_name'  => 'field_open_time',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Hora de apertura',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_close_time', 'area', [
    'field_name'  => 'field_close_time',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Hora de cierre',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
