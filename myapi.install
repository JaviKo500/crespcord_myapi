  _myapi_reservations_ensure_field('field_offer_amount', [
    'field_name'  => 'field_offer_amount',
    'type'        => 'number_decimal',
    'cardinality' => 1,
    'settings'    => ['precision' => 10, 'scale' => 2],
  ]);
  _myapi_reservations_ensure_field('field_offer_status', [
    'field_name'  => 'field_offer_status',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => ['allowed_values' => myapi_services_offer_statuses()],
  ]);
  // The three chat fields. Created now, empty and unused: the chat transport
  // is not built by SPEC 77 and may not end up being Firebase at all, but the
  // shape of the data it needs is already decided — one thread per offer — and
  // creating the columns now costs nothing while a second update hook later
  // would cost a deploy.
  _myapi_reservations_ensure_field('field_firebase_path', [
    'field_name'  => 'field_firebase_path',
    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 255],
  ]);
  _myapi_reservations_ensure_field('field_chat_opened_at', [
    'field_name'  => 'field_chat_opened_at',
    'type'        => 'datestamp',
    'cardinality' => 1,
    'settings'    => $timestamp_settings,
  ]);
  _myapi_reservations_ensure_field('field_last_message_at', [
    'field_name'  => 'field_last_message_at',
    'type'        => 'datestamp',
    'cardinality' => 1,
    'settings'    => $timestamp_settings,
  ]);

  // Own fields of 'service_rating'.
  _myapi_reservations_ensure_field('field_rating_offer', [
    'field_name'  => 'field_rating_offer',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_rating_offer'],
  ]);
  _myapi_reservations_ensure_field('field_rating_provider', [
    'field_name'  => 'field_rating_provider',
    'type'        => 'entityreference',
    'cardinality' => 1,
    'settings'    => $reference_settings['field_rating_provider'],
  ]);
  _myapi_reservations_ensure_field('field_stars', [
    'field_name'  => 'field_stars',
    'type'        => 'list_integer',
    'cardinality' => 1,
    'settings'    => ['allowed_values' => myapi_services_star_values()],
  ]);
  _myapi_reservations_ensure_field('field_rating_comment', [
    'field_name'  => 'field_rating_comment',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);

  // (d) Instances of 'provider'.
  _myapi_reservations_ensure_instance('field_provider_users', $provider_type, [
    'field_name'  => 'field_provider_users',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Usuarios asociados',
    'required'    => 1,
    'description' => 'Cuentas que operan este proveedor desde la app.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_phone', $provider_type, [
    'field_name'  => 'field_phone',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Teléfono',
    'required'    => 1,
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_address', $provider_type, [
    'field_name'    => 'field_address',
    'entity_type'   => 'node',
    'bundle'        => $provider_type,
    'label'         => 'Dirección',
    'required'      => 0,
    'settings'      => ['text_processing' => 1],
    // 'plain_text' pinned for the same reason as field_description in SPEC 55:
    // a format nobody has permission for disables the textarea entirely.
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_services_desc', $provider_type, [
    'field_name'    => 'field_services_desc',
    'entity_type'   => 'node',
    'bundle'        => $provider_type,
    'label'         => 'Descripción de servicios',
    'required'      => 1,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_license_expiry', $provider_type, [
    'field_name'  => 'field_license_expiry',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Caducidad de la habilitación',
    'required'    => 1,
    'description' => 'Pasada esta fecha y hora el proveedor deja de ser activo: no aparece en el marketplace y no puede ofertar.',
    'widget'      => $date_widget,
  ]);
  _myapi_reservations_ensure_instance('field_categories', $provider_type, [
    'field_name'  => 'field_categories',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Categorías',
    'required'    => 1,
    'widget'      => ['type' => 'options_buttons'],
  ]);
  _myapi_reservations_ensure_instance('field_rating_avg', $provider_type, [
    'field_name'  => 'field_rating_avg',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Calificación promedio',
    'required'    => 0,
    'description' => 'Calculado a partir de las calificaciones. No editar a mano.',
    'widget'      => ['type' => 'number'],
  ]);
  _myapi_reservations_ensure_instance('field_rating_count', $provider_type, [
    'field_name'  => 'field_rating_count',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Cantidad de calificaciones',
    'required'    => 0,
    'description' => 'Calculado a partir de las calificaciones. No editar a mano.',
    'widget'      => ['type' => 'number'],
  ]);
  // The three instances of SPEC 81. 'required' => 0 is spelled out on all
  // three even though it is the default: it is the decision that keeps every
  // provider already loaded on the site valid, and it has to be visible when
  // reading the code.
  //
  // min = 0 is applied by number_field_widget_form() as an #element_validate of
  // the widget, so saving -15 from the back-office form fails validation. It is
  // NOT an SQL constraint: a programmatic node_save() can still write a
  // negative, and the business validation will have to repeat it when it
  // exists. prefix only paints in the form and in the node view — it never
  // travels to the API nor to the database, where the value is the bare number.
  _myapi_reservations_ensure_instance('field_hourly_rate', $provider_type, [
    'field_name'  => 'field_hourly_rate',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Valor hora',
    'required'    => 0,
    'description' => 'Tarifa por hora que cobra el proveedor. Es informativa: se muestra al residente como precio de referencia y no condiciona el monto de ninguna oferta.',
    'settings'    => ['min' => 0, 'prefix' => '$ '],
    'widget'      => ['type' => 'number'],
  ]);
  // The taxonomy_autocomplete widget of D7 creates the terms that do not exist
  // natively, with no setting at all: an unknown name enters validation as
  // ['tid' => 'autocreate', ...] and taxonomy_field_presave() saves it as a
  // real term. 'auto_create' => TRUE belongs to entityreference, not taxonomy,
  // and writing it here would be dead configuration someone would later "fix".
  _myapi_reservations_ensure_instance('field_tags', $provider_type, [
    'field_name'  => 'field_tags',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Etiquetas',
    'required'    => 0,
    'description' => 'Separadas por coma. Si la etiqueta no existe, se crea al guardar.',
    'widget'      => ['type' => 'taxonomy_autocomplete'],
  ]);
  // No 'text_processing' and no default_value with a format, unlike
  // field_services_desc above: this is a single line with no rich editor, so
  // there is no markup to filter and the format column would always hold the
  // same value. Same pattern as field_phone.
  _myapi_reservations_ensure_instance('field_short_description', $provider_type, [
    'field_name'  => 'field_short_description',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Descripción corta',
    'required'    => 0,
    'description' => 'Una línea para el listado del marketplace. Máximo 255 caracteres. La descripción completa va en Descripción de servicios.',
    'widget'      => ['type' => 'text_textfield'],
  ]);
  // The gallery instance of SPEC 82. Same extensions, size and alt settings the
  // deleted field_photo had; what changes is the storage, which is private, and
  // the cardinality, which is the field's and not the instance's.
  _myapi_reservations_ensure_instance('field_gallery', $provider_type, [
    'field_name'  => 'field_gallery',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Galería',
    'required'    => 0,
    'description' => 'Hasta 10 imágenes para el carrusel de la ficha del proveedor. Se arrastran para ordenarlas: el orden del formulario es el que ve la app. Son privadas: solo se sirven a usuarios autenticados.',
    'settings'    => [
      'file_extensions'    => 'png jpg jpeg',
      'max_filesize'       => '3 MB',
      'alt_field'          => 1,
      'alt_field_required' => 0,
    ],
    'widget'      => ['type' => 'image_image'],
  ]);
  // The logo instance of SPEC 85. The two resolution settings are NOT
  // symmetrical, and reading them as two equivalent limits is the mistake this
  // comment exists to prevent:
  //
  //   - min_resolution REJECTS. An image below 200x200 cannot be saved and the
  //     form says so.
  //   - max_resolution RESIZES, silently. An image of 2000x1500 is accepted and
  //     stored as 1000x750, with no error and no warning.
  //
  // And max_filesize is validated BEFORE the resize, so the resize never
  // rescues a heavy file: a 4000x4000 PNG of 5 MB is rejected by weight and
  // never gets reduced. The 2 MB are those of the file leaving the operator's
  // disk.
  //
  // The aspect ratio is not validated: D7 has no native ratio check and
  // min/max_resolution are independent caps, so a 1000x300 passes both. The
  // "square" recommendation lives in the description, by explicit decision.
  _myapi_reservations_ensure_instance('field_logo', $provider_type, [
    'field_name'  => 'field_logo',
    'entity_type' => 'node',
    'bundle'      => $provider_type,
    'label'       => 'Logo',
    'required'    => 0,
    'description' => 'Logo del proveedor. Se recomienda cuadrado, mínimo 200×200 px y máximo 2 MB. Una imagen mayor de 1000×1000 se reduce automáticamente al guardar; una menor de 200×200 se rechaza.',
    'settings'    => [
      'file_extensions'    => 'png jpg jpeg',
      'max_filesize'       => '2 MB',
      'min_resolution'     => '200x200',
      'max_resolution'     => '1000x1000',
      'alt_field'          => 1,
      'alt_field_required' => 0,
    ],
    'widget'      => ['type' => 'image_image'],
  ]);

  // (d) Instances of 'service_request'.
  //
  // field_requester and field_condominium are the two shared fields of SPEC
  // 32, reused here exactly as SPEC 55 reused them on 'reclamo'.
  // field_condominium is what will let the 'administrador edificio' role see
  // the requests of its buildings once a later spec adds the map entry; the
  // field is created now so that spec is one line and not a schema change.
  _myapi_reservations_ensure_instance('field_requester', $request_type, [
    'field_name'  => 'field_requester',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Solicitante',
    'required'    => 1,
    'description' => 'Residente que pide el servicio y destinatario de las notificaciones de la solicitud.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_condominium', $request_type, [
    'field_name'  => 'field_condominium',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Condominio',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  // SPEC 86: field_unit is borrowed from reservations too, which owns the field
  // and its 'reservation' instance; only a new instance is added here. No
  // 'settings' key: target_bundles ('vivienda') is a FIELD setting, already
  // fixed by _myapi_entityreference_field_settings()['field_unit'] and shared
  // with the 'reservation' and 'service_rating' instances.
  //
  // Required here and OPTIONAL on 'service_rating' (SPEC 84) on purpose:
  // 'required' is an instance setting, so the two diverge without touching each
  // other. A service goes to one specific unit — a request without it is not
  // actionable — and it can be demanded on a bundle that already exists because
  // no flow creates requests yet, so there is no node to invalidate. That is
  // exactly what SPEC 84 could NOT assume about ratings.
  //
  // Nothing writes it yet: the endpoint that creates a request does not exist.
  _myapi_reservations_ensure_instance('field_unit', $request_type, [
    'field_name'  => 'field_unit',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Vivienda',
    'required'    => 1,
    'description' => 'Vivienda a la que va dirigido el servicio.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_category', $request_type, [
    'field_name'  => 'field_category',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Categoría',
    'required'    => 1,
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_description', $request_type, [
    'field_name'    => 'field_description',
    'entity_type'   => 'node',
    'bundle'        => $request_type,
    'label'         => 'Descripción',
    'required'      => 1,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_desired_start', $request_type, [
    'field_name'  => 'field_desired_start',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Fecha de inicio deseada',
    'required'    => 1,
    'widget'      => $date_widget,
  ]);
  _myapi_reservations_ensure_instance('field_request_status', $request_type, [
    'field_name'    => 'field_request_status',
    'entity_type'   => 'node',
    'bundle'        => $request_type,
    'label'         => 'Estado',
    'required'      => 1,
    'default_value' => [['value' => MYAPI_SERVICES_REQUEST_STATUS_OPEN]],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_assigned_offer', $request_type, [
    'field_name'  => 'field_assigned_offer',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Oferta adjudicada',
    'required'    => 0,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_assigned_provider', $request_type, [
    'field_name'  => 'field_assigned_provider',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Proveedor adjudicado',
    'required'    => 0,
    'description' => 'Se rellena a partir de la oferta adjudicada. No editar a mano.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_closed_at', $request_type, [
    'field_name'  => 'field_closed_at',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Fecha de cierre',
    'required'    => 0,
    'widget'      => $date_widget,
  ]);

  // (d) Instances of 'service_offer'.
  _myapi_reservations_ensure_instance('field_request', $offer_type, [
    'field_name'  => 'field_request',
    'entity_type' => 'node',
    'bundle'      => $offer_type,
    'label'       => 'Solicitud',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_provider', $offer_type, [
    'field_name'  => 'field_provider',
    'entity_type' => 'node',
    'bundle'      => $offer_type,
    'label'       => 'Proveedor',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_offer_message', $offer_type, [
    'field_name'    => 'field_offer_message',
    'entity_type'   => 'node',
    'bundle'        => $offer_type,
    'label'         => 'Mensaje',
    'required'      => 1,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  _myapi_reservations_ensure_instance('field_offer_amount', $offer_type, [
    'field_name'  => 'field_offer_amount',
    'entity_type' => 'node',
    'bundle'      => $offer_type,
    'label'       => 'Monto',
    'required'    => 0,
    'description' => 'Opcional, en dólares. Una oferta sin monto es válida: el precio puede cerrarse en el chat.',
    'widget'      => ['type' => 'number'],
  ]);
  _myapi_reservations_ensure_instance('field_offer_status', $offer_type, [
    'field_name'    => 'field_offer_status',
    'entity_type'   => 'node',
    'bundle'        => $offer_type,
    'label'         => 'Estado',
    'required'      => 1,
    'default_value' => [['value' => 'sent']],
    'widget'        => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_firebase_path', $offer_type, [
    'field_name'  => 'field_firebase_path',
    'entity_type' => 'node',
    'bundle'      => $offer_type,
    'label'       => 'Ruta del hilo de chat',
    'required'    => 0,
    'description' => 'Generada por el servidor al abrir el chat. Vacío = chat no abierto. Editarla a mano rompe el chat sin dar ningún error.',
    'widget'      => ['type' => 'text_textfield'],
  ]);
  _myapi_reservations_ensure_instance('field_chat_opened_at', $offer_type, [
    'field_name'  => 'field_chat_opened_at',
    'entity_type' => 'node',
    'bundle'      => $offer_type,
    'label'       => 'Chat abierto el',
    'required'    => 0,
    'widget'      => $date_widget,
  ]);
  _myapi_reservations_ensure_instance('field_last_message_at', $offer_type, [
    'field_name'  => 'field_last_message_at',
    'entity_type' => 'node',
    'bundle'      => $offer_type,
    'label'       => 'Último mensaje',
    'required'    => 0,
    'widget'      => $date_widget,
  ]);

  // (d) Instances of 'service_rating'.
  // OPTIONAL since SPEC 87, and the status catalogue is what made it so: a
  // request in 'direct' is closed demanding a rating
  // (myapi_services_close_requires_rating()) and has no offer to hang it off.
  // Keeping this required would have demanded a rating that could not be saved.
  // The reference that ALWAYS exists is field_rating_provider, still required:
  // without it a rating scores nobody.
  _myapi_reservations_ensure_instance('field_rating_offer', $rating_type, [
    'field_name'  => 'field_rating_offer',
    'entity_type' => 'node',
    'bundle'      => $rating_type,
    'label'       => 'Oferta',
    'required'    => 0,
    'description' => 'Oferta adjudicada que se califica. Se deja vacía cuando la solicitud fue de proveedor directo y no hubo ronda de ofertas; el proveedor calificado es siempre el del campo Proveedor.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_rating_provider', $rating_type, [
    'field_name'  => 'field_rating_provider',
    'entity_type' => 'node',
    'bundle'      => $rating_type,
    'label'       => 'Proveedor',
    'required'    => 1,
    'description' => 'Se rellena a partir de la oferta calificada, o del proveedor directo de la solicitud cuando no hubo oferta. No editar a mano.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_stars', $rating_type, [
    'field_name'  => 'field_stars',
    'entity_type' => 'node',
    'bundle'      => $rating_type,
    'label'       => 'Estrellas',
    'required'    => 1,
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_rating_comment', $rating_type, [
    'field_name'    => 'field_rating_comment',
    'entity_type'   => 'node',
    'bundle'        => $rating_type,
    'label'         => 'Comentario',
    'required'      => 0,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
  // field_unit is borrowed from reservations (SPEC 32): only a new instance is
  // added here, the field itself is neither created nor owned by this feature
  // (same criterion as field_condominium/field_requester on service_request).
  // Born optional and unwritten, like field_rating_avg did in this same
  // function: no spec creates a rating yet, so nothing fills it in today.
  _myapi_reservations_ensure_instance('field_unit', $rating_type, [
    'field_name'  => 'field_unit',
    'entity_type' => 'node',
    'bundle'      => $rating_type,
    'label'       => 'Vivienda',
    'required'    => 0,
    'description' => 'Vivienda del residente que calificó, si el flujo que crea la calificación la registra. Vacío en toda calificación existente hasta entonces.',
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);

  // (d) Instances of 'service_transaction' — the timeline, built exactly like
  // 'claim_transaction' (SPEC 55): the same status field as its parent with no
  // default (a transaction always records a deliberately chosen new status),
  // plus the two fields that bundle already owns, reused here.
  _myapi_reservations_ensure_instance('field_request', $transaction_type, [
    'field_name'  => 'field_request',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Solicitud',
    'required'    => 1,
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_request_status', $transaction_type, [
    'field_name'  => 'field_request_status',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Estado',
    'required'    => 1,
    'widget'      => ['type' => 'options_select'],
  ]);
  _myapi_reservations_ensure_instance('field_status_date', $transaction_type, [
    'field_name'  => 'field_status_date',
    'entity_type' => 'node',
    'bundle'      => $transaction_type,
    'label'       => 'Fecha del estado',
    'required'    => 1,
    // date_select with the same input format as claim_transaction. This is the
    // one date of the feature that is 'datetime' and not 'datestamp', because
    // the field is shared with claims and already existed.
    'widget'      => [
      'type'     => 'date_select',
      'settings' => [
        'input_format'   => 'Y-m-d H:i',
        'year_range'     => '-1:+3',
        'increment'      => 1,
        'label_position' => 'above',
        'text_parts'     => [],
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_comment', $transaction_type, [
    'field_name'    => 'field_comment',
    'entity_type'   => 'node',
    'bundle'        => $transaction_type,
    'label'         => 'Comentario',
    'required'      => 0,
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'plain_text']],
    'widget'        => ['type' => 'text_textarea'],
  ]);

  // (d) field_images and field_attachment on the request, reused from SPEC
  // 55/65. Both are private:// AT FIELD LEVEL, which is what makes the photos
  // of a request born private without this installer having to say so: the
  // uri_scheme belongs to the field, and the field already exists. The
  // extensions and size limits are the claims ones, unchanged.
  _myapi_reservations_ensure_instance('field_images', $request_type, [
    'field_name'  => 'field_images',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Imágenes',
    'required'    => 0,
    'settings'    => [
      'file_extensions'    => 'png jpg jpeg',
      'max_filesize'       => '3 MB',
      'alt_field'          => 1,
      'alt_field_required' => 0,
    ],
    'widget'      => ['type' => 'image_image'],
  ]);
  _myapi_reservations_ensure_instance('field_attachment', $request_type, [
    'field_name'  => 'field_attachment',
    'entity_type' => 'node',
    'bundle'      => $request_type,
    'label'       => 'Adjunto',
    'required'    => 0,
    'settings'    => [
      'file_extensions' => 'pdf doc docx xls xlsx',
      'max_filesize'    => '3 MB',
    ],
    'widget'      => ['type' => 'file_generic'],
  ]);
}

/**
 * Destroys the services marketplace schema and all its data (opt-in, never
 * automatic).
 *
 * Only ever called from myapi_uninstall() when
 * MYAPI_SERVICES_DESTRUCTIVE_UNINSTALL is TRUE.
 *
 * One difference from the two teardowns above, and it is the whole reason this
 * function is not a copy of them: this feature REUSES seven fields owned by
 * reservations and claims (field_requester, field_condominium,
 * field_description, field_images, field_attachment, field_status_date,
 * field_comment). Deleting those fields would take every area, reservation,
 * reclamo and claim transaction down with them. So the shared ones lose only
 * their INSTANCE on this feature's bundles, and the fields themselves are left
 * standing — which is also what node_type_delete() would not do on its own.
 */
function _myapi_services_uninstall_destructive() {
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');

  // Fields this feature owns: deleted outright, instances and data included.
  $owned = [
    'field_category_code',
    'field_category_icon',
    'field_provider_users',
    'field_phone',
    'field_address',
    'field_services_desc',
    'field_license_expiry',
    'field_categories',
    'field_rating_avg',
    'field_rating_count',
    'field_category',
    'field_desired_start',
    'field_request_status',
    'field_assigned_offer',
    'field_assigned_provider',
    'field_closed_at',
    'field_request',
    'field_provider',
    'field_offer_message',
    'field_offer_amount',
    'field_offer_status',
    'field_firebase_path',
    'field_chat_opened_at',
    'field_last_message_at',
    'field_rating_offer',
    'field_rating_provider',
    'field_stars',
    'field_rating_comment',
    // SPEC 81. The three names are new in the whole module — no other bundle
    // uses them — so deleting them cannot take anybody else's data down. The
    // caution the seven shared fields below demand does not apply here.
    'field_hourly_rate',
    'field_tags',
    'field_short_description',
    // SPEC 82. Replaces field_photo, which no longer exists after
    // myapi_update_7029(). Same reasoning as the three names above: the name is
    // new in the whole module, so deleting it takes nobody else's data down.
    'field_gallery',
    // SPEC 85. Same reasoning again: the name is new in the whole module and no
    // other bundle uses it, so deleting it takes nobody else's data down. A
    // destructive uninstall does remove every logo and its files.
    'field_logo',
  ];
  foreach ($owned as $field_name) {
    if (field_info_field($field_name)) {
      field_delete_field($field_name);
    }
  }

  // Fields owned by reservations (SPEC 32) and claims (SPEC 55): only the
  // instances created by this feature go.
  $shared = [
    MYAPI_SERVICES_REQUEST_TYPE => [
      'field_requester',
      'field_condominium',
      'field_description',
      'field_images',
      'field_attachment',
    ],
    MYAPI_SERVICES_TRANSACTION_TYPE => [
      'field_status_date',
      'field_comment',
    ],
  ];
  foreach ($shared as $bundle => $field_names) {
    foreach ($field_names as $field_name) {
      $instance = field_info_instance('node', $field_name, $bundle);
      if ($instance) {
        field_delete_instance($instance);
      }
    }
  }

  foreach (myapi_services_node_types() as $type) {
    if (node_type_load($type)) {
      node_type_delete($type);
    }
  }

  $vocabulary = taxonomy_vocabulary_machine_name_load(MYAPI_SERVICES_CATEGORY_VOCABULARY);
  if ($vocabulary) {
    taxonomy_vocabulary_delete($vocabulary->vid);
  }

  // The provider tag vocabulary (SPEC 81), created by this feature like the
  // category one and deleted with it, terms included.
  $tag_vocabulary = taxonomy_vocabulary_machine_name_load(MYAPI_SERVICES_TAG_VOCABULARY);
  if ($tag_vocabulary) {
    taxonomy_vocabulary_delete($tag_vocabulary->vid);
  }

  // Purge the deleted field data now instead of waiting for cron.
  field_purge_batch(1000);
}

/**
 * Creates the my_api_tokens table on sites where the module is already enabled.
 */
function myapi_update_7001() {
  if (!db_table_exists('my_api_tokens')) {
    $schema = drupal_get_schema_unprocessed('myapi', 'my_api_tokens');
    db_create_table('my_api_tokens', $schema);
  }
}

/**
 * Creates the myapi_password_reset_tokens table on sites where the module is
 * already enabled.
 */
function myapi_update_7002() {
  if (!db_table_exists('myapi_password_reset_tokens')) {
    $schema = drupal_get_schema_unprocessed('myapi', 'myapi_password_reset_tokens');
    db_create_table('myapi_password_reset_tokens', $schema);
  }
}

/**
 * Registers the HTML mail system for the password reset email on sites where
 * the module is already enabled.
 */
function myapi_update_7003() {
  myapi_mail_system_register();
}

/**
 * Creates the myapi_notifications table on sites where the module is already
 * enabled.
 */
function myapi_update_7004() {
  if (!db_table_exists('myapi_notifications')) {
    $schema = drupal_get_schema_unprocessed('myapi', 'myapi_notifications');
    db_create_table('myapi_notifications', $schema);
  }
}

/**
 * Adds condominium_id and unit_id to myapi_notifications on sites where the
 * table already exists.
 */
function myapi_update_7005() {
  if (!db_field_exists('myapi_notifications', 'condominium_id')) {
    db_add_field('myapi_notifications', 'condominium_id', [
      'description' => 'Logical FK to the condominium node (nid). NULL for notifications with no single condominium context (e.g. boletin fan-out).',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => FALSE,
    ]);
  }
  if (!db_field_exists('myapi_notifications', 'unit_id')) {
    db_add_field('myapi_notifications', 'unit_id', [
      'description' => 'Logical FK to the unit (vivienda) node (nid). NULL for notifications with no single unit context (e.g. boletin fan-out).',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => FALSE,
    ]);
  }
}

/**
 * Creates the reservations content types (area, reservation) and their fields
 * on sites where the module is already installed.
 *
 * Runs the same idempotent _myapi_reservations_install() used by hook_install(),
 * so existing production sites get the reservations schema via `drush updb`
 * without a disable/enable cycle and without touching any existing data or
 * tables (my_api_tokens, myapi_password_reset_tokens, myapi_notifications).
 */
function myapi_update_7006() {
  _myapi_reservations_install();
}

/**
 * Adds the field_area_category classifier to the 'area' bundle on sites where
 * the module is already installed.
 *
 * Reuses the same idempotent sub-helpers as _myapi_reservations_install(), so it
 * creates the list_text field and its 'area' instance without duplicating them
 * or throwing a FieldException where they already exist. It only touches the
 * 'area' bundle — reservation and condominio are left untouched — and adds no
 * REST endpoint or business logic, just the field and its instance.
 */
function myapi_update_7007() {
  _myapi_reservations_ensure_field('field_area_category', [
    'field_name'  => 'field_area_category',
    'type'        => 'list_text',
    'cardinality' => 1,
    'settings'    => [
      'allowed_values' => [
        'pool'         => 'Piscina',
        'gym'          => 'Gimnasio',
        'party_hall'   => 'Salón de eventos',
        'bbq'          => 'Zona de parrillas (BBQ)',
        'playground'   => 'Área infantil',
        'sports_court' => 'Cancha deportiva',
        'coworking'    => 'Coworking / Sala de trabajo',
        'sauna'        => 'Sauna / Spa',
        'rooftop'      => 'Terraza / Rooftop',
        'other'        => 'Otra',
      ],
    ],
  ]);
  _myapi_reservations_ensure_instance('field_area_category', 'area', [
    'field_name'    => 'field_area_category',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Categoría del área',
    'required'      => 1,
    'description'   => 'Categoría de catálogo del área; la app la usa como clave estable para elegir el icono.',
    'default_value' => [['value' => 'other']],
    'widget'        => ['type' => 'options_select'],
  ]);
}

/**
 * Adds the field_area_notes free-text field to the 'area' bundle on sites where
 * the module is already installed.
 *
 * Reuses the same idempotent sub-helpers as _myapi_reservations_install(), so it
 * creates the text_long field and its 'area' instance without duplicating them
 * or throwing a FieldException where they already exist. It only touches the
 * 'area' bundle — reservation and condominio are left untouched — and adds no
 * REST endpoint or business logic, just the field and its instance.
 */
function myapi_update_7008() {
  _myapi_reservations_ensure_field('field_area_notes', [
    'field_name'  => 'field_area_notes',
    'type'        => 'text_long',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_instance('field_area_notes', 'area', [
    'field_name'    => 'field_area_notes',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Instrucciones o notas',
    'required'      => 0,
    'description'   => 'Instrucciones, normas o detalles del área que la app muestra al residente antes de reservar. Admite HTML.',
    'settings'      => ['text_processing' => 1],
    'default_value' => [['value' => '', 'format' => 'full_html']],
    'widget'        => ['type' => 'text_textarea'],
  ]);
}

/**
 * Adds the field_concurrent_reservations capacity field to the 'area'
 * bundle on sites where the module is already installed.
 *
 * Reuses the same idempotent sub-helpers as _myapi_reservations_install(), so it
 * creates the number_integer field and its 'area' instance without duplicating
 * them or throwing a FieldException where they already exist. It only touches
 * the 'area' bundle — reservation and condominio are left untouched — and adds
 * no REST endpoint or business logic, just the field and its instance.
 *
 * Leaving the field empty on an existing area is safe: the API normalises a
 * missing, NULL or below-1 value to a capacity of 1, which is exactly the
 * single-reservation overlap behaviour those areas already had.
 *
 * The field name carries no 'max_' prefix because Drupal 7 rejects field names
 * longer than 32 characters; the JSON key the API exposes is still
 * 'max_concurrent_reservations'.
 */
function myapi_update_7009() {
  _myapi_reservations_ensure_field('field_concurrent_reservations', [
    'field_name'  => 'field_concurrent_reservations',
    'type'        => 'number_integer',
    'cardinality' => 1,
  ]);
  _myapi_reservations_ensure_instance('field_concurrent_reservations', 'area', [
    'field_name'    => 'field_concurrent_reservations',
    'entity_type'   => 'node',
    'bundle'        => 'area',
    'label'         => 'Reservas simultáneas permitidas',
    'required'      => 0,
    'description'   => 'Número de reservas que pueden coincidir en el mismo horario. Vacío o menor que 1 se interpreta como 1.',
    'default_value' => [['value' => 1]],
    'widget'        => ['type' => 'number'],
  ]);
}

/**
 * SPEC 48: maps the three reservation mail keys to MyapiHtmlMailSystem.
 *
 * myapi_mail_system_register() runs on install, so a fresh site already gets
 * the mapping; this update applies it where the module is already installed.
 * Without it, the new keys would fall back to DefaultMailSystem and the HTML
 * body would arrive converted to plain text.
 */
function myapi_update_7010() {
  myapi_mail_system_register();
}

/**
 * SPEC 50: adds the field_cancel_reason field and registers the fourth mail key.
 *
 * Runs the same idempotent _myapi_reservations_install() used by hook_install(),
 * so on a site that already has every other reservations field only the new
 * field and its 'reservation' instance are created; nothing else is touched and
 * re-running the update is a no-op.
 *
 * myapi_mail_system_register() maps 'myapi_reservation_cancelled_admin' to
 * MyapiHtmlMailSystem. Without it the new admin email would fall back to
 * DefaultMailSystem and arrive converted to plain text.
 */
function myapi_update_7011() {
  _myapi_reservations_install();
  myapi_mail_system_register();
}

/**
 * SPEC 49: creates the 'administrador edificio' role, its user field and its
 * permissions.
 *
 * Runs the same idempotent _myapi_building_admin_install() used by
 * hook_install(), so re-running it creates no second role, no second field and
 * no duplicate row in role_permission.
 *
 * The number is 7012 and NOT 7011: SPEC 50 already took 7011 and it is run in
 * production, and system_update_7000() only executes numbers above the stored
 * schema_version — reusing it would leave this update unrun on every existing
 * site.
 *
 * Nothing is assigned to anyone here: the role is created empty on purpose,
 * and giving it to a person is a manual task at /user/N/edit, together with
 * their condominiums.
 */
function myapi_update_7012() {
  _myapi_building_admin_install();
}

/**
 * SPEC 49: lets the building-admin role write formatted text.
 *
 * Two halves of the same bug. A role with no 'use text format ...' permission
 * only reaches Drupal's fallback format, so every formatted field it may edit
 * renders DISABLED — which is how this surfaced: field_area_notes came up
 * blocked on node/add/area and fine on node/%/edit, because an existing node
 * carries its own stored format while a new one takes the instance default.
 *
 * (a) Re-runs the idempotent installer, which now grants
 *     'use text format filtered_html'. Nothing else changes: the helper only
 *     adds what is missing and never revokes.
 * (b) Drops the hard-coded 'full_html' from the field_area_notes default value,
 *     so each user starts on the best format they are actually allowed to
 *     write with. Guarded so re-running it is a no-op, and so a site whose
 *     instance was adjusted by hand is not overwritten wholesale — only the
 *     'format' key of the default value is touched.
 *
 * Existing area nodes keep the format they were saved with; this only affects
 * the starting point of a NEW one.
 */
function myapi_update_7013() {
  _myapi_building_admin_install();

  $instance = field_info_instance('node', 'field_area_notes', 'area');
  if ($instance && isset($instance['default_value'][0]['format'])) {
    unset($instance['default_value'][0]['format']);
    field_update_instance($instance);
  }
}

/**
 * Revokes 'view the administration theme' from the building-admin role.
 *
 * With that permission the role saw node forms, /admin/content and the
 * reservation calendar rendered in Seven, while every other operator of this
 * site — 'backend' included — sees them in the site theme. Two consequences,
 * and the second is the one that decided it: the layout was different for no
 * reason, and Seven does not carry the role's own sidebar menu, because blocks
 * are placed per theme. Dropping the permission puts the role on the same
 * screens as 'backend'.
 *
 * **This update REVOKES, which nothing else in this module does.** The
 * installer only ever adds, on purpose, so that a permission adjusted by hand
 * in production survives a deployment. Taking the permission out of
 * myapi_building_admin_permissions() alone would therefore have left every
 * existing site exactly as it was and required a manual
 * `drush role-remove-perm` per environment — which is precisely the manual step
 * this update exists to remove. The trade-off is stated plainly: if somebody
 * re-grants the permission by hand, running updates again takes it away.
 *
 * Idempotent: user_role_revoke_permissions() deletes rows, so a second run
 * removes nothing that is not there. A site without the role does nothing.
 *
 * The number is 7015 and NOT 7014: SPEC 51 takes 7014, and reusing a number
 * would leave one of the two unrun on every site that already ran the other.
 */
function myapi_update_7015() {
  module_load_include('inc', 'myapi', 'includes/myapi.building_admin');

  $role = user_role_load_by_name(MYAPI_BUILDING_ADMIN_ROLE);
  if (!$role) {
    return;
  }

  user_role_revoke_permissions($role->rid, ['view the administration theme']);
}

/**
 * Moves the entityreference selection settings onto the fields (SPEC 53).
 *
 * The bug this repairs: every autocomplete of this module offered every node of
 * the site. Typing in field_condominium of the area form came back with
 * viviendas, boletines and recibos, and the same happened in field_unit,
 * field_area and field_condominio_admin. The cause was placement, not logic —
 * 'handler' and 'handler_settings.target_bundles' were written on the INSTANCE,
 * while the entityreference selection handler reads them off the FIELD, so it
 * ran with no bundle condition at all. See
 * _myapi_entityreference_field_settings().
 *
 * Why an update hook is needed on top of fixing the installer:
 * _myapi_reservations_ensure_field() only creates what is missing and never
 * touches a field that exists, on purpose, so no `drush updb` would ever have
 * reached the fields of an installed site. This is the one place that writes
 * over them, and it uses field_update_field(), which changes the field
 * definition only — not one row of data moves.
 *
 * Conservative, like the rest of this installer: it FILLS IN what is missing
 * and never replaces a target_bundles somebody set by hand
 * (_myapi_entityreference_repair_settings() decides that, and is unit-tested).
 * A field this module never created is left alone; a field whose target_type
 * disagrees with the catalogue is REPORTED and skipped, because changing that
 * one would orphan every target_id already stored in it.
 *
 * The dead 'handler_settings' left on the old instances is not cleaned up:
 * entityreference never reads instance settings, so it costs nothing, and a
 * field_update_instance() per bundle would be a write with no effect to show
 * for it.
 *
 * Idempotent: a second run finds every setting already in place and writes
 * nothing.
 *
 * @return string
 *   A summary line, shown by drush and by update.php.
 */
function myapi_update_7016() {
  $repaired = [];
  $skipped = [];
  $missing = [];

  foreach (_myapi_entityreference_field_settings() as $field_name => $wanted) {
    // field_read_field() and NOT field_info_field(): the first returns the
    // definition as it is STORED, which is what may be written back with
    // field_update_field(). The second returns the cached, processed one — it
    // carries a 'bundles' key that does not belong in the field row, and during
    // a `drush updb` that cache is not guaranteed to be warm.
    $field = field_read_field($field_name);

    if (!$field) {
      // Nothing to repair — _myapi_reservations_install() creates it right,
      // and a site may legitimately not have it (no claims bundle, a field
      // deleted by hand).
      $missing[] = $field_name;
      continue;
    }

    $current = isset($field['settings']) && is_array($field['settings']) ? $field['settings'] : [];

    if (!empty($current['target_type']) && $current['target_type'] !== $wanted['target_type']) {
      $skipped[] = $field_name;
      watchdog(
        'myapi',
        'SPEC 53: field @field targets @actual, not @expected; its selection settings were left untouched.',
        [
          '@field'    => $field_name,
          '@actual'   => $current['target_type'],
          '@expected' => $wanted['target_type'],
        ],
        WATCHDOG_WARNING
      );
      continue;
    }

    $settings = _myapi_entityreference_repair_settings($current, $wanted);
    if ($settings === NULL) {
      continue;
    }

    $field['settings'] = $settings;
    field_update_field($field);
    $repaired[] = $field_name;
  }

  // The autocompletes read the field definition through the field info cache,
  // which field_update_field() clears on each write. Cleared once more here so
  // a run that repaired nothing still leaves a warm, correct cache.
  field_info_cache_clear();

  if ($repaired) {
    watchdog(
      'myapi',
      'SPEC 53: entityreference selection settings repaired on @fields.',
      ['@fields' => implode(', ', $repaired)],
      WATCHDOG_NOTICE
    );
  }

  $summary = $repaired
    ? t('Selection settings repaired on: @fields.', ['@fields' => implode(', ', $repaired)])
    : t('Every entityreference field already carried its selection settings; nothing to repair.');

  if ($missing) {
    $summary .= ' ' . t('Not present on this site: @fields.', ['@fields' => implode(', ', $missing)]);
  }
  if ($skipped) {
    $summary .= ' ' . t('Skipped for a target_type mismatch (see the log): @fields.', ['@fields' => implode(', ', $skipped)]);
  }

  return $summary;
}

/**
 * Creates the claims content types (reclamo, claim_transaction) and their
 * fields on sites where the module is already installed.
 *
 * Runs the same idempotent _myapi_claims_install() used by hook_install(), so
 * existing production sites get the claims schema via `drush updb` without a
 * disable/enable cycle and without touching any existing table or bundle
 * (my_api_tokens, myapi_notifications, 'area'/'reservation', etc.).
 *
 * The number is 7017 and NOT 7014, the next number the two comments above
 * myapi_requirements() and myapi_update_7015() point at: SPEC 51 reserved 7014
 * for a permission repair whose function was never written, a gap that
 * predates this spec and that this spec does not fill. 7015 and 7016 are
 * already taken, so 7017 is the first number actually free.
 */
function myapi_update_7017() {
  _myapi_claims_install();
}

/**
 * SPEC 56: grants the building-admin role its two new claim_transaction
 * permissions.
 *
 * Runs the same idempotent _myapi_building_admin_install() used by
 * hook_install(). By the time this runs, 'claim_transaction' already exists
 * on the site (SPEC 55's myapi_update_7017() created the bundle), and
 * myapi_building_admin_editable_types() already lists it once
 * node_type_load('claim_transaction') resolves — the code changes of SPEC 56
 * did that, not this update. So this is a single call: no schema, no field,
 * just the two permissions ('create claim_transaction content', 'edit any
 * claim_transaction content') the newly-editable type is now entitled to.
 *
 * Re-running it grants nothing twice: the installer only adds what is
 * missing from role_permission and never revokes.
 */
function myapi_update_7018() {
  _myapi_building_admin_install();
}

/**
 * SPEC 58: widens 'field_status_date' from day-only to day + hour + minute.
 *
 * The field is a Date module 'datetime' field, which already stores a full
 * DATETIME internally — day-only was a configuration constraint on the field
 * settings and on the widget, never on the schema. So this update rewrites
 * configuration only and touches no row of field_data_field_status_date:
 * existing transactions keep the exact value they were saved with (a '00:00'
 * time), which the timeline now displays as such.
 *
 * field_update_field() changes the field-wide 'granularity' setting (today
 * only 'claim_transaction' uses this field). field_update_instance() widens
 * the native 'date_select' widget of that same instance, so that the native
 * node/add/claim_transaction and node/%nid/edit forms offer hour and minute
 * selectors too. The 'reclamo' instance of field_reception_date is a
 * different field and is deliberately left alone.
 *
 * Re-running it is safe: both calls just write the same settings again.
 */
function myapi_update_7019() {
  $field = field_info_field('field_status_date');
  if (!$field) {
    return;
  }
  $field['settings']['granularity'] = array(
    'year'   => 'year',
    'month'  => 'month',
    'day'    => 'day',
    'hour'   => 'hour',
    'minute' => 'minute',
    'second' => 0,
  );
  field_update_field($field);

  $instance = field_info_instance('node', 'field_status_date', 'claim_transaction');
  if ($instance) {
    $instance['widget']['settings']['input_format'] = 'Y-m-d H:i';
    field_update_instance($instance);
  }
}

/**
 * SPEC 60: fills in the title of the 'claim_transaction' nodes saved without
 * one.
 *
 * Until SPEC 60, neither myapi_claim_transaction_create_form_submit() nor
 * myapi_claim_transaction_create_initial() (SPEC 57) wrote $node->title, and
 * node.title is NOT NULL DEFAULT '' — so those transactions were stored with an
 * empty title and show up as a blank link in /admin/content. From now on
 * hook_node_presave() titles every save; this rewrites the ones already on
 * disk, with the same myapi_claim_transaction_title() the presave uses.
 *
 * Only rows with title = '' are touched. The ones created through
 * node/add/claim_transaction carry a title an operator typed by hand before
 * this spec existed, and overwriting it would destroy information he put there
 * deliberately; they converge to the automatic format on their first save.
 *
 * db_update() and NOT node_load() + node_save(), deliberately: node_save()
 * fires hook_node_update(), whose 'claim_transaction' branch (SPEC 57) syncs
 * the PARENT CLAIM's field_status with the saved transaction's. Re-saving old
 * transactions in arbitrary order would leave every claim carrying the status
 * of whichever of its transactions was processed last — silent data corruption
 * in exchange for a title. Writing the column directly touches no field and
 * fires no hook.
 *
 * Both node.title and node_revision.title are written: in D7 node_load() reads
 * the title off the active revision, while listings and most queries read
 * node.title, so updating only one of the two leaves the site showing the value
 * in some places and the empty string in others. The bundle has no revisions
 * enabled (variable node_options_claim_transaction is ['status'], see
 * _myapi_reservations_ensure_node_type()), so n.vid is the only revision there
 * is.
 *
 * Re-running it is a no-op: after the first pass no row matches title = ''.
 *
 * @return string
 *   Message drush updb prints, with how many rows were filled in.
 */
function myapi_update_7020() {
  module_load_include('inc', 'myapi', 'includes/myapi.claim_transaction_admin');
  module_load_include('inc', 'myapi', 'includes/myapi.claims_admin');

  $query = db_select('node', 'n')
    ->fields('n', array('nid', 'vid'))
    ->condition('n.type', 'claim_transaction')
    ->condition('n.title', '');

  // Same LEFT JOIN criterion as myapi_claim_transaction_timeline_rows(): a
  // transaction missing one of these values still gets a title, built out of
  // whatever it does have.
  $query->leftJoin('field_data_field_claim', 'fcl', "fcl.entity_id = n.nid AND fcl.entity_type = 'node' AND fcl.deleted = 0");
  $query->addField('fcl', 'field_claim_target_id', 'claim_nid');

  $query->leftJoin('field_data_field_status', 'fs', "fs.entity_id = n.nid AND fs.entity_type = 'node' AND fs.deleted = 0");
  $query->addField('fs', 'field_status_value', 'status');

  $query->leftJoin('field_data_field_status_date', 'fsd', "fsd.entity_id = n.nid AND fsd.entity_type = 'node' AND fsd.deleted = 0");
  $query->addField('fsd', 'field_status_date_value', 'status_date');

  $query->leftJoin('field_data_field_comment', 'fcm', "fcm.entity_id = n.nid AND fcm.entity_type = 'node' AND fcm.deleted = 0");
  $query->addField('fcm', 'field_comment_value', 'comment');

  $options = myapi_claims_status_options();
  $updated = 0;

  foreach ($query->execute() as $row) {
    $title = myapi_claim_transaction_title(
      $row->claim_nid,
      ($row->status !== NULL && isset($options[$row->status])) ? $options[$row->status] : $row->status,
      $row->status_date,
      $row->comment
    );

    db_update('node')
      ->fields(array('title' => $title))
      ->condition('nid', $row->nid)
      ->execute();

    db_update('node_revision')
      ->fields(array('title' => $title))
      ->condition('vid', $row->vid)
      ->execute();

    $updated++;
  }

  if ($updated) {
    // The rows were written behind Drupal's back, so anything already loaded in
    // this request still carries the empty title.
    entity_get_controller('node')->resetCache();
  }

  return t('Se generó el título de @count transacciones de reclamo que estaban guardadas sin título.', array('@count' => $updated));
}

/**
 * SPEC 62: drops 'duplicated' from the field_status catalogue.
 *
 * field_status is a single list_text field shared by 'reclamo' and
 * 'claim_transaction' (SPEC 55), so removing the value from its field-level
 * allowed_values takes it out of both bundles at once — the claim's status
 * select, the transaction's, the listing filter and the timeline.
 *
 * The rows are rewritten BEFORE field_update_field(), and that order is not
 * cosmetic: core's options module implements hook_field_update_forbid() and
 * throws FieldUpdateForbiddenException when an allowed value that still has
 * data is removed, which would abort the update halfway. In practice this
 * migration finds nothing — the status was never used on the site this spec was
 * written for — but a `drush updb` that fails on a value somebody selected once
 * by hand is exactly the failure mode worth spending five lines on. 'closed' is
 * the destination because a duplicate claim is, in the end, a closed one.
 *
 * Both field_data_ and field_revision_ are written: Field API reads the data
 * table, but a bundle with revisions enabled would otherwise keep the dead
 * value in its history and re-forbid the change on a later run. Neither claims
 * bundle has revisions today (node_options_* is ['status']), so in practice the
 * second write mirrors the first.
 *
 * A side effect stated out loud: a 'claim_transaction' migrated this way keeps
 * the title it was saved with (SPEC 60 stores the status LABEL inside
 * node.title), so it may still read «Duplicado» until it is saved again. Titles
 * are not rewritten here — the same reasoning as myapi_update_7020(), where
 * re-saving transactions in bulk would make each one re-sync its parent claim's
 * status.
 *
 * Re-running it is a no-op: no row matches 'duplicated' any more and
 * field_update_field() just writes the same four values again.
 *
 * @return string
 *   A summary line, shown by drush and by update.php.
 */
function myapi_update_7021() {
  $migrated = 0;

  foreach (array('field_data_field_status', 'field_revision_field_status') as $table) {
    if (!db_table_exists($table)) {
      continue;
    }
    $count = db_update($table)
      ->fields(array('field_status_value' => 'closed'))
      ->condition('field_status_value', 'duplicated')
      ->execute();

    if ($table === 'field_data_field_status') {
      $migrated = $count;
    }
  }

  if ($migrated) {
    watchdog(
      'myapi',
      'SPEC 62: @count nodos que estaban en estado «Duplicado» pasaron a «Cerrado» antes de quitar el valor del catálogo.',
      array('@count' => $migrated),
      WATCHDOG_NOTICE
    );
    // The rows were written behind Drupal's back.
    entity_get_controller('node')->resetCache();
  }

  $field = field_read_field('field_status');
  if ($field) {
    $field['settings']['allowed_values'] = array(
      'received'    => 'Recibido',
      'in_progress' => 'En proceso',
      'resolved'    => 'Resuelto',
      'closed'      => 'Cerrado',
    );
    field_update_field($field);
    field_info_cache_clear();
  }

  return $migrated
    ? t('Estado «Duplicado» retirado del catálogo; @count nodos que lo tenían pasaron a «Cerrado».', array('@count' => $migrated))
    : t('Estado «Duplicado» retirado del catálogo. Ningún nodo lo tenía.');
}

/**
 * SPEC 63: widens 'field_reception_date' from day-only to day + hour + minute.
 *
 * Same shape, same reasoning and same idempotency as myapi_update_7019(), which
 * did this to field_status_date (SPEC 58) — the Date module 'datetime' field
 * already stores a full DATETIME, so day-only was a configuration constraint on
 * the field settings and on the widget, never on the schema. Configuration
 * only: not one row of field_data_field_reception_date is touched, and claims
 * saved before this update keep their stored '00:00', which the listing now
 * shows as such.
 *
 * field_update_field() changes the field-wide 'granularity' (today only
 * 'reclamo' uses this field); field_update_instance() widens the native
 * 'date_select' widget of that instance, so node/add/reclamo and
 * node/%nid/edit offer hour and minute selectors and prefill them with the
 * current time.
 *
 * Re-running it just writes the same settings again.
 */
function myapi_update_7022() {
  $field = field_info_field('field_reception_date');
  if (!$field) {
    return;
  }
  $field['settings']['granularity'] = array(
    'year'   => 'year',
    'month'  => 'month',
    'day'    => 'day',
    'hour'   => 'hour',
    'minute' => 'minute',
    'second' => 0,
  );
  field_update_field($field);

  $instance = field_info_instance('node', 'field_reception_date', 'reclamo');
  if ($instance) {
    $instance['widget']['settings']['input_format'] = 'Y-m-d H:i';
    field_update_instance($instance);
  }
}

/**
 * SPEC 65: moves the claim images and attachments to private://.
 *
 * The irreversible step of SPEC 65, and the reason it is the LAST one of that
 * spec's plan: once this runs, the sites/default/files URLs of those files
 * stop working, so both ways of reading them — hook_file_download() for the
 * back office and GET /api/v1/claims/%/files/% for the app — have to be live
 * and verified before it is executed.
 *
 * Three things happen here, in this order:
 *
 *   (a) private:// is checked. This is the ONLY case that aborts: without a
 *       private directory there is no migration possible, and going on would
 *       declare the fields private while their files stayed public — the worst
 *       of the three states. The abort happens BEFORE any field is touched, so
 *       a site missing file_private_path ends the update exactly as it started.
 *   (b) The two fields get uri_scheme = 'private', which is what makes every
 *       FUTURE upload land in the private directory.
 *   (c) The files already uploaded are moved one by one.
 *
 * What is NOT touched, and why the migration is safe: field_data_field_images,
 * field_data_field_attachment and their field_revision_* tables store the fid
 * and never the URI, so not one of their rows is rewritten. The node↔file link
 * is the fid, and the fid does not change. file_move() rewrites
 * file_managed.uri and moves the bytes; that is the whole change.
 *
 * Scope: fids referenced from a node through one of the two fields, whose uri
 * still starts with public://. A file already in private:// is skipped in
 * silence, which is what makes this re-runnable — the state lives in
 * file_managed.uri, so a second pass finds nothing to move and needs no
 * control table. Files in public:// that NO field row references (an abandoned
 * upload, a deleted node) are deliberately left alone: moving files nothing
 * points at buys nothing and risks touching another module's.
 *
 * An individual failure — the file is not on disk, the destination is not
 * writable — is logged to watchdog with its fid and its uri, skipped, and does
 * NOT abort: one stray file must not block the other two hundred, and what is
 * left behind is recorded precisely enough to be repaired by hand.
 *
 * FILE_EXISTS_RENAME and not FILE_EXISTS_REPLACE: replacing could destroy a
 * private file that already carries that name — a payment receipt included, if
 * they ever share a directory. Renaming loses nothing; the fid stays the same
 * and file_move() updates the uri itself. The cosmetic cost is that a renamed
 * file ('informe.pdf' → 'informe_0.pdf') travels with the new name in the
 * 'filename' key.
 *
 * Destination is the root of private://, not a subdirectory: neither field
 * instance declares a file_directory, so NEW uploads land in the root. Moving
 * the old ones anywhere else would split the same field's files across two
 * places.
 */
function myapi_update_7023() {
  // (a) The one abort. 'private' is only a registered stream wrapper when
  // file_private_path is set, so the scheme check IS the configuration check;
  // file_prepare_directory() then makes sure the directory exists and is
  // writable.
  $directory = 'private://';
  if (!file_stream_wrapper_valid_scheme('private') || !file_prepare_directory($directory, FILE_CREATE_DIRECTORY)) {
    throw new DrupalUpdateException(
      'SPEC 65: no hay sistema de ficheros privado disponible. Configura file_private_path en settings.php '
      . '(o en admin/config/media/file-system), apuntando a un directorio escribible y FUERA del docroot, '
      . 'y vuelve a ejecutar la actualización. No se ha modificado ningún campo ni movido ningún fichero.'
    );
  }

  // (b) The fields. From here on every new upload is born private.
  foreach (array('field_images', 'field_attachment') as $field_name) {
    $field = field_info_field($field_name);
    if (!$field) {
      continue;
    }
    $field['settings']['uri_scheme'] = 'private';
    field_update_field($field);
  }
  field_info_cache_clear();

  // (c) The files already uploaded. One query per field table gathers the
  // referenced fids with their current uri; the partition into "to move",
  // "already private" and "broken" is done in PHP, so the three counters of
  // the summary come out of a single pass.
  $sources = array(
    'field_data_field_images'     => 'field_images_fid',
    'field_data_field_attachment' => 'field_attachment_fid',
  );

  $uris = array();
  foreach ($sources as $table => $column) {
    if (!db_table_exists($table)) {
      continue;
    }
    $query = db_select($table, 'f');
    $query->condition('f.entity_type', 'node');
    $query->condition('f.deleted', 0);
    $query->innerJoin('file_managed', 'fm', 'fm.fid = f.' . $column);
    $query->addField('fm', 'fid', 'fid');
    $query->addField('fm', 'uri', 'uri');
    $query->distinct();

    foreach ($query->execute() as $row) {
      // The same file referenced from both fields is collected once.
      $uris[(int) $row->fid] = $row->uri;
    }
  }

  $moved = 0;
  $failed = 0;
  $already = 0;

  foreach ($uris as $fid => $uri) {
    if (file_uri_scheme($uri) !== 'public') {
      $already++;
      continue;
    }

    $file = file_load($fid);

    if (!is_object($file) || !file_exists($file->uri)) {
      $failed++;
      watchdog(
        'myapi',
        'SPEC 65: el fichero @fid (@uri) no se pudo migrar a private:// porque no está en disco. Sigue declarado en file_managed y hay que repararlo a mano.',
        array('@fid' => $fid, '@uri' => $uri),
        WATCHDOG_WARNING
      );
      continue;
    }

    // file_move() returns FALSE on failure rather than throwing, but a stream
    // wrapper can raise; either way one bad file must not abort the rest.
    try {
      $result = file_move($file, 'private://' . $file->filename, FILE_EXISTS_RENAME);
    }
    catch (Exception $e) {
      $result = FALSE;
    }

    if ($result) {
      $moved++;
    }
    else {
      $failed++;
      watchdog(
        'myapi',
        'SPEC 65: falló el movimiento del fichero @fid (@uri) a private://. Se salta y el resto de la migración continúa.',
        array('@fid' => $fid, '@uri' => $uri),
        WATCHDOG_ERROR
      );
    }
  }

  return t('SPEC 65: @moved ficheros movidos a private://, @failed fallidos (registrados en el log), @already ya estaban en private://.', array(
    '@moved'   => $moved,
    '@failed'  => $failed,
    '@already' => $already,
  ));
}

/**
 * SPEC 68: maps the five claim mail keys to MyapiHtmlMailSystem.
 *
 * myapi_mail_system_register() runs on install, so a fresh site already gets
 * the mapping; this update applies it where the module is already installed.
 * Without it the five new keys would fall back to DefaultMailSystem and their
 * HTML body would arrive converted to plain text — the same reason SPEC 48
 * needed myapi_update_7010().
 *
 * It walks myapi_html_mail_keys(), so it re-registers the previous keys too.
 * That is a no-op: they already point at the same class.
 */
function myapi_update_7024() {
  myapi_mail_system_register();
}

/**
 * SPEC 77: creates the services marketplace content types and fields.
 *
 * myapi_install() runs _myapi_services_install() on a fresh site, so this is
 * the same call for a site where the module is already installed — the exact
 * pattern of myapi_update_7006() (reservations) and myapi_update_7017()
 * (claims).
 *
 * It is safe to re-run: every creation inside goes through the idempotent
 * _ensure_* helpers, so a second pass finds everything in place and writes
 * nothing.
 *
 * It creates STRUCTURE ONLY. No permission is granted, no role is touched, no
 * route is registered and no node is created, so running it changes nothing
 * that any user or the app can see until a later spec builds on it.
 */
function myapi_update_7025() {
  _myapi_services_install();

  return t('SPEC 77: creados el vocabulario @vocabulary y los tipos de contenido @types con sus campos.', [
    '@vocabulary' => MYAPI_SERVICES_CATEGORY_VOCABULARY,
    '@types'      => implode(', ', myapi_services_node_types()),
  ]);
}

/**
 * SPEC 78: creates the 'proveedor' role.
 *
 * myapi_install() runs _myapi_provider_role_install() on a fresh site, so
 * this is the same call for a site where the module is already installed —
 * the exact pattern of myapi_update_7012() (building-admin role).
 *
 * It is safe to re-run: user_role_load_by_name() makes the role creation
 * idempotent and user_role_grant_permissions() merges rather than duplicates.
 *
 * Nothing is assigned to anyone here: the role is created empty, with no
 * permission (myapi_provider_role_permissions() is empty by design), and
 * giving it to a person is a manual task at /user/N/edit, linking their
 * account to a 'provider' node via field_provider_users.
 */
function myapi_update_7026() {
  _myapi_provider_role_install();

  return t('SPEC 78: creado el rol @role.', ['@role' => MYAPI_PROVIDER_ROLE]);
}

/**
 * SPEC 80: maps the payment mail key to MyapiHtmlMailSystem.
 *
 * myapi_mail_system_register() runs on install, so a fresh site already gets
 * the mapping; this update applies it where the module is already installed.
 * Without it 'payment_created_admin' would fall back to DefaultMailSystem and
 * its HTML body would arrive converted to plain text — the same reason SPEC 48
 * needed myapi_update_7010() and SPEC 68 needed myapi_update_7024().
 *
 * It walks myapi_html_mail_keys(), so it re-registers the previous keys too.
 * That is a no-op for the ones already mapped, and it is what finally maps
 * 'myapi_claim_closed_admin', which SPEC 70 left out of that list.
 */
function myapi_update_7027() {
  myapi_mail_system_register();

  return t('SPEC 80: registradas las claves de correo HTML (@count en total).', [
    '@count' => count(myapi_html_mail_keys()),
  ]);
}

/**
 * SPEC 81: adds the hourly rate, the tags and the short description to
 * 'provider'.
 *
 * It re-runs the WHOLE services installer instead of just creating the three
 * new fields, exactly like myapi_update_7025(). That works because every
 * creation inside goes through the idempotent _ensure_* sub-helpers, which
 * return early when the thing is already there: the vocabulary, the five node
 * types and the twenty-nine fields of SPEC 77 are found in place and nothing is
 * written over them — a field adjusted by hand on the site survives this
 * update. The surgical alternative would restate the three field definitions in
 * a second place of this same file, with the certainty that one day they
 * diverge.
 *
 * Which also makes it safe to call twice.
 *
 * The three fields are OPTIONAL, so no provider already loaded on the site
 * becomes invalid, and nothing else changes: no permission, no route, no
 * response of any api/v1 endpoint.
 */
function myapi_update_7028() {
  _myapi_services_install();

  return t('SPEC 81: creado el vocabulario @vocabulary y añadidos a @type los campos field_hourly_rate, field_tags y field_short_description.', [
    '@vocabulary' => MYAPI_SERVICES_TAG_VOCABULARY,
    '@type'       => MYAPI_SERVICES_PROVIDER_TYPE,
  ]);
}

/**
 * SPEC 82: adds the private gallery to 'provider' and DELETES field_photo.
 *
 * THE DELETION IS UNCONDITIONAL AND IRREVERSIBLE, by express decision of the
 * user. It does NOT count the rows of field_data_field_photo and it does NOT
 * abort when it finds any: if some environment had photos loaded, they are lost
 * with this update, without warning and with no way back. The field_info_field()
 * guard below only avoids the error of deleting something that is not there — it
 * does not protect data. Confirm SELECT COUNT(*) FROM field_data_field_photo and
 * have a database and files backup BEFORE running drush updb.
 *
 * The creation half re-runs the WHOLE services installer instead of creating
 * field_gallery on its own, exactly like myapi_update_7028() and 7025: every
 * creation inside goes through the idempotent _ensure_* sub-helpers, so
 * everything already in place is found and left alone. Which also makes the
 * creation safe to call twice.
 *
 * Order matters: the installer runs FIRST, so the site never sits in a state
 * where the old field is already gone and the new one does not exist yet.
 *
 * field_delete_field() only marks the field and its instances as deleted;
 * field_purge_batch() is what actually drops field_data_field_photo and
 * field_revision_field_photo. 1000 is the same batch size Drupal's own field
 * uninstall uses, and it is enough because the field has no data worth paging
 * through.
 *
 * The gallery is born EMPTY and born PRIVATE, so there is no file_move() here:
 * nothing is migrated from field_photo, whose data is discarded, not moved.
 */
function myapi_update_7029() {
  _myapi_services_install();

  if (field_info_field('field_photo')) {
    field_delete_field('field_photo');
    field_purge_batch(1000);
  }

  return t('SPEC 82: creado field_gallery (privado, hasta 10 imágenes) en @type y eliminado field_photo con sus datos.', [
    '@type' => MYAPI_SERVICES_PROVIDER_TYPE,
  ]);
}

/**
 * SPEC 84: adds a field_unit instance to 'service_rating'.
 *
 * Re-runs the WHOLE services installer instead of creating the instance on
 * its own, exactly like myapi_update_7028()/7029(): every creation inside
 * goes through the idempotent _ensure_* sub-helpers, so everything already in
 * place is found and left alone, which also makes it safe to call twice.
 *
 * field_unit itself is NOT created here — it already exists, owned by
 * reservations (SPEC 32). Only a new, OPTIONAL instance is added on
 * 'service_rating', so no rating already loaded on the site becomes invalid.
 * Nothing writes it yet: the flow that fills it in when a rating is created
 * does not exist, same as field_rating_avg was born unwritten in SPEC 77.
 */
function myapi_update_7030() {
  _myapi_services_install();

  return t('SPEC 84: añadida a @type la instancia de field_unit (vivienda del residente que calificó).', [
    '@type' => MYAPI_SERVICES_RATING_TYPE,
  ]);
}

/**
 * SPEC 85: adds the public logo (field_logo) to 'provider'.
 *
 * Re-runs the WHOLE services installer instead of creating the field on its
 * own, exactly like myapi_update_7028(), 7029() and 7030(): every creation
 * inside goes through the idempotent _ensure_* sub-helpers, so everything
 * already in place is found and left alone, which also makes it safe to call
 * twice.
 *
 * The field is born EMPTY for every provider already on the site and there is
 * no backfill: nothing gains an image and no node is touched by this update,
 * the same way field_short_description was born empty in SPEC 81. The logo is
 * optional, so no provider already loaded becomes invalid.
 *
 * It is born PUBLIC, so there is no file_move() here either: nothing is
 * migrated from anywhere.
 */
function myapi_update_7031() {
  _myapi_services_install();

  return t('SPEC 85: creado field_logo (público, una imagen de hasta 2 MB) en @type. Nace vacío para todos los proveedores existentes.', [
    '@type' => MYAPI_SERVICES_PROVIDER_TYPE,
  ]);
}

/**
 * SPEC 86: adds a REQUIRED field_unit instance to 'service_request'.
 *
 * Re-runs the WHOLE services installer instead of creating the instance on its
 * own, exactly like myapi_update_7028() through 7031(): every creation inside
 * goes through the idempotent _ensure_* sub-helpers, so everything already in
 * place is found and left alone, which also makes it safe to call twice.
 *
 * field_unit itself is NOT created here — it already exists, owned by
 * reservations, and its 'reservation' and 'service_rating' instances are left
 * exactly as they are. Only a new instance is added on 'service_request'.
 *
 * Unlike every services update before it, this instance is REQUIRED. That is
 * safe here and only here: no flow creates a service request yet (SPEC 77 left
 * it out of scope) so the bundle has no stored node to invalidate. If a site
 * did have requests saved without a unit, they could not be saved again until
 * someone picked one — there is no backfill in this update, on purpose. Check
 * the count before running it.
 */
function myapi_update_7032() {
  _myapi_services_install();

  return t('SPEC 86: añadida a @type la instancia obligatoria de field_unit (vivienda a la que va dirigido el servicio). Sin backfill: no se toca ningún nodo.', [
    '@type' => MYAPI_SERVICES_REQUEST_TYPE,
  ]);
}

/**
 * SPEC 87: adds 'direct' to field_request_status and frees field_rating_offer.
 *
 * The first services update that cannot just re-run the installer. Two of the
 * idempotent _ensure_* helpers only CREATE — _myapi_reservations_ensure_field()
 * skips a field that already exists and _myapi_reservations_ensure_instance()
 * skips an existing instance — so on an installed site neither the wider
 * allowed_values nor the new 'required' flag would ever be applied. Both are
 * written here by hand, with the Field API functions that do modify:
 *
 * 1. field_update_field() on field_request_status, with the allowed_values read
 *    from myapi_services_request_statuses() — never a list retyped here, which
 *    is the rule ServicesInstallTest pins for the installer and holds just as
 *    much for an update. The field is SHARED by 'service_request' and
 *    'service_transaction' (SPEC 77), so one write gives the status to the
 *    request select and to the timeline select at once.
 * 2. field_update_instance() on field_rating_offer / 'service_rating', to
 *    required = 0. Closing a 'direct' request demands a rating
 *    (myapi_services_close_requires_rating()) and a direct job has no offer to
 *    point at, so a required offer would demand a rating that cannot be saved.
 *
 * No data migration, and none is needed: this ADDS an allowed value instead of
 * removing one, so core's hook_field_update_forbid() — the
 * FieldUpdateForbiddenException myapi_update_7021() had to work around when it
 * dropped 'duplicated' — has nothing to forbid. Relaxing 'required' cannot
 * invalidate a stored rating either: every row that satisfied the stricter rule
 * satisfies the looser one.
 *
 * _myapi_services_install() is still called first, so a site that somehow lacks
 * a bundle or an instance gets it, and re-running the whole update is a no-op:
 * the same six values are written again and the flag is set to the value it
 * already has.
 *
 * @return string
 *   A summary line, shown by drush and by update.php.
 */
function myapi_update_7033() {
  module_load_include('inc', 'myapi', 'includes/myapi.services_common');

  _myapi_services_install();

  $field = field_read_field('field_request_status');
  if ($field) {
    $field['settings']['allowed_values'] = myapi_services_request_statuses();
    field_update_field($field);
  }

  $instance = field_read_instance('node', 'field_rating_offer', MYAPI_SERVICES_RATING_TYPE);
  if ($instance) {
    $instance['required'] = 0;
    $instance['description'] = 'Oferta adjudicada que se califica. Se deja vacía cuando la solicitud fue de proveedor directo y no hubo ronda de ofertas; el proveedor calificado es siempre el del campo Proveedor.';
    field_update_instance($instance);
  }

  field_info_cache_clear();

  return t("SPEC 87: añadido el estado «Proveedor directo» (@key) al catálogo de field_request_status, en @request y en @transaction. La oferta de una calificación pasa a ser opcional: un directo se califica sin oferta. Ningún nodo se ha tocado.", [
    '@key'         => MYAPI_SERVICES_REQUEST_STATUS_DIRECT,
    '@request'     => MYAPI_SERVICES_REQUEST_TYPE,
    '@transaction' => MYAPI_SERVICES_TRANSACTION_TYPE,
  ]);
}
