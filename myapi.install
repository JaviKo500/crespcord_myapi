    'type'        => 'text',
    'cardinality' => 1,
    'settings'    => ['max_length' => 255],
  ]);

  // (c) Instances of the 'area' bundle.
  _myapi_reservations_ensure_instance('field_condominium', 'area', [
    'field_name'  => 'field_condominium',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Condominio',
    'required'    => 1,
    // No 'settings' here on purpose: the referenceable bundle is a field-level
    // setting and lives in _myapi_entityreference_field_settings().
    'widget'      => ['type' => 'entityreference_autocomplete'],
  ]);
  _myapi_reservations_ensure_instance('field_image', 'area', [
    'field_name'  => 'field_image',
    'entity_type' => 'node',
    'bundle'      => 'area',
    'label'       => 'Imagen',
    'required'    => 0,
    'settings'    => [
