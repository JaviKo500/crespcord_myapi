*.pem

# PHPUnit dependencies (tests/unit).
vendor/

# Real Postman environment and IMAP credentials (tests/e2e) -- only the
# .example.json placeholders are committed.
tests/e2e/*.postman_environment.json
tests/e2e/.env
tests/e2e/node_modules/

# Coverage report, regenerated by every run of the suite (SPEC 124).
coverage.xml

# User manual HTML, regenerated by scripts/build-manual.sh.
build/

# Local deploy targets (production host), see scripts/deploy-target.sh.
scripts/deploy.local.env
.DS_Store

# Local development environment (docs/desarrollo-local.md): docroot pulled from
# production, database dumps, generated settings.php, local credentials.
.local/
.env
*.sql
*.sql.gz
!schema.sql
!scripts/local/sanitize.sql
